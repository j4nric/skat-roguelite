// Kartenmodifikationen, Effekte v2 (DESIGN 7.2, entschieden vom Nutzer am
// 02.11.2026). Eine Modifikation je Karte, Spezialkarten (Untot,
// Wandelkarte) dürfen zusätzlich eine normale tragen. Dieselbe noch einmal
// steigert (Werte addieren, höchstens `max`), eine andere ersetzt, ein
// Fluch sperrt die Karte.
//
// kind: Edge (Rand, immer aktiv), Moment (Markierung oben rechts),
// Voucher (Gutschein, wenn gedrückt), Curse (Fluch), Special
// (Spezialkarte), SpecialCurse (Spezialkarte, die ein Fluch ist).
// values: angebotene Werte, der erste für Zufallsziehungen. Die Wirkungen
// stehen je Einheit da und werden mit dem Wert der Karte vervielfacht.
// Ohne values hat die Modifikation keinen Wert und lässt sich nicht
// steigern.
// text: {n} ist der Betrag, {+n} der Wert mit Vorzeichen.
// focus: für welche Spielart (All, Trump für Farbspiel und Grand, Null).
// Zufallsziehungen (Stempelkissen, Kartengeber) gewichten damit nach
// focus_weights (characters.ron); sie ziehen nie Flüche und nie
// Spezialkarten. Werte, Preise und Seltenheit sind Platzhalter für
// `balance`.
[
    // ---------------------------------------------------------------------
    // Rand: immer aktiv, die Zahl im Band unten.
    // ---------------------------------------------------------------------
    // Lever Augen.
    (
        id: "points",
        kind: Edge,
        focus: Trump,
        name: "Augen",
        text: "Diese Karte zählt {+n} Augen.",
        rarity: Common,
        price: 3,
        values: [4, 3, 5],
        passive: [AddCardPoints(1)],
    ),
    // Lever Stichgewinn. Winkel nach oben statt einer Zahl.
    (
        id: "rank",
        kind: Edge,
        focus: Trump,
        name: "Rang",
        text: "Diese Karte sticht {n} Stufen höher (höchstens 2).",
        rarity: Common,
        price: 3,
        values: [1],
        // Antwort im Cockpit (02.11.2026): höchstens 2 statt 3. Alte
        // Spielstände kappt der Kern beim Laden (deck::RANK_MAX).
        max: Some(2),
        passive: [RankBonus(1)],
    ),
    // Lever Grundwert. Streng nach ADR 0015: nur, wenn der Spieler die
    // Karte hält (ein Schalter im Kern, TRUMP_MODS_NEED_PLAYER).
    (
        id: "trump_bonus",
        kind: Edge,
        focus: Trump,
        name: "Trumpf",
        text: "Ist die Farbe dieser Karte Trumpf und hältst du sie, steigt der Grundwert um {n}.",
        rarity: Uncommon,
        price: 4,
        values: [3, 2, 4],
        hooks: [
            OnDeclare(when: ThisCardIsTrumpSuit, then: [AddBaseValue(1)]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Moment: Markierung oben rechts, Text unten Mitte.
    // ---------------------------------------------------------------------
    // Lever Gewinnstufen (bis Effekte v2 "Spitze").
    (
        id: "last_trick",
        kind: Moment,
        focus: Trump,
        name: "Letzter Stich",
        text: "Macht diese Karte den letzten Stich, gibt es eine Gewinnstufe mehr.",
        rarity: Uncommon,
        price: 4,
        values: [1],
        max: Some(1),
        hooks: [
            OnScore(when: ThisCardWinsLastTrick, then: [AddLevels(1)]),
        ],
    ),
    // Lever Augen. Der Wert ist der Faktor: 2 heißt doppelt. Moment-
    // Modifikationen lassen sich nicht steigern (max).
    (
        id: "first_trick",
        kind: Moment,
        focus: Trump,
        name: "Erster Stich",
        text: "Gewinnt diese Karte den ersten Stich, zählen seine Augen ×{n}.",
        rarity: Uncommon,
        price: 4,
        values: [2],
        max: Some(2),
        hooks: [
            OnTrickEnd(when: ThisCardWinsFirstTrick, then: [MultiplyTrickPoints(1)]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Gutschein: Zackenrand, keine Markierung. Wirkt beim Drücken, sofort,
    // egal wie das Spiel ausgeht, und fällt dann von der Karte.
    // ---------------------------------------------------------------------
    // Lever Groschen.
    (
        id: "voucher_coins",
        kind: Voucher,
        name: "Gutschein",
        text: "Wenn gedrückt: {n} Groschen. Danach ist der Gutschein weg.",
        rarity: Common,
        price: 2,
        values: [3],
        hooks: [
            OnDiscard(then: [GainCoins(1)]),
        ],
    ),
    (
        id: "voucher_undead",
        kind: Voucher,
        focus: Trump,
        name: "Gutschein Untot",
        text: "Wenn gedrückt: Die Karte wird Untot. Danach ist der Gutschein weg.",
        rarity: Rare,
        price: 5,
        hooks: [
            OnDiscard(then: [TurnInto("undead")]),
        ],
    ),
    (
        id: "voucher_wild",
        kind: Voucher,
        name: "Gutschein Wandelkarte",
        text: "Wenn gedrückt: Die Karte wird Wandelkarte. Danach ist der Gutschein weg.",
        rarity: Rare,
        price: 5,
        hooks: [
            OnDiscard(then: [TurnInto("wild_card")]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Flüche: Feld unten links. Nur über Ereignisse, die sie ankündigen;
    // sie zahlen beim Erhalt 3 Groschen (Platzhalter). Eine verfluchte
    // Karte nimmt keine andere Modifikation, nur Frisches Deck hilft.
    // ---------------------------------------------------------------------
    // Lever Zählen: das Wissen hängt an der Karte. Beim Spieler kennen die
    // KI-Gegner sie, beim Gegner sieht der Spieler, wer sie hat.
    (
        id: "transparent",
        kind: Curse,
        name: "Durchsichtig",
        text: "Fluch: Hältst du diese Karte, wissen die Gegner das. Hält sie ein Gegner, siehst du, wer. Beim Erhalt 3 Groschen.",
        rarity: Common,
        price: 1,
        passive: [RevealHolder],
        hooks: [
            OnAttach(then: [GainCoins(3)]),
        ],
    ),
    // Lever Augen, auch unter 0.
    (
        id: "battered",
        kind: Curse,
        name: "Ramponiert",
        text: "Fluch: Diese Karte zählt {n} Augen weniger, auch unter 0. Beim Erhalt 3 Groschen.",
        rarity: Common,
        price: 1,
        values: [5],
        passive: [AddCardPoints(-1)],
        hooks: [
            OnAttach(then: [GainCoins(3)]),
        ],
    ),
    // Lever Grundwert (bis Effekte v2 "Schwarze Katze"). Streng nach ADR
    // 0015 wie Trumpf.
    (
        id: "stained",
        kind: Curse,
        focus: Trump,
        name: "Fleckig",
        text: "Fluch: Ist die Farbe dieser Karte Trumpf und hältst du sie, sinkt der Grundwert um {n}. Beim Erhalt 3 Groschen.",
        rarity: Common,
        price: 1,
        values: [3],
        hooks: [
            OnDeclare(when: ThisCardIsTrumpSuit, then: [AddBaseValue(-1)]),
            OnAttach(then: [GainCoins(3)]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Spezialkarten: ändern das Grunddesign, dürfen zusätzlich eine normale
    // Modifikation tragen. Sie kommen über die Gutscheine.
    // ---------------------------------------------------------------------
    // Lever Stichgewinn and Bedienpflicht: in the player's hand it takes
    // the suit he holds most of (without Unter) when the game starts
    // (DESIGN 7.2, decided by the user on 03.11.2026).
    (
        id: "wild_card",
        kind: Special,
        name: "Wandelkarte",
        text: "Bei Spielbeginn nimmt sie die Farbe an, von der du die meisten Karten hältst (ohne Unter). Bei Gleichstand gilt Eichel, Grün, Rot, Schellen.",
        rarity: Rare,
        price: 5,
        passive: [Wild],
    ),
    // Lever Stichgewinn (ADR 0015, Nullspieler, 02.11.2026): eine
    // Spezialkarte, die ein Fluch ist, das Gegenstück zu Rang. Ein Unter
    // ist keine Unter mehr, sondern die niedrigste Karte seiner Farbe
    // (unter der Sieben, ohne Augen, keine Spitze), jede andere Karte
    // sticht eine Stufe tiefer. Darf eine normale Modifikation tragen,
    // keine andere Spezialkarte ersetzt sie, nur Frisches Deck nimmt sie
    // ab. Nur im Grunddeck des Nullspielers, nie zufällig.
    (
        id: "demoted",
        kind: SpecialCurse,
        name: "Abgestuft",
        text: "Fluch: Ein Unter ist keine Unter mehr, sondern die niedrigste Karte seiner Farbe, ohne Augen. Jede andere Karte sticht eine Stufe tiefer.",
        rarity: Common,
        price: 1,
        passive: [Demote],
    ),
    // Lever Stichgewinn and Augen (user idea, 02.11.2026): played by the
    // player in a suit game or Grand, the card comes back into his hand
    // once per game, a random other card of his hand takes its place.
    (
        id: "undead",
        kind: Special,
        focus: Trump,
        name: "Untot",
        text: "Karte wird gespielt, dann aber wieder auf die Hand genommen und eine zufällige Karte abgeworfen. Einmal pro Spiel, nur im Farbspiel und Grand.",
        rarity: Rare,
        price: 5,
        passive: [Undead],
    ),
]
