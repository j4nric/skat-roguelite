// Kartenmodifikationen, Effekte v2 (DESIGN 7.2, entschieden vom Nutzer am
// 02.11.2026). Eine Modifikation je Karte, Spezialkarten (Untot,
// Wandelkarte) dürfen zusätzlich eine normale tragen. Dieselbe noch einmal
// steigert (Werte addieren, höchstens `max`), eine andere ersetzt, ein
// Fluch sperrt die Karte.
//
// kind: Edge (Rand, immer aktiv), Moment (Markierung oben rechts),
// Voucher (Gutschein, wenn gedrückt), Curse (Fluch), Special
// (Spezialkarte), SpecialCurse (Spezialkarte, die ein Fluch ist).
// values: angebotene Werte, der erste für Zufallsziehungen. Die Wirkungen
// stehen je Einheit da und werden mit dem Wert der Karte vervielfacht.
// Ohne values hat die Modifikation keinen Wert und lässt sich nicht
// steigern.
// text: {n} ist der Betrag, {+n} der Wert mit Vorzeichen.
// focus: für welche Spielart (All, Trump für Farbspiel und Grand, Null).
// Zufallsziehungen (Auslage und Kartenmaler am Tresen, Kartengeber,
// Werkstatt) gewichten damit nach focus_weights (characters.ron); sie
// ziehen nie Flüche und nie Spezialkarten.
// Zinken am Tresen (Entscheidung des Nutzers, 02.11.2026, DESIGN 8.6):
// shop_value ist der Wert in der Auslage und beim Kartenmaler (ohne: der
// erste aus values), price der Preis in der Auslage vor dem Zuschlag für
// Unter und Daus (run.ron, zinken). Die Auslage zieht nach Seltenheit,
// Gutscheine seltener. Zinken v2 (03.11.2026): Blei, Goldkante,
// Fadenkreuz, Schneiderkreide neu, Winkel mit neuer Bedeutung, Untot
// umgebaut. Namen seit dem 02.11.2026: Aufdruck, Winkel,
// Siegel, Eselsohr, Kerbe, Pfandmarke, Totenmarke, Narrenmarke; der Text
// beginnt mit der Wirkung, damit Infokarten sie neben dem Namen zeigen.
// Werte, Preise und Seltenheit VORLÄUFIG, nach Augenmaß ohne Messung.
// tags: Bau-Richtungen (04.11.2026, Cockpit q26), wie in house_rules.ron.
[
    // ---------------------------------------------------------------------
    // Rand: immer aktiv, die Zahl im Band unten.
    // ---------------------------------------------------------------------
    // Lever Augen.
    (
        id: "points",
        tags: [Schneider],
        kind: Edge,
        focus: Trump,
        name: "Aufdruck",
        text: "Augen: Diese Karte zählt {+n} Augen.",
        rarity: Common,
        price: 2,
        shop_value: Some(3),
        values: [4, 3, 5],
        passive: [AddCardPoints(1)],
    ),
    // Lever Stichgewinn. Neue Bedeutung seit dem 03.11.2026 (Zinken v2):
    // die Karte WIRD die nächsthöhere Karte ihrer Farbe (7, 8, 9, Oberin,
    // König, 10, Daus), in jedem Spiel, und behält ihre eigenen Augen.
    // Unter steigen nie und werden nie erreicht, ein Daus kann nicht
    // steigen (der Kern bietet ihn dort nicht an). Bild (Winkel v2,
    // 04.11.2026): violetter Kopierstift malt über das gedruckte Bild und
    // kritzelt den Rang im Eckzeichen weg.
    (
        id: "rank",
        tags: [Tricks],
        kind: Edge,
        focus: Trump,
        name: "Winkel",
        text: "Rang {+n}: Diese Karte wird die nächsthöhere Karte ihrer Farbe (7, 8, 9, Oberin, König, 10, Daus), bei Rang +2 die übernächste. Ihre Augen bleiben. Nicht auf Unter und Daus.",
        rarity: Common,
        price: 3,
        values: [1],
        // Antwort im Cockpit (02.11.2026): höchstens 2 statt 3. Alte
        // Spielstände kappt der Kern beim Laden (deck::RANK_MAX).
        max: Some(2),
        passive: [Promote(1)],
    ),
    // Lever Stichgewinn im Null (Zinken v2, 03.11.2026): die Karte ist im
    // Null die niedrigste ihrer Farbe, unter der Sieben.
    (
        id: "lead",
        tags: [Null],
        kind: Edge,
        focus: Null,
        name: "Blei",
        text: "Null: Im Nullspiel ist diese Karte die niedrigste ihrer Farbe, noch unter der Sieben.",
        rarity: Uncommon,
        price: 3,
        passive: [NullLowest],
    ),
    // Lever Groschen (Zinken v2, 03.11.2026): je Stich, den der Spieler
    // mit dieser Karte macht. Eine Untote kann zweimal stechen.
    (
        id: "gilt_edge",
        tags: [Tricks],
        kind: Edge,
        name: "Goldkante",
        text: "Stich: Machst du mit dieser Karte einen Stich, {n} Groschen.",
        rarity: Common,
        price: 3,
        values: [1],
        hooks: [
            OnTrickEnd(when: ThisCardWinsTrick, then: [GainCoins(1)]),
        ],
    ),
    // Lever Grundwert. Streng nach ADR 0015: nur, wenn der Spieler die
    // Karte hält (ein Schalter im Kern, TRUMP_MODS_NEED_PLAYER).
    (
        id: "trump_bonus",
        tags: [OneSuit],
        kind: Edge,
        focus: Trump,
        name: "Siegel",
        text: "Trumpf: Ist die Farbe dieser Karte Trumpf und hältst du sie, steigt der Grundwert um {n}.",
        rarity: Uncommon,
        price: 3,
        shop_value: Some(2),
        values: [3, 2, 4],
        hooks: [
            OnDeclare(when: ThisCardIsTrumpSuit, then: [AddBaseValue(1)]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Moment: Markierung oben rechts, Text unten Mitte.
    // ---------------------------------------------------------------------
    // Lever Gewinnstufen (bis Effekte v2 "Spitze").
    (
        id: "last_trick",
        tags: [Tricks],
        kind: Moment,
        focus: Trump,
        name: "Kerbe",
        text: "Letzter Stich: Macht diese Karte den letzten Stich, +1 Stufe.",
        rarity: Uncommon,
        price: 3,
        values: [1],
        max: Some(1),
        hooks: [
            OnScore(when: ThisCardWinsLastTrick, then: [AddLevels(1)]),
        ],
    ),
    // Lever Augen. Der Wert ist der Faktor: 2 heißt doppelt. Moment-
    // Modifikationen lassen sich nicht steigern (max).
    (
        id: "first_trick",
        tags: [Tricks],
        kind: Moment,
        focus: Trump,
        name: "Eselsohr",
        text: "Erster Stich: Gewinnt diese Karte den ersten Stich, zählen seine Augen ×{n}.",
        rarity: Uncommon,
        price: 3,
        values: [2],
        max: Some(2),
        hooks: [
            OnTrickEnd(when: ThisCardWinsFirstTrick, then: [MultiplyTrickPoints(1)]),
        ],
    ),
    // Lever Gewinnstufen (Zinken v2, 03.11.2026): sticht diese Karte einen
    // Daus eines Gegners (gespielt von einem Gegner, egal aus welcher
    // Ausgabe), +1 Stufe für dieses Spiel, je solchem Stich.
    // Vorerst aus dem Angebot genommen (Playtest 12.11.2026): retired,
    // Karten in alten Spielständen behalten sie samt Wirkung.
    (
        id: "crosshair",
        retired: true,
        tags: [Tricks],
        kind: Moment,
        focus: Trump,
        name: "Fadenkreuz",
        text: "Daus: Sticht diese Karte einen Daus eines Gegners, +{n} Stufe.",
        rarity: Uncommon,
        price: 4,
        values: [1],
        max: Some(1),
        hooks: [
            OnTrickEnd(when: ThisCardBeatsDefenderCard((rank: Some(Ace))), then: [AddLevels(1)]),
        ],
    ),
    // Lever Gewinnstufen (Zinken v2, 03.11.2026): gewinnt der Spieler mit
    // Schneider und hat diese Karte in einen Stich gespielt.
    (
        id: "tailors_chalk",
        tags: [Schneider],
        kind: Moment,
        focus: Trump,
        name: "Schneiderkreide",
        text: "Schneider: Gewinnst du mit Schneider und hast diese Karte gespielt, +{n} Stufe.",
        rarity: Uncommon,
        price: 3,
        values: [1],
        max: Some(1),
        hooks: [
            OnScore(when: All([WonSchneider, ThisCardPlayed]), then: [AddLevels(1)]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Gutschein: Zackenrand, keine Markierung. Wirkt beim Drücken, sofort,
    // egal wie das Spiel ausgeht, und fällt dann von der Karte. Seit dem
    // 04.11.2026 löst ein Handspiel eine zufällige Marke der Hand ebenso ein.
    // ---------------------------------------------------------------------
    // Lever Groschen.
    (
        id: "voucher_coins",
        tags: [Vouchers],
        kind: Voucher,
        name: "Pfandmarke",
        text: "Gutschein: Gedrückt oder beim Handspiel: {n} Groschen. Danach ist die Marke weg.",
        rarity: Common,
        price: 2,
        values: [3],
        hooks: [
            OnDiscard(then: [GainCoins(1)]),
        ],
    ),
    (
        id: "voucher_undead",
        tags: [Vouchers],
        kind: Voucher,
        focus: Trump,
        name: "Totenmarke",
        text: "Gutschein: Gedrückt oder beim Handspiel: Die Karte wird Untot. Danach ist die Marke weg.",
        rarity: Rare,
        price: 4,
        hooks: [
            OnDiscard(then: [TurnInto("undead")]),
        ],
    ),
    (
        id: "voucher_wild",
        tags: [Vouchers],
        kind: Voucher,
        name: "Narrenmarke",
        text: "Gutschein: Gedrückt oder beim Handspiel: Die Karte wird Wandelkarte. Danach ist die Marke weg.",
        rarity: Rare,
        price: 4,
        hooks: [
            OnDiscard(then: [TurnInto("wild_card")]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Flüche: Feld unten links. Nur über Ereignisse, die sie ankündigen;
    // sie zahlen beim Erhalt 3 Groschen (Platzhalter), nicht als Preis eines
    // Handels (Schnäppchen, Hehlerware, Fusel; Entscheidung 03.11.2026). Eine verfluchte
    // Karte nimmt keine andere Modifikation, nur Karte reinigen hilft.
    // ---------------------------------------------------------------------
    // Lever Zählen: das Wissen hängt an der Karte. Beim Spieler kennen die
    // KI-Gegner sie, beim Gegner sieht der Spieler, wer sie hat.
    (
        id: "transparent",
        kind: Curse,
        name: "Durchsichtig",
        text: "Fluch: Hältst du diese Karte, wissen die Gegner das. Trägt die Karte eines Gegners den Fluch, siehst du, wer sie hat. Beim Erhalt 3 Groschen (nicht bei einem Handel).",
        rarity: Common,
        price: 1,
        passive: [RevealHolder],
        hooks: [
            OnAttach(then: [GainCoins(3)]),
        ],
    ),
    // Lever Augen, auch unter 0.
    (
        id: "battered",
        kind: Curse,
        name: "Ramponiert",
        text: "Fluch: Diese Karte zählt {n} Augen weniger, auch unter 0. Beim Erhalt 3 Groschen (nicht bei einem Handel).",
        rarity: Common,
        price: 1,
        values: [5],
        passive: [AddCardPoints(-1)],
        hooks: [
            OnAttach(then: [GainCoins(3)]),
        ],
    ),
    // Lever Grundwert (bis Effekte v2 "Schwarze Katze"). Streng nach ADR
    // 0015 wie Trumpf.
    (
        id: "stained",
        kind: Curse,
        focus: Trump,
        name: "Fleckig",
        text: "Fluch: Ist die Farbe dieser Karte Trumpf und hältst du sie, sinkt der Grundwert um {n}. Beim Erhalt 3 Groschen (nicht bei einem Handel).",
        rarity: Common,
        price: 1,
        values: [3],
        hooks: [
            OnDeclare(when: ThisCardIsTrumpSuit, then: [AddBaseValue(-1)]),
            OnAttach(then: [GainCoins(3)]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Spezialkarten: ändern das Grunddesign, dürfen zusätzlich eine normale
    // Modifikation tragen. Sie kommen über die Gutscheine.
    // ---------------------------------------------------------------------
    // Lever Stichgewinn and Bedienpflicht: in the player's hand it takes
    // the suit he holds most of (without Unter) when the game starts
    // (DESIGN 7.2, decided by the user on 03.11.2026).
    (
        id: "wild_card",
        kind: Special,
        name: "Wandelkarte",
        text: "Bei Spielbeginn nimmt sie die Farbe an, von der du die meisten Karten hältst (ohne Unter). Bei Gleichstand gilt Eichel, Grün, Rot, Schellen.",
        rarity: Rare,
        price: 5,
        passive: [Wild],
    ),
    // Lever Stichgewinn (ADR 0015, Nullspieler, 02.11.2026): eine
    // Spezialkarte, die ein Fluch ist, das Gegenstück zu Rang. Ein Unter
    // ist keine Unter mehr, sondern die niedrigste Karte seiner Farbe
    // (unter der Sieben, ohne Augen, keine Spitze), jede andere Karte
    // sticht einen Rang tiefer. Darf eine normale Modifikation tragen,
    // keine andere Spezialkarte ersetzt sie, nur Karte reinigen nimmt
    // sie ab. Nur im Grunddeck des Nullspielers, nie zufällig.
    (
        id: "demoted",
        kind: SpecialCurse,
        name: "Abgestuft",
        text: "Fluch: Ein Unter ist keine Unter mehr, sondern die niedrigste Karte seiner Farbe, ohne Augen. Jede andere Karte sticht einen Rang tiefer.",
        rarity: Common,
        price: 1,
        passive: [Demote],
    ),
    // Lever Stichgewinn (Zinken v2, user decision 03.11.2026, Cockpit
    // q17; reworked as "Spiegelbild" by the user on 07.11.2026, Cockpit
    // q37): played as the last card of a trick (a legal play as printed),
    // it becomes a copy of the highest card in the trick and wins it; the
    // copy counts that card's Augen. Once per game. Otherwise, and in Null
    // and Ramsch, it plays as itself.
    (
        id: "doppelganger",
        kind: Special,
        name: "Doppelgänger",
        text: "Spiegelbild: Spielst du sie als letzte Karte eines Stichs, wird sie zur Kopie der höchsten Karte darin und gewinnt den Stich, mit deren Augen. Einmal je Spiel, nicht im Null und Ramsch. Sonst zählt sie als sie selbst.",
        rarity: Rare,
        price: 5,
        passive: [Doppelganger],
    ),
    // Lever Stichgewinn and Augen (user idea, 02.11.2026; reworked by the
    // user on 03.11.2026): played by the player in a suit game or Grand,
    // the card comes back into his hand once per game as the card that won
    // the trick; he picks three cards of his hand, one of them is drawn
    // and takes its place in the trick.
    (
        id: "undead",
        kind: Special,
        focus: Trump,
        name: "Untot",
        text: "Nach dem Stich kehrt sie als die Karte auf die Hand zurück, die den Stich gemacht hat. Du wählst 3 Karten, eine davon geht für sie in den Stich. Einmal pro Spiel, nur im Farbspiel und Grand.",
        rarity: Rare,
        price: 5,
        passive: [Undead],
    ),
]
