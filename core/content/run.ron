// Run-Struktur als Daten. Zielwerte (DESIGN 5.2), Spiellimit, Pässe und
// Wirtschaft (DESIGN 12) kalibriert für v1 (M5) mit dem Simulator gegen den
// PIMC-Spieler (`--bot pimc:12:3`), siehe docs/balance/2026-11-01-m5-v1.md.
// Die Zielwerte sind Reizwerte.
(
    // (Serie 1, Serie 2, Boss-Serie) je Abschnitt. Ab Abschnitt 2 spielen
    // die Gegner PIMC (opponents unten), deshalb steigt die Kurve danach nur
    // flach.
    targets: [
        (36, 44, 54),
        (44, 48, 54),
        (48, 54, 60),
        (54, 60, 66),
        (60, 66, 72),
    ],
    // M5: 8 Spiele, davon bis zu 6 Pässe. Mit 5 und 3 gewinnt der
    // PIMC-Spieler gegen PIMC-Gegner auch bei Zielwert 1 nur rund 75 % einer
    // Serie; der Run hängt dann am Pech mit verlorenen Spielen (doppelt) und
    // die Kurve wirkt kaum. Mit 8 und 6 liegt diese Decke bei 85 %, die
    // Zielwerte beißen, und Abschnitt 1 braucht etwa zwei gewonnene Spiele.
    game_limit: 8,
    passes: 6,
    relic_slots: 5,
    consumable_slots: 2,
    economy: (
        series_reward: 3,
        per_game_left: 1,
        interest_step: 5,
        interest_max: 5,
        reroll_cost: 2,
        starting_coins: 4,
    ),
    shop: (
        relic_offers: 3,
        consumable_offers: 2,
        rarity_weights: (common: 6, uncommon: 3, rare: 1),
    ),
    bosses: [
        "the_pusher",
        "kontra_hans",
        "grandma",
        "twins",
        "ramscher",
        "revolutionary",
        "black_peter",
        "kibitz_killer",
    ],
    // Endboss der Boss-Serie im letzten Abschnitt (DESIGN 11).
    final_boss: Some("the_old_man"),
    // Wahrscheinlichkeit, dass zwischen zwei Serien statt des Tresens ein
    // Ereignis kommt (DESIGN 13). Platzhalter für `balance`.
    encounter_chance: 0.2,
    // Kartenspiel der Gegenspieler je Abschnitt (DESIGN 10.3): Abschnitt 1
    // Heuristik, danach PIMC mit steigender Zahl an Stichproben. `depth`:
    // exakt durchsuchte Stiche je Stichprobe, dahinter eine schnelle
    // Ausspiel-Schätzung (0 = bis zum Ende). Messung und Laufzeit:
    // docs/balance/2026-11-01-m5-pimc.md. Spätere Abschnitte nehmen den
    // letzten Eintrag.
    opponents: [
        Heuristic,
        Pimc(samples: 6, depth: 2),
        Pimc(samples: 8, depth: 3),
        Pimc(samples: 12, depth: 3),
        Pimc(samples: 16, depth: 3),
    ],
)
