// Run-Struktur als Daten. Zielwerte (DESIGN 5.2), Spiellimit, Einmischen und
// Wirtschaft (DESIGN 12). Wirtschaft kalibriert für v1 (M5) gegen den
// PIMC-Spieler (`--bot pimc:12:3`), siehe docs/balance/2026-11-01-m5-v1.md.
// Die Zielwerte sind seit den Serien mit 3 Spielen (01.11.2026) eine
// vorläufige Kurve aus einer kurzen Messung (DESIGN 5.2); die volle
// Kalibrierung folgt.
(
    // (Serie 1, Serie 2, Boss-Serie) je Abschnitt, vorläufig. Gemessen
    // (2 × 500 Runs, Seeds 42 und 43): normale Serien 76 bis 81 % in
    // Abschnitt 1 bis 3, Boss-Serien 61 bis 75 %. M5-Kurve für 8 Spiele war
    // 36/44/54 bis 60/66/72.
    targets: [
        (24, 30, 36),
        (30, 36, 42),
        (36, 42, 48),
        (42, 48, 54),
        (48, 54, 60),
    ],
    // Seit 01.11.2026 (Spieltest, Entscheidung des Nutzers): 3 Spiele je
    // Serie, und jedes Spiel darf bis zu zweimal eingemischt (neu gegeben)
    // werden, ohne ein Spiel zu kosten; danach wird gespielt. Vorher 8
    // Spiele und 6 Pässe je Serie (M5), davor 5 und 3 (M2).
    game_limit: 3,
    redeals: 2,
    relic_slots: 5,
    consumable_slots: 2,
    economy: (
        series_reward: 3,
        per_game_left: 1,
        interest_step: 5,
        interest_max: 5,
        reroll_cost: 2,
        starting_coins: 4,
    ),
    shop: (
        relic_offers: 3,
        consumable_offers: 2,
        rarity_weights: (common: 6, uncommon: 3, rare: 1),
    ),
    bosses: [
        "the_pusher",
        "kontra_hans",
        "grandma",
        "twins",
        "ramscher",
        "revolutionary",
        "black_peter",
        "kibitz_killer",
    ],
    // Endboss der Boss-Serie im letzten Abschnitt (DESIGN 11).
    final_boss: Some("the_old_man"),
    // Wahrscheinlichkeit, dass zwischen zwei Serien statt des Tresens ein
    // Ereignis kommt (DESIGN 13). Platzhalter für `balance`.
    encounter_chance: 0.2,
    // Kartenspiel der Gegenspieler je Abschnitt (DESIGN 10.3): Abschnitt 1
    // Heuristik, danach PIMC mit steigender Zahl an Stichproben. `depth`:
    // exakt durchsuchte Stiche je Stichprobe, dahinter eine schnelle
    // Ausspiel-Schätzung (0 = bis zum Ende). Messung und Laufzeit:
    // docs/balance/2026-11-01-m5-pimc.md. Spätere Abschnitte nehmen den
    // letzten Eintrag.
    opponents: [
        Heuristic,
        Pimc(samples: 6, depth: 2),
        Pimc(samples: 8, depth: 3),
        Pimc(samples: 12, depth: 3),
        Pimc(samples: 16, depth: 3),
    ],
    // Kurzer Abend (DESIGN 5.3): die Zeilen von targets und opponents, die
    // ein kurzer Run spielt, ab 0 gezählt. Der letzte endet mit dem
    // Endboss.
    short_sections: [0, 1, 2],
)
