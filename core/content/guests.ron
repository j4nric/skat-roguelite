// Stammgäste (DESIGN 10, entschieden am 01.11.2026): die normalen Gegner.
// Wechselnde Gäste mit Namen und Pixelgesicht, ohne eigene Regeln; Regeln
// bleiben den Bossen. Zu Beginn jeder Serie setzen sich zwei an den Tisch
// (eigener Zufallsstrom aus dem Seed des Runs, siehe core/src/run/guests.rs).
// In der Boss-Kneipe sitzen seit ADR 0017 die beiden Figuren des Bosses
// (ihre Sprüche stehen in bosses.ron).
//
// look: Id des Gesichts in web/src/ui/people.ts (GUEST_LOOKS).
// back: Kartenrückseite (ADR 0015, web/src/ui/backs.ts): alle Stammgäste
// teilen die Rückseite „regulars“ (Petrol-Raute mit Bierkrug).
// quips: Sprüche für die Sprechblase (DESIGN 10.4), je Anlass zwei bis
// vier Varianten, die Oberfläche wählt eine (Dekoration, kein Spielzufall):
//   greet      erstes Spiel der Serie (steht auch auf dem Filz)
//   win        der Gast holt einen Stich mit 10 Augen oder mehr
//   lose       du holst einen Stich mit 10 Augen oder mehr
//   smear      er schmiert: Daus oder Zehn in den Stich seines Partners
//   grand      du sagst Grand an
//   null       du sagst Null an
//   bold       du sagst Hand, Schneider, Schwarz oder Ouvert an
//   ramsch     ein Ramsch beginnt
//   won        die Gäste gewinnen das Spiel (du verlierst)
//   lost       du gewinnst das Spiel
//   schneider  du gewinnst mit Schneider oder Schwarz
// Englisch nach Id in web/src/i18n/en-content.ts (gleich viele Varianten).
// Kurz halten (höchstens 40 Zeichen, die Blase ist klein), freundlich,
// kein Spott über Personen. Ein einzelner Spruch darf ohne Klammern stehen.
[
    (
        id: "kalle",
        name: "Kalle",
        look: "kalle",
        back: "regulars",
        quips: (
            greet: ["Na, dann misch mal ordentlich.", "Kalle ist da. Jetzt wird's ernst.", "Erst ein Pils, dann wird gekloppt."],
            win: ["Der gehört Kalle!", "Ab in die Tasche.", "Wie bestellt."],
            lose: ["Ach, lass stecken.", "Den gönn ich dir.", "Na gut, einer für dich."],
            smear: ["Da, ein fetter Happen!", "Schmieren, bis es glänzt!"],
            grand: ["Grand? Na, du traust dich was.", "Oha, die Unter liegen bei dir."],
            null: ["Null? Ich halt die Luft an.", "Null! Na, dann zeig mal."],
            bold: ["Hand? Mutig, mutig.", "Große Töne. Mal sehen."],
            ramsch: ["Ramsch! Jeder für sich.", "Bloß keine Augen fressen."],
            won: ["Das Spiel gehört uns!", "Gut gekämpft. Knapp daneben."],
            lost: ["Glückwunsch, verdient.", "Schreib's auf. Das nächste holen wir."],
            schneider: ["Schneider! Mir ist kalt.", "Ausgezogen bis aufs Hemd."],
        ),
    ),
