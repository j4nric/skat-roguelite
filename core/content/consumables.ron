// Verbrauchsgegenstände: einmal nutzbar, höchstens drei auf der Hand
// (`consumable_slots` in run.ron, seit 03.11.2026; vorher zwei).
// `target`: worauf die Oberfläche den Schnaps gießt (Skat, Table, Card,
// Self, Map; ohne Angabe Self), nur Darstellung (DESIGN 8.9).
// Preise sind Platzhalter (DESIGN 12: 2 bis 4). `category: Schnapps` fasst
// die Schnäpse zusammen (DESIGN 8.3); Preise und Seltenheit auch dort
// Platzhalter für `balance`. Entfernt am 02.11.2026 (Gegenstands-Review des
// Nutzers): Ein Bier, Neues Blatt, Magenbitter, Reue, Augen +5, Trumpf +4;
// alte Spielstände verlieren sie beim Laden. Entfernt am 02.11.2026 mit den
// Zinken am Tresen (Entscheidung des Nutzers, DESIGN 8.6): Frisches Deck
// (jetzt der Tresen-Dienst „Karte reinigen“), Stempelkissen, Augen +3,
// Trumpf +2, Rang +1 (jetzt Auslage und Kartenmaler).
[
    (
        id: "shot",
        name: "Kurzer",
        text: "Vor der Wahl zwischen Skat und Hand: Schau dir die beiden Skatkarten an. Die Wahl bleibt offen.",
        rarity: Common,
        price: 2,
        action: PeekSkat,
        category: Schnapps,
        target: Skat,
    ),
    // Item review of 02.11.2026 (user): drinking it deals again at once
    // (free, no Einmischen used), so it cannot be saved for a known hand;
    // the new game counts double, further Einmischen keep the effect until
    // a game is declared.
    (
        id: "double_grain",
        name: "Doppelkorn",
        text: "Vor der Wahl zwischen Skat und Hand: Es wird sofort neu gegeben, ohne ein Einmischen zu kosten, und das nächste angesagte Spiel zählt doppelt, gewonnen wie verloren.",
        rarity: Uncommon,
        price: 3,
        action: RedealNextGame(Multiply(2)),
        category: Schnapps,
        target: Table,
    ),
    // Item review of 02.11.2026: what "Neues Blatt" did (now removed).
    // Price provisional (3, before 2).
    (
        id: "herbal",
        name: "Kräuter",
        text: "Vor der Wahl zwischen Skat und Hand: Sofort neu mischen und geben, ohne dass es ein Einmischen kostet.",
        rarity: Common,
        price: 3,
        action: Redeal,
        category: Schnapps,
        target: Table,
    ),
    // Bis 02.11.2026 "Kreide" (id chalk); alte Spielstände lesen die alte Id
    // (`Run::drop_unknown_content`).
    (
        id: "blue_curacao",
        name: "Blue Curaçao",
        text: "Vor der Ansage: Färbe eine Karte deiner Hand bis zum Spielende in eine andere Farbe um. Unter nicht.",
        rarity: Uncommon,
        price: 3,
        action: ChalkCard,
        category: Schnapps,
        target: Card,
    ),
    // Gegenstands-Review vom 02.11.2026 (Nutzer): neue Schnäpse. Preise und
    // Seltenheit VORLÄUFIG, nach Augenmaß ohne Messung (DESIGN 8.3, 12).
    (
        id: "counter_beer",
        name: "Konterbier",
        text: "Außerhalb eines Spiels: Du bekommst ein Leben zurück, höchstens 4.",
        rarity: Uncommon,
        price: 4,
        action: GainLives(1),
        category: Schnapps,
        target: Self,
    ),
    (
        id: "snifter",
        name: "Schwenker",
        text: "Bei der Wahl des Weges: Die Stationen aller drei Wege werden neu ausgelost.",
        rarity: Common,
        price: 2,
        action: RerollRoutes,
        category: Schnapps,
        target: Map,
    ),
    (
        id: "road_beer",
        name: "Wegbier",
        text: "Auf dem Weg zur nächsten Kneipe: Dort darfst du einmal mehr einmischen, und ihr Zielwert sinkt um 3.",
        rarity: Common,
        price: 3,
        action: NextPub(redeals: 1, target: -3),
        category: Schnapps,
        target: Self,
    ),
    // Rettungs-Schnäpse (Entscheidung des Nutzers vom 03.11.2026 über das
    // Cockpit): für Kneipen, deren Konto nach zwei verlorenen Spielen tief
    // im Minus steht. Preise und Seltenheit VORLÄUFIG nach Augenmaß, ohne
    // Messung (DESIGN 8.3, 12).
    (
        id: "clear_spirit",
        name: "Klarer",
        text: "Zwischen zwei Spielen einer Kneipe: Steht dein Konto unter 0, steht es wieder auf 0.",
        rarity: Common,
        price: 3,
        action: ClearAccount,
        category: Schnapps,
        target: Self,
    ),
    (
        id: "nightcap",
        name: "Absacker",
        text: "Zwischen zwei Spielen einer Kneipe: Ein Spiel mehr in dieser Kneipe. Nicht in der Boss-Kneipe.",
        rarity: Uncommon,
        price: 4,
        action: ExtraGames(1),
        category: Schnapps,
        target: Self,
    ),
    (
        id: "eggnog",
        name: "Eierlikör",
        text: "Vor der Wahl zwischen Skat und Hand, wenn dein Konto unter der Hälfte des Zielwerts steht: Gewinnst du das nächste angesagte Spiel, zählt es doppelt.",
        rarity: Common,
        price: 3,
        action: NextGameIfBehind(MultiplyWin(2)),
        category: Schnapps,
        target: Self,
    ),
    // Flüche als Handel (Entscheidung des Nutzers, 03.11.2026): billig und
    // auf eine bekannte Hand zu trinken, anders als der Doppelkorn, dafür
    // ein dauerhafter Fluch auf einer zufälligen Karte ohne Fluch. Preis und
    // Seltenheit VORLÄUFIG nach Augenmaß (DESIGN 8.3, 12).
    (
        id: "rotgut",
        name: "Fusel",
        text: "Vor der Wahl zwischen Skat und Hand: Das nächste angesagte Spiel zählt doppelt, gewonnen wie verloren. Dafür bekommt eine zufällige Karte deiner Ausgabe ohne Fluch einen Fluch, für immer und ohne Groschen.",
        rarity: Common,
        price: 2,
        action: NextGameCursed(Multiply(2)),
        category: Schnapps,
        target: Table,
    ),
]
