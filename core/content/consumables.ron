// Verbrauchsgegenstände: einmal nutzbar, höchstens zwei auf der Hand.
// Preise sind Platzhalter (DESIGN 12: 2 bis 4). `category: Schnapps` fasst
// die Schnäpse zusammen (DESIGN 8.3); Preise und Seltenheit auch dort
// Platzhalter für `balance`. Entfernt am 02.11.2026 (Gegenstands-Review des
// Nutzers): Ein Bier, Neues Blatt, Magenbitter, Reue, Augen +5, Trumpf +4;
// alte Spielstände verlieren sie beim Laden.
[
    (
        id: "fresh_deck",
        name: "Frisches Deck",
        text: "Reinigt eine Karte deiner Ausgabe: Alle Effekte fallen ab, auch Flüche.",
        rarity: Common,
        price: 3,
        action: CleanseCard,
    ),
    (
        id: "ink_pad",
        name: "Stempelkissen",
        text: "Verpasse einer Karte eine zufällige Modifikation, nie einen Fluch. Dieselbe steigt, eine andere ersetzt die alte.",
        rarity: Common,
        price: 3,
        action: AddCardMod(None),
    ),
    (
        id: "shot",
        name: "Kurzer",
        text: "Vor der Wahl zwischen Skat und Hand: Schau dir die beiden Skatkarten an. Die Wahl bleibt offen.",
        rarity: Common,
        price: 2,
        action: PeekSkat,
        category: Schnapps,
    ),
    // Item review of 02.11.2026 (user): drinking it deals again at once
    // (free, no Einmischen used), so it cannot be saved for a known hand;
    // the new game counts double, further Einmischen keep the effect until
    // a game is declared.
    (
        id: "double_grain",
        name: "Doppelkorn",
        text: "Vor der Wahl zwischen Skat und Hand: Es wird sofort neu gegeben, ohne ein Einmischen zu kosten, und das nächste angesagte Spiel zählt doppelt, gewonnen wie verloren.",
        rarity: Uncommon,
        price: 3,
        action: RedealNextGame(Multiply(2)),
        category: Schnapps,
    ),
    // Item review of 02.11.2026: what "Neues Blatt" did (now removed).
    // Price provisional (3, before 2).
    (
        id: "herbal",
        name: "Kräuter",
        text: "Vor der Wahl zwischen Skat und Hand: Sofort neu mischen und geben, ohne dass es ein Einmischen kostet.",
        rarity: Common,
        price: 3,
        action: Redeal,
        category: Schnapps,
    ),
    (
        id: "chalk",
        name: "Kreide",
        text: "Vor der Ansage: Male eine Karte deiner Hand bis zum Spielende in eine andere Farbe um. Buben nicht.",
        rarity: Uncommon,
        price: 3,
        action: ChalkCard,
        category: Schnapps,
    ),
    // Gegenstands-Review vom 02.11.2026 (Nutzer): neue Schnäpse. Preise und
    // Seltenheit VORLÄUFIG, nach Augenmaß ohne Messung (DESIGN 8.3, 12).
    (
        id: "hangover_breakfast",
        name: "Katerfrühstück",
        text: "Außerhalb eines Spiels: Du bekommst ein Leben zurück, höchstens bis zum Maximum.",
        rarity: Uncommon,
        price: 4,
        action: GainLives(1),
        category: Schnapps,
    ),
    (
        id: "taxi",
        name: "Taxi",
        text: "Bei der Wahl des Weges: Die Stationen aller drei Wege werden neu ausgelost.",
        rarity: Common,
        price: 2,
        action: RerollRoutes,
        category: Schnapps,
    ),
    (
        id: "road_beer",
        name: "Wegbier",
        text: "Auf dem Weg zur nächsten Kneipe: Dort darfst du einmal mehr einmischen, und ihr Zielwert sinkt um 3.",
        rarity: Common,
        price: 3,
        action: NextPub(redeals: 1, target: -3),
        category: Schnapps,
    ),
    // Effekte v2 (DESIGN 7.2, 12): Modifikationen mit festem Wert am
    // Tresen. Dieselbe auf derselben Karte steigt, eine andere ersetzt.
    // Preise und Seltenheit Platzhalter für `balance`.
    (
        id: "points_3",
        name: "Augen +3",
        text: "Eine Karte zählt 3 Augen mehr. Trägt sie schon Augen, kommen sie dazu.",
        rarity: Common,
        price: 2,
        action: ApplyCardMod(card_mod: "points", value: 3),
    ),
    (
        id: "trump_2",
        name: "Trumpf +2",
        text: "Ist die Farbe der Karte Trumpf und hältst du sie, steigt der Grundwert um 2.",
        rarity: Common,
        price: 3,
        action: ApplyCardMod(card_mod: "trump_bonus", value: 2),
    ),
    (
        id: "rank_1",
        name: "Rang +1",
        text: "Eine Karte sticht eine Stufe höher, höchstens zwei.",
        rarity: Common,
        price: 3,
        action: ApplyCardMod(card_mod: "rank", value: 1),
    ),
]
