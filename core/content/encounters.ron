// Ereignisse (DESIGN 13): Stationen auf dem Weg zwischen zwei Kneipen
// (Kneipentour, ADR 0016). Jedes Ereignis gehört zu einer Kategorie, die
// die Routenwahl zeigt: Event (Begegnung, Standard), Upgrade (Karten
// verbessern oder säubern) oder Rest (Rast). Jedes Ereignis bietet
// Optionen an, eine davon ist immer „Weitergehen“.
// weight: wie oft es innerhalb seiner Kategorie gezogen wird (Standard 1;
// 0 = nie auf einer Route). characters: leer = alle.
// Flüche (DESIGN 7.2) kommen nur über Ereignisse, deren Text „Fluch“ sagt
// (geprüft beim Laden); jeder Fluch zahlt beim Erhalt Groschen. Zufällige
// Modifikationen (card_mod: None) sind nie ein Fluch, außer mit curse: true.
[
    (
        id: "stammtisch_dispute",
        name: "Stammtisch-Streit",
        text: "Am Tisch wird gestritten, welche Hausregel gilt. Wähle eine: Sie gilt bis zum Ende des Stadtteils, ohne einen Platz zu belegen.",
        kind: EveningRule(offers: 3),
    ),
    (
        id: "card_dealer",
        name: "Der Kartengeber",
        text: "Der Kartengeber zinkt dir eine zufällige Karte, nie mit einem Fluch. Trägt sie dieselbe Modifikation, steigt sie; eine andere ersetzt er. Für 3 Groschen darfst du die Karte selbst wählen.",
        kind: MarkCard(price: 3),
        category: Upgrade,
    ),
    (
        id: "old_friend",
        name: "Alter Bekannter",
        text: "Ein alter Bekannter tauscht eines deiner Relikte gegen ein zufälliges anderes.",
        kind: SwapRelic,
    ),
    (
        id: "last_round",
        name: "Letzte Runde",
        text: "Der Wirt ruft die letzte Runde aus: Das nächste Spiel zählt doppelt, gewonnen wie verloren.",
        kind: DoubleNextGame(factor: 2),
    ),
    // M4: five more, with the same four kinds.
    (
        id: "spilled_beer",
        name: "Umgekipptes Bier",
        text: "Ein Bier kippt über das Blatt. Eine zufällige Karte wird ramponiert, ein Fluch: 5 Augen weniger, auch unter 0. Du kassierst 3 Groschen dafür. Für 4 Groschen wischst du es auf eine Karte deiner Wahl.",
        kind: MarkCard(price: 4, card_mod: Some("battered"), value: Some(5)),
    ),
    (
        id: "crown_inn",
        name: "Gasthof zur Krone",
        text: "Der Kronenwirt stempelt einer zufälligen Karte seine Krone auf: Trumpf +4, ist ihre Farbe Trumpf und hältst du sie, steigt der Grundwert um 4. Für 4 Groschen wählst du die Karte.",
        kind: MarkCard(price: 4, card_mod: Some("trump_bonus"), value: Some(4)),
        characters: [Declarer],
        category: Upgrade,
    ),
    (
        id: "conjurer",
        name: "Der Taschenspieler",
        text: "Ein Taschenspieler steckt einer zufälligen Karte einen Gutschein zu: Drückst du sie, wird sie zur Wandelkarte. Für 3 Groschen wählst du die Karte.",
        kind: MarkCard(price: 3, card_mod: Some("voucher_wild")),
        characters: [NullPlayer],
        category: Upgrade,
    ),
    (
        id: "prize_skat",
        name: "Preisskat",
        text: "Im Nebenzimmer läuft ein Preisskat. Spielst du mit, zählt das nächste Spiel dreifach, gewonnen wie verloren.",
        kind: DoubleNextGame(factor: 3),
    ),
    // M7: curses only where announced. The curse is drawn when the
    // encounter opens and both options name it; it pays 3 Groschen when
    // attached, choosing the card costs 1 more than that.
    (
        id: "card_sharp",
        name: "Der Falschspieler",
        text: "Ein Falschspieler zahlt dir 3 Groschen, wenn er eine zufällige Karte deines Blatts präparieren darf. Das ist ein Fluch, welcher, siehst du vorher. Für 4 Groschen suchst du die Karte selbst aus.",
        kind: MarkCard(price: 4, curse: true),
    ),
    (
        id: "guest_from_altenburg",
        name: "Gast aus Altenburg",
        text: "Ein Gast aus Altenburg bringt zwei Hausregeln mit. Wähle eine: Sie gilt bis zum Ende des Stadtteils, ohne einen Platz zu belegen.",
        kind: EveningRule(offers: 2),
    ),
    // Kneipentour (ADR 0016, 02.11.2026): Werkstatt (Upgrade), Rast und
    // die Beute einer Spelunke (nie auf einer Route, weight: 0).
    (
        id: "workshop",
        name: "Die Kartenwerkstatt",
        text: "In der Hinterhofwerkstatt malt ein alter Kartenmaler Karten auf. Er setzt dir umsonst eine Modifikation auf eine Karte deiner Wahl, nie einen Fluch, oder er wäscht eine Karte ganz sauber, Flüche eingeschlossen.",
        kind: Workshop,
        category: Upgrade,
    ),
    (
        id: "snack_bar",
        name: "Die Imbissbude",
        text: "Eine Currywurst mit Pommes und ein Wasser dazu: Du kommst wieder zu Kräften und bekommst ein Leben zurück.",
        kind: Rest(lives: 1),
        category: Rest,
    ),
    (
        id: "spelunke_loot",
        name: "Die Beute",
        text: "Der Wirt der Spelunke schiebt dir über den Tresen, was er unter der Theke hatte. Nimm es mit oder lass es dir in Groschen auszahlen.",
        kind: RelicReward,
        weight: 0,
    ),
]
