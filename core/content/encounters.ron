// Ereignisse (DESIGN 13): Stationen auf dem Weg zwischen zwei Kneipen
// (Kneipentour, ADR 0016). Jedes Ereignis gehört zu einer Kategorie, die
// die Routenwahl zeigt: Event (Begegnung, Standard), Upgrade (Karten
// verbessern oder säubern), Rest (Rast), FoundCoins (Fundgroschen) oder
// DiceStall (Würfelbude). Tresen und Kiosk sind Läden, keine Ereignisse.
//
// Wege und Begegnungen v2 (Entscheidung des Nutzers, 03.11.2026): Jedes
// Ereignis bietet zwei oder drei Optionen als Daten (`options`), eine
// davon muss genommen werden; „Weitergehen“ gibt es nicht mehr. Eine
// Option hat einen Titel (`label`), einen Preis (`cost`, bei Wette und
// Würfelbude der Einsatz) und eine kleine Liste von Wirkungen
// (`effects`, EncounterEffect im Code), die nacheinander gelten. Was eine
// Wirkung offen lässt (None), wird beim Öffnen gezogen und vorher
// gezeigt. Eine Option, die gerade nicht geht (zu teuer, kein Relikt,
// keine passende Karte, Spezialkarten-Grenze), ist gesperrt und nennt den
// Grund. Jedes Ereignis hat eine Option, die nichts kostet (`fallback`:
// nur angeboten, wenn sonst nichts geht); nur die Wette setzt in jeder
// Option und liegt deshalb nur auf einem Weg, wenn der kleinste Einsatz
// bezahlbar ist.
//
// weight: wie oft es innerhalb seiner Kategorie gezogen wird (Standard 1;
// 0 = nie auf einer Route). characters: leer = alle.
// Flüche (DESIGN 7.2) kommen nur über Ereignisse, deren Text „Fluch“ sagt
// (geprüft beim Laden); jeder Fluch zahlt beim Erhalt Groschen. Zufällige
// Modifikationen (card_mod: None) sind nie ein Fluch, außer mit curse: true.
// Alle Zahlen VORLÄUFIG, nach Augenmaß ohne Messung (03.11.2026).
[
    (
        id: "stammtisch_dispute",
        name: "Stammtisch-Streit",
        text: "Am Tisch wird gestritten, welche Hausregel gilt. Wähle eine: Sie gilt bis zum Ende des Stadtteils, ohne einen Platz zu belegen.",
        options: [
            (label: "Diese Regel", effects: [EveningRule(None)]),
            (label: "Diese Regel", effects: [EveningRule(None)]),
            (label: "Diese Regel", effects: [EveningRule(None)]),
        ],
    ),
    (
        id: "card_dealer",
        name: "Der Kartengeber",
        text: "Der Kartengeber will dir eine Karte zinken, nie mit einem Fluch. Trägt sie dieselbe Modifikation, steigt sie; eine andere ersetzt er. Lässt du ihn nicht, zahlt er dir fürs Zuschauen.",
        options: [
            (label: "Zufällige Karte zinken", effects: [Mark(card: Random)]),
            (label: "Karte selbst wählen", cost: 3, effects: [Mark(card: Chosen)]),
            (label: "Nur zuschauen", effects: [Coins(2)]),
        ],
        category: Upgrade,
    ),
    (
        id: "old_friend",
        name: "Alter Bekannter",
        text: "Ein alter Bekannter setzt sich zu dir. Er tauscht eines deiner Relikte gegen ein anderes, kauft dir eines zum vollen Preis ab oder gibt einfach einen Schnaps aus.",
        options: [
            (label: "Relikt tauschen", effects: [SwapRelic(None)]),
            (label: "Relikt verkaufen", effects: [SellRelic(100)]),
            (label: "Einen Schnaps", effects: [Schnapps(None)]),
        ],
    ),
    (
        id: "last_round",
        name: "Letzte Runde",
        text: "Der Wirt ruft die letzte Runde aus. Spielst du mit doppeltem Einsatz, gibst du eine Runde aus, oder bleibst du beim Wasser?",
        options: [
            (label: "Doppelter Einsatz", effects: [NextGameFactor(2)]),
            (label: "Eine Runde ausgeben", cost: 3, effects: [NextPubRedeals(1)]),
            (label: "Nur Wasser", effects: [Coins(1)]),
        ],
    ),
    (
        id: "spilled_beer",
        name: "Umgekipptes Bier",
        text: "Ein Bier kippt über das Blatt. Eine Karte wird ramponiert, ein Fluch: 5 Augen weniger, auch unter 0. Dafür kassierst du 3 Groschen. Für 4 Groschen lenkst du es auf eine Karte deiner Wahl, für 2 wischst du alles auf.",
        options: [
            (label: "Zufällige Karte", effects: [Mark(card: Random, card_mod: Some("battered"), value: Some(5))]),
            (label: "Karte selbst wählen", cost: 4, effects: [Mark(card: Chosen, card_mod: Some("battered"), value: Some(5))]),
            (label: "Aufwischen", cost: 2),
        ],
    ),
    (
        id: "crown_inn",
        name: "Gasthof zur Krone",
        text: "Der Kronenwirt stempelt einer Karte sein Siegel auf: Trumpf +4, ist ihre Farbe Trumpf und hältst du sie, steigt der Grundwert um 4. Oder du trinkst ein Kronenbier auf seine Rechnung.",
        options: [
            (label: "Zufällige Karte", effects: [Mark(card: Random, card_mod: Some("trump_bonus"), value: Some(4))]),
            (label: "Karte selbst wählen", cost: 4, effects: [Mark(card: Chosen, card_mod: Some("trump_bonus"), value: Some(4))]),
            (label: "Kronenbier", effects: [Schnapps(None)]),
        ],
        characters: [Declarer],
        category: Upgrade,
    ),
    (
        id: "conjurer",
        name: "Der Taschenspieler",
        text: "Ein Taschenspieler steckt einer Karte eine Narrenmarke zu: Drückst du sie, wird sie zur Wandelkarte. Oder er zeigt dir einen Kartentrick, und im nächsten Spiel siehst du beide Skatkarten.",
        options: [
            (label: "Zufällige Karte", effects: [Mark(card: Random, card_mod: Some("voucher_wild"))]),
            (label: "Karte selbst wählen", cost: 3, effects: [Mark(card: Chosen, card_mod: Some("voucher_wild"))]),
            (label: "Kartentrick", effects: [SeeSkat]),
        ],
        characters: [NullPlayer],
        category: Upgrade,
    ),
    (
        id: "prize_skat",
        name: "Preisskat",
        text: "Im Nebenzimmer läuft ein Preisskat. Spielst du mit, zählt das nächste Spiel doppelt oder dreifach, gewonnen wie verloren. Oder du kiebitzt nur und bekommst ein Trinkgeld.",
        options: [
            (label: "Dreifacher Einsatz", effects: [NextGameFactor(3)]),
            (label: "Doppelter Einsatz", effects: [NextGameFactor(2)]),
            (label: "Nur kiebitzen", effects: [Coins(2)]),
        ],
    ),
    (
        id: "guest_from_altenburg",
        name: "Gast aus Altenburg",
        text: "Ein Gast aus Altenburg bringt zwei Hausregeln mit; die gewählte gilt bis zum Ende des Stadtteils, ohne einen Platz zu belegen. Oder er zeigt dir einen Kniff: Winkel +1 auf eine Karte deiner Wahl.",
        options: [
            (label: "Diese Regel", effects: [EveningRule(None)]),
            (label: "Diese Regel", effects: [EveningRule(None)]),
            (label: "Ein Kniff", effects: [Mark(card: Chosen, card_mod: Some("rank"), value: Some(1))]),
        ],
