    (
        id: "landlord_treat",
        name: "Der Wirt spendiert",
        text: "Der Wirt ist bester Laune und gibt einen aus: Such dir einen von zwei Schnäpsen aus, oder er drückt dir 5 Groschen in die Hand.",
        options: [
            (label: "Diesen Schnaps", effects: [Schnapps(None)]),
            (label: "Diesen Schnaps", effects: [Schnapps(None)]),
            (label: "5 Groschen", effects: [Coins(5)]),
        ],
    ),
    (
        id: "card_sharp",
        name: "Falschspieler am Nebentisch",
        text: "Am Nebentisch bietet dir ein Falschspieler für 2 Groschen einen starken Kartentrick an, auf eine Karte deiner Wahl. Jedes zweite Mal ist es Schund, und ein Fluch landet auf der Karte. Du kannst ihn auch auffliegen lassen oder gegen ihn spielen.",
        options: [
            (label: "Den Trick kaufen", cost: 2, effects: [Mark(card: Chosen, offers: [("rank", 1), ("trump_bonus", 4), ("points", 6)], curse_percent: 50)]),
            (label: "Auffliegen lassen", effects: [Coins(4)]),
            (label: "Gegen ihn spielen", effects: [NextGameFactor(2)]),
        ],
    ),
    (
        id: "lost_wallet",
        name: "Verlorenes Portemonnaie",
        text: "Unter dem Tisch liegt ein Portemonnaie mit 8 Groschen. Behältst du es, wird eine zufällige Karte durchsichtig, ein Fluch: Das schlechte Gewissen sieht man dir an. Gibst du es am Tresen ab, bekommst du ein Leben zurück; der Besitzer zahlt auch Finderlohn.",
        options: [
            (label: "Behalten", effects: [Coins(8), Mark(card: Random, card_mod: Some("transparent"))]),
            (label: "Am Tresen abgeben", effects: [Lives(1)]),
            (label: "Finderlohn", effects: [Coins(4)]),
        ],
    ),
    (
        id: "skat_teacher",
        name: "Der Skatlehrer",
        text: "Ein alter Skatlehrer zeigt dir einen Kniff: Winkel +1 auf eine Karte deiner Wahl, aber er redet so lange, dass du im ersten Spiel der nächsten Kneipe einmal weniger einmischen darfst. Oder er erklärt die Theorie, oder er lässt dir einen Kurzen da.",
        options: [
            (label: "Der Kniff", effects: [Mark(card: Chosen, card_mod: Some("rank"), value: Some(1)), NextPubRedeals(-1)]),
            (label: "Die Theorie", effects: [SeeSkat]),
            (label: "Ein Kurzer", effects: [Schnapps(Some("shot"))]),
        ],
    ),
    (
        id: "the_bet",
        name: "Die Wette",
        text: "Ein Gast wettet, dass du das nächste Spiel nicht mit Schneider gewinnst. Hältst du dagegen und gewinnst mit Schneider, bekommst du den doppelten Einsatz zurück. Oder du wettest nur auf einen Sieg, für das Anderthalbfache. Sonst ist der Einsatz weg; der Ramsch zählt nicht.",
        options: [
            (label: "3 auf Schneider", cost: 3, effects: [Bet(on: Schneider, percent: 200)]),
            (label: "6 auf Schneider", cost: 6, effects: [Bet(on: Schneider, percent: 200)]),
            (label: "2 auf Sieg", cost: 2, effects: [Bet(on: Win, percent: 150)]),
        ],
    ),
    (
        id: "old_cards",
        name: "Alte Karten im Schrank",
        text: "Im Schrank liegt ein altes Blatt mit Gutscheinen. Einer kommt auf eine Karte deiner Wahl, aber das alte Blatt bringt auch einen Fluch mit, auf eine zufällige andere Karte. Oder du verkaufst das alte Blatt.",
        options: [
            (label: "Totenmarke", effects: [Mark(card: Chosen, card_mod: Some("voucher_undead")), Mark(card: Random, curse: true)]),
            (label: "Narrenmarke", effects: [Mark(card: Chosen, card_mod: Some("voucher_wild")), Mark(card: Random, curse: true)]),
            (label: "Blatt verkaufen", effects: [Coins(4)]),
        ],
    ),
    (
        id: "lookout",
        name: "Kiebitz am Fenster",
        text: "Ein Kiebitz am Fenster kennt die Gegend: Er verrät dir, was auf den nächsten zwei Wegen genau wartet. Oder er hält dir in der nächsten Kneipe den Rücken frei, und du darfst dort einmal mehr einmischen. Oder er steckt dir 2 Groschen zu.",
        options: [
            (label: "Die Wege", effects: [Scout(2)]),
            (label: "Rückendeckung", effects: [NextPubRedeals(1)]),
            (label: "2 Groschen", effects: [Coins(2)]),
