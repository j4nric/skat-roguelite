// Bosse: Sonderregel für die ganze Boss-Serie (DESIGN 11).
// target_factor: Faktor auf den Zielwert der Boss-Serie (Standard 1.0,
// gesetzt von `balance`).
// characters: für welche Charaktere der Boss gezogen wird (leer: alle).
// character_factors: Zielwert-Faktor für einzelne Charaktere statt
// target_factor (ADR 0012: ein Boss trifft den Nullspieler anders).
// rotation: Endboss, der die Regeln dieser Bosse nacheinander auflegt, eine
// pro Spiel.
// edition: die Boss-Ausgabe (ADR 0015, DESIGN 11, milde Stufe vom
// 02.11.2026): Kartenfilter, Modifikation, Wert. Die Karten, die der Boss
// (links) hält, tragen sie; der Stammgast rechts spielt die normale
// Ausgabe. Der Alte hat keine eigene, er spielt die Ausgabe des Bosses,
// dessen Regel gerade gilt.
// back: Id der Kartenrückseite (web/src/ui/backs.ts, Bilder aus
// tools/cardart/backs.py): jeder Boss seine eigene, auch Der Alte (nicht die
// des Bosses, dessen Regel gerade gilt); ohne Angabe die der Stammgäste.
[
    (
        id: "the_pusher",
        name: "Der Schieber",
        back: Some("the_pusher"),
        text: "Jedes Spiel ist ein Handspiel.",
        passive: [RequireHand],
        // Schmuggelware: Luschen, die doch etwas wert sind.
        edition: [((rank: Some(Seven)), "points", 4)],
        target_factor: 1.0,
        // M5: Der Nullspieler gewann Null Hand ohne Skat höchstens 24 % der
        // Boss-Serien und stand nicht im Pool. Seit ADR 0012 darf er auch
        // Farbe und Grand, der Bot spielt Null Hand nur mit höchstens zwei
        // offenen Karten: 52 % bei Zielwert 1, 38 % bei 48 (normale Serie
        // 85 und 76 %, --curve --boss the_pusher --character null, 600
        // Serien). Wie der Schwarze Peter beim Alleinspieler (Obergrenze
        // 53 %) mit eigenem Faktor zurück.
        character_factors: {NullPlayer: 0.4},
    ),
    (
        id: "kontra_hans",
        name: "Der Kontra-Hans",
        back: Some("kontra_hans"),
        text: "Kontra ist immer erlaubt, auch ohne Hausregel.",
        passive: [EnableKontra],
        // Hans legt einen drauf: Macht sein König den letzten Stich, eine
        // Gewinnstufe mehr (der Einsatz steigt, gewonnen wie verloren).
        edition: [((rank: Some(King)), "last_trick", 1)],
        // M5: Im Run gewinnt der PIMC-Spieler 89 bis 91 % der Boss-Serien
        // (normale Serie 85 %), bei 72 in der Kurve 68 % statt 56 %. Mit 1,5
        // liegt er bei jedem Zielwert knapp unter einer normalen Serie.
        target_factor: 1.5,
    ),
    (
        id: "grandma",
        name: "Die Oma",
        back: Some("grandma"),
        text: "Die Oma hat alle Buben eingesteckt. In dieser Kneipe sind sie Blankos.",
        passive: [BlankOut((rank: Some(Jack)))],
        // Die alte Oberin: 6 statt 3 Augen.
        edition: [((rank: Some(Queen)), "points", 3)],
        // M4-Messung (--curve --boss grandma, 3000 Serien): ohne Buben gewinnt der
        // Bot höchstens 35 % (Zielwert 1), bei 110 nur 0,7 % (normal 18,5 %).
        // M5 (PIMC-Spieler, 8 Spiele): Obergrenze 42 %, bei 24 noch 36 %.
        // Im Run mit der v1-Kurve (Boss-Zielwerte 54 bis 66) und 0,4 nur 37
        // bis 44 %. 0,3 legt jede Boss-Serie auf höchstens 20, nah an die
        // Obergrenze; schwerer als jede andere bleibt sie.
        target_factor: 0.3,
        // Das Blatt des Nullspielers hat keine Unter: Die Oma nimmt ihm
        // nichts und wäre mit 0,3 eine geschenkte Serie (--curve: wie eine
        // normale Serie). Deshalb weiter nur für den Alleinspieler.
        characters: [Declarer],
    ),
    (
        id: "twins",
        name: "Die Zwillinge",
        back: Some("twins"),
        text: "Die Gegner sehen gegenseitig ihre Blätter und spielen danach.",
        passive: [DefendersSeeEachOther],
        // Die Acht sieht aus wie zwei Nullen übereinander: zwei Stufen höher.
        edition: [((rank: Some(Eight)), "rank", 2)],
        target_factor: 1.0,
    ),
    (
        id: "ramscher",
        name: "Der Ramscher",
        back: Some("ramscher"),
        text: "Das erste Spiel in der Kneipe ist ein Ramsch: Unter sind Trumpf, jeder spielt für sich, wer die meisten Augen hat, verliert. Hast du nicht die meisten, zählen die Augen des Verlierers für dich, sonst doppelt gegen dich.",
        passive: [RamschOnce],
        // Er lässt laufen: seine Daus zählen 6 Augen weniger (Ramponiert).
        edition: [((rank: Some(Ace)), "battered", 6)],
        // M4-Messung: Der Ramsch bringt gewonnen die Augen des Verlierers, der
        // Bot gewinnt ihn oft. Bei 63 gewinnt er 59 % (normal 41 %), bei 110
        // 37,5 % (18,5 %). M5 (8 Spiele, PIMC): Die Kurve ist flach (73 % bei
        // 1, 65 % bei 72), verliert der Bot den Ramsch, ist die Serie meist
        // weg. Mit 1,5 lag er im Run bei 60 bis 63 %, unter den anderen
        // Bossen ohne Informationsregel; 1,25.
        target_factor: 1.25,
    ),
    (
        id: "revolutionary",
        name: "Der Revolutionär",
        back: Some("revolutionary"),
        text: "Nach dem fünften Stich tauschen die Gegner ihre Blätter.",
        hooks: [
            OnTrickEnd(when: TricksPlayed(5), then: [SwapDefenderHands]),
        ],
        // Die Zehn stürzt den Daus: eine Stufe höher. Nach dem Tausch
        // bleibt die Ausgabe beim Platz, die Zehnen sind beim Stammgast
        // normal.
        edition: [((rank: Some(Ten)), "rank", 1)],
        // 02.11.2026 (Serien mit 3 Spielen): Mit 1,0 gewann der Bot ihn so
        // oft wie eine normale Serie (Alleinspieler 80 %, Grandspieler 83 %,
        // Wirtin 82 %), mit 1,5 zu 68 bis 74 %, wie den Kontra-Hans. Der
        // Nullspieler gewann ihn mit 1,0 nur zu 68 % und behält 1,0.
        target_factor: 1.5,
        character_factors: {NullPlayer: 1.0},
    ),
    (
        id: "black_peter",
        name: "Der Schwarze Peter",
        back: Some("black_peter"),
        text: "Ein gewonnenes Spiel ohne Schneider zählt nur halb. Mit Schneider zählt es voll, verlorene wie immer.",
        // Antwort im Cockpit (02.11.2026): halb statt null. Der Spielwert
        // wird wie bei jedem Faktor am Ende kaufmännisch gerundet (13,5 → 14).
        hooks: [
            OnScore(when: All([Won, Not(WonSchneider)]), then: [ScaleGameValue(0.5)]),
        ],
        // Ruß an den Fingern: Hält er die schwarzen Unter, siehst du es.
        edition: [
            ((suit: Some(Clubs), rank: Some(Jack)), "transparent", 1),
            ((suit: Some(Spades), rank: Some(Jack)), "transparent", 1),
        ],
        // M4-Messung: Obergrenze 41 % (Zielwert 1), bei 110 nur 6,6 % (normal
        // 18,5 %). M5 (PIMC-Spieler): Obergrenze 53 %, im Run 57 bis 60 %.
        // 0,5 hält sie bis 72 über 40 %. Gemessen mit der alten Regel
        // (ohne Schneider null); mit „halb“ neu messen.
        target_factor: 0.5,
        // ADR 0012: Ein gewonnenes Null ist nie Schneider, der Nullspieler
        // muss hier Farbe spielen (ohne Unter). Obergrenze 43,5 %, bei
        // Zielwert 36 noch 34 % (--curve --boss black_peter --character
        // null, 600 Serien), wie die Oma beim Alleinspieler (42 %, 0,3).
        character_factors: {NullPlayer: 0.2},
    ),
    (
        id: "kibitz_killer",
        name: "Der Kiebitz-Mörder",
        text: "Keiner schaut in fremde Karten: Kiebitz, Zähler und durchsichtige Karten sind abgeschaltet.",
        passive: [DisableInformation],
        // Keine Modifikationen, nur eine eigene Rückseite.
        back: Some("kibitz_killer"),
        // 02.11.2026 (Serien mit 3 Spielen): Mit 1,0 gewann der Bot ihn so
        // oft wie eine normale Serie (75 bis 85 %), mit 1,5 zu 68 bis 71 %.
        // Der Nullspieler (72 % mit 1,0) behält 1,0.
        target_factor: 1.5,
        character_factors: {NullPlayer: 1.0},
    ),
    (
        id: "the_old_man",
        name: "Der Alte",
        back: Some("the_old_man"),
        text: "Der Endboss legt jede Regel der anderen Bosse auf, eine pro Blatt, der Reihe nach. Wer einmischt, bekommt die nächste.",
        rotation: [
            "the_pusher",
            "twins",
            "kontra_hans",
            "revolutionary",
            "ramscher",
            "grandma",
            "black_peter",
            "kibitz_killer",
        ],
        // M4-Messung: Als Endboss (Zielwert 180) gewinnt der Bot 12,9 % (eine
        // normale Serie 3,6 %), weil der Ramsch im fünften Spiel viel bringt.
        // 1,4 entspricht bei 110 genau der normalen Kurve.
        target_factor: 1.4,
    ),
]
