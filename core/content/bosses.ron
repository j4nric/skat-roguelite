// Bosse: Sonderregel für die ganze Boss-Serie (DESIGN 11).
// target_factor: Faktor auf den Zielwert der Boss-Serie (Standard 1.0,
// gesetzt von `balance`).
// characters: für welche Charaktere der Boss gezogen wird (leer: alle).
// character_factors: Zielwert-Faktor für einzelne Charaktere statt
// target_factor (ADR 0012: ein Boss trifft den Nullspieler anders).
// rotation: Endboss, der die Regeln dieser Bosse nacheinander auflegt, eine
// pro Spiel.
[
    (
        id: "the_pusher",
        name: "Der Schieber",
        text: "Jedes Spiel ist ein Handspiel.",
        passive: [RequireHand],
        target_factor: 1.0,
        // M5: Der Nullspieler gewann Null Hand ohne Skat höchstens 24 % der
        // Boss-Serien und stand nicht im Pool. Seit ADR 0012 darf er auch
        // Farbe und Grand, der Bot spielt Null Hand nur mit höchstens zwei
        // offenen Karten: 52 % bei Zielwert 1, 38 % bei 48 (normale Serie
        // 85 und 76 %, --curve --boss the_pusher --character null, 600
        // Serien). Wie der Schwarze Peter beim Alleinspieler (Obergrenze
        // 53 %) mit eigenem Faktor zurück.
        character_factors: {NullPlayer: 0.4},
    ),
    (
        id: "kontra_hans",
        name: "Der Kontra-Hans",
        text: "Kontra ist immer erlaubt, auch ohne Hausregel.",
        passive: [EnableKontra],
        // M5: Im Run gewinnt der PIMC-Spieler 89 bis 91 % der Boss-Serien
        // (normale Serie 85 %), bei 72 in der Kurve 68 % statt 56 %. Mit 1,5
        // liegt er bei jedem Zielwert knapp unter einer normalen Serie.
        target_factor: 1.5,
    ),
    (
        id: "grandma",
        name: "Die Oma",
        text: "Die Oma hat alle Buben eingesteckt. In dieser Serie sind sie Blankos.",
        passive: [BlankOut((rank: Some(Jack)))],
        // M4-Messung (--curve --boss grandma, 3000 Serien): ohne Buben gewinnt der
        // Bot höchstens 35 % (Zielwert 1), bei 110 nur 0,7 % (normal 18,5 %).
        // M5 (PIMC-Spieler, 8 Spiele): Obergrenze 42 %, bei 24 noch 36 %.
        // Im Run mit der v1-Kurve (Boss-Zielwerte 54 bis 66) und 0,4 nur 37
        // bis 44 %. 0,3 legt jede Boss-Serie auf höchstens 20, nah an die
        // Obergrenze; schwerer als jede andere bleibt sie.
        target_factor: 0.3,
        // Das Blatt des Nullspielers hat keine Unter: Die Oma nimmt ihm
        // nichts und wäre mit 0,3 eine geschenkte Serie (--curve: wie eine
        // normale Serie). Deshalb weiter nur für den Alleinspieler.
        characters: [Declarer],
    ),
    (
        id: "twins",
        name: "Die Zwillinge",
        text: "Die Gegner sehen gegenseitig ihre Blätter und spielen danach.",
        passive: [DefendersSeeEachOther],
        target_factor: 1.0,
    ),
    (
        id: "ramscher",
        name: "Der Ramscher",
        text: "Das erste Spiel der Serie ist ein Ramsch: Unter sind Trumpf, jeder spielt für sich, wer die meisten Augen hat, verliert. Hast du nicht die meisten, zählen die Augen des Verlierers für dich, sonst doppelt gegen dich.",
        passive: [RamschOnce],
        // M4-Messung: Der Ramsch bringt gewonnen die Augen des Verlierers, der
        // Bot gewinnt ihn oft. Bei 63 gewinnt er 59 % (normal 41 %), bei 110
        // 37,5 % (18,5 %). M5 (8 Spiele, PIMC): Die Kurve ist flach (73 % bei
        // 1, 65 % bei 72), verliert der Bot den Ramsch, ist die Serie meist
        // weg. Mit 1,5 lag er im Run bei 60 bis 63 %, unter den anderen
        // Bossen ohne Informationsregel; 1,25.
        target_factor: 1.25,
    ),
    (
        id: "revolutionary",
        name: "Der Revolutionär",
        text: "Nach dem fünften Stich tauschen die Gegner ihre Blätter.",
        hooks: [
            OnTrickEnd(when: TricksPlayed(5), then: [SwapDefenderHands]),
        ],
        target_factor: 1.0,
    ),
    (
        id: "black_peter",
        name: "Der Schwarze Peter",
        text: "Ein gewonnenes Spiel zählt nur, wenn die Gegner Schneider sind. Verlorene zählen wie immer.",
        hooks: [
            OnScore(when: All([Won, Not(WonSchneider)]), then: [MultiplyGameValue(0)]),
        ],
        // M4-Messung: Obergrenze 41 % (Zielwert 1), bei 110 nur 6,6 % (normal
        // 18,5 %). M5 (PIMC-Spieler): Obergrenze 53 %, im Run 57 bis 60 %.
        // 0,5 hält sie bis 72 über 40 %.
        target_factor: 0.5,
        // ADR 0012: Ein gewonnenes Null ist nie Schneider, der Nullspieler
        // muss hier Farbe spielen (ohne Unter). Obergrenze 43,5 %, bei
        // Zielwert 36 noch 34 % (--curve --boss black_peter --character
        // null, 600 Serien), wie die Oma beim Alleinspieler (42 %, 0,3).
        character_factors: {NullPlayer: 0.2},
    ),
    (
        id: "kibitz_killer",
        name: "Der Kiebitz-Mörder",
        text: "Keiner schaut in fremde Karten: Kiebitz, Zähler und durchsichtige Karten sind abgeschaltet.",
        passive: [DisableInformation],
        target_factor: 1.0,
    ),
    (
        id: "the_old_man",
        name: "Der Alte",
        text: "Der Endboss legt jede Regel der anderen Bosse auf, eine pro Spiel, der Reihe nach.",
        rotation: [
            "the_pusher",
            "twins",
            "kontra_hans",
            "revolutionary",
            "ramscher",
            "grandma",
            "black_peter",
            "kibitz_killer",
        ],
        // M4-Messung: Als Endboss (Zielwert 180) gewinnt der Bot 12,9 % (eine
        // normale Serie 3,6 %), weil der Ramsch im fünften Spiel viel bringt.
        // 1,4 entspricht bei 110 genau der normalen Kurve.
        target_factor: 1.4,
    ),
]
