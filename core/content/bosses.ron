// Bosse: Sonderregel für die ganze Boss-Kneipe (DESIGN 11, ADR 0017).
// Seit ADR 0017 (03.11.2026, Entscheidung des Nutzers): Jeder Boss sind
// zwei Boss-Spieler auf beiden Gegnerplätzen, jede Figur mit eigenem Namen
// und eigener Ausgabe zum Thema des Bosses (nicht unbedingt gleich). In der
// Boss-Kneipe werden immer alle drei Spiele gespielt, der Zielwert zählt
// nach dem dritten. Verloren ist der Run vorbei.
//
// target_factor: Faktor auf den Zielwert der Boss-Kneipe (Standard 1.0).
// Faktoren des Alleinspielers seit 03.11.2026 nach der kleinen Runde
// (docs/balance/2026-11-03-kleine-runde.md, Nachmessung in
// 2026-11-03-grosse-runde.md): Schieber 0,5, Oma 1,0, Zwillinge 1,2,
// Schwarzer Peter 0,7, Ramscher und der Alte 1,0. Die Kurven der
// Boss-Kneipen sind flach (0,15 bis 0,25 Punkte je Zielwert-Punkt), der
// Faktor stellt nur fein nach. Die Faktoren der Nullspieler-Spalte sind
// weiter nach Augenmaß. Die alten Messungen (M4, M5, Serien mit 3 Spielen) galten einem
// Boss-Platz und dem frühen Ende; sie stehen in DESIGN 11.
// characters: für welche Charaktere der Boss gezogen wird (leer: alle).
// character_factors: Zielwert-Faktor für einzelne Charaktere statt
// target_factor (ADR 0012: ein Boss trifft den Nullspieler anders).
// rotation: Endboss, der die Regeln dieser Bosse nacheinander auflegt, eine
// pro Spiel; seine Figuren spielen die Ausgaben der Figuren des Bosses,
// dessen Regel gerade gilt (links die erste, rechts die zweite).
// figures: die zwei Boss-Spieler, links (erste) und rechts (zweite) vom
// Spieler: Name, Ausgabe (ADR 0015: Kartenfilter, Modifikation, Wert; die
// Karten, die die Figur hält, tragen sie), optional eine eigene Rückseite.
// back: Id der Kartenrückseite (web/src/ui/backs.ts, Bilder aus
// tools/cardart/backs.py) für beide Figuren; jeder Boss seine eigene, auch
// Der Alte (nicht die des Bosses, dessen Regel gerade gilt).
// figures[].quips: Sprüche der Figur in der Stimme des Bosses (DESIGN 11,
// wie die Stammgäste in guests.ron, je Anlass zwei Varianten, höchstens
// 40 Zeichen): greet beim Auftritt (die linke Figur auf dem Boss-Blatt, die
// rechte am Tisch), win und lose bei einem Stich mit 10 Augen oder mehr
// (ihre Seite, deine), won und lost am Ende eines Spiels (ihre Seite
// gewinnt, du gewinnst), beaten wenn du die Boss-Kneipe gewinnst, victory
// wenn der Boss sie gewinnt. Englisch nach Boss-Id in
// web/src/i18n/en-content.ts (figureQuips). Nur Darstellung.
[
    (
        id: "the_pusher",
        name: "Der Schieber",
        back: Some("the_pusher"),
        text: "Jedes Spiel ist ein Handspiel.",
        passive: [RequireHand],
        // Schmuggelware: Luschen, die doch etwas wert sind. Er schiebt die
        // Siebenen, seine Hehlerin die Achten.
        figures: [
            (
                name: "Der Schieber",
                edition: [((rank: Some(Seven)), "points", 4)],
                quips: (
                    greet: ["Hand aufs Herz: Hier wird nicht geguckt.", "Skat bleibt zu. Ist so abgemacht."],
                    win: ["Unter der Hand verschoben.", "Ware ist angekommen."],
                    lose: ["Kleiner Schwund. Passiert.", "Den buch ich ab."],
                    won: ["Geschäft ist Geschäft.", "Lief wie geschmiert."],
                    lost: ["Na, du schiebst ja auch.", "Verlust. Wird verrechnet."],
                    beaten: ["Respekt. Du kannst handeln.", "Gut. Ich bin raus aus dem Geschäft."],
                    victory: ["Tja. Der Laden gehört mir.", "Hand drauf: Das war's."],
                ),
            ),
            (
                name: "Die Hehlerin",
                edition: [((rank: Some(Eight)), "points", 3)],
                quips: (
                    greet: ["Was du hast, kauf ich. Billig.", "Frag nicht, woher die Achten sind."],
                    win: ["Hab ich günstig gekriegt.", "Der Stich ist vom Laster gefallen."],
                    lose: ["Den hätt ich gern zurück.", "Gestohlen? Na, so was."],
                    won: ["Gute Ware, guter Preis.", "Das läuft über meine Bücher."],
                    lost: ["Hm. Die Ware war heiß.", "Gut gehandelt, Kleiner."],
                    beaten: ["Du hast mich übers Ohr gehauen.", "Ich schließ den Laden. Für heute."],
                    victory: ["Danke für die Ware.", "Komm wieder. Ich kauf alles."],
                ),
            ),
        ],
        // Vorläufig (03.11.2026): drei volle Handspiele gegen zwei
        // Ausgaben mit Augen. Bis ADR 0017 1,0 (Nullspieler 0,4, gemessen
        // mit einem Boss-Platz und frühem Ende).
        // Nullspieler 0,35 → 0,2 (03.11.2026, docs/balance/
        // 2026-11-03-charaktere.md): Er gewinnt die Kneipe nur zu 29 bis
        // 34 %, fast unabhängig vom Zielwert (bei 8 wie bei 21): Unter dem
        // Schieber spielt der Bot Null Hand nur mit höchstens zwei offenen
        // Karten, sonst Farbe ohne Unter. Der Faktor hilft kaum.
        // Runde 3 (05.11.2026): 0,5 → 0,6; in Stadtteil 1 mit 72 bis 79 %
        // (Alleinspieler, Drückeberger, Schneiderin, Bruderherz) neben den
        // Zwillingen der leichteste Boss.
        target_factor: 0.6,
        character_factors: {NullPlayer: 0.2},
    ),
    (
        id: "grandma",
        name: "Die Oma",
        back: Some("grandma"),
        text: "Die Oma kramt in deinen Karten: Die Hälfte deines Decks trägt in dieser Kneipe einen Fluch (Durchsichtig, Ramponiert oder Fleckig). Danach ist alles wie vorher.",
        // ADR 0017: 16 der 32 Karten, je Karte ein zufälliger Fluch mit
        // seinem Standardwert, nur für diese Kneipe, ohne Groschen. Bis
        // 03.11.2026: Alle Unter sind Blankos.
        passive: [CurseForPub(cards: 16, curses: ["transparent", "battered", "stained"])],
        // Aus der alten Zeit: Die Oma spielt die alte Oberin (6 statt 3
        // Augen), der Opa den alten König (6 statt 4).
        figures: [
            (
                name: "Die Oma",
                edition: [((rank: Some(Queen)), "points", 3)],
                quips: (
                    greet: ["Komm, Kind, ich misch dir was.", "Ich hab in deinen Karten gekramt."],
                    win: ["Die alte Oberin sticht noch.", "Siehst du, Kind? Erfahrung."],
                    lose: ["Ach, die Brille.", "Na, nimm ruhig, Kind."],
                    won: ["Wie früher bei Tante Käthe.", "Iss was, Kind, du bist so blass."],
                    lost: ["Fein, Kind. Ganz fein.", "Du hast ja doch aufgepasst."],
                    beaten: ["Gut, Kind. Die Karten kriegst du wieder.", "Jetzt bist du groß, Kind."],
                    victory: ["Nicht traurig sein, Kind.", "Komm Sonntag wieder. Es gibt Kuchen."],
                ),
            ),
            (
                name: "Der Opa",
                edition: [((rank: Some(King)), "points", 2)],
                quips: (
                    greet: ["Setz dich. Der König sitzt schon.", "Wir spielen wie '53."],
                    win: ["Der alte König lebt.", "Eins für den Opa."],
                    lose: ["Hab's nicht gesehen.", "Wo ist mein Hörgerät?"],
                    won: ["Ha! Das kann der Opa noch.", "So spielte man das. Damals."],
                    lost: ["Hm. Gar nicht schlecht.", "Du erinnerst mich an mich."],
                    beaten: ["Gut gemacht. Ich geh schlafen.", "Der König dankt ab."],
                    victory: ["Erfahrung, mein Kind.", "Das war Skat wie früher."],
                ),
            ),
        ],
        // Vorläufig (03.11.2026): Die Flüche treffen den Alleinspieler
        // (Ramponiert, Fleckig) härter als den Nullspieler (im Null zählt
        // nur Durchsichtig). Seit ADR 0017 für alle Charaktere; bis dahin
        // 0,3 und nur der Alleinspieler (ohne Unter).
        target_factor: 1.0,
        character_factors: {NullPlayer: 0.9},
    ),
    (
        id: "twins",
        name: "Die Zwillinge",
        back: Some("twins"),
        text: "Die Zwillinge sehen gegenseitig ihre Blätter und spielen danach.",
        passive: [DefendersSeeEachOther],
        // Sie sehen doppelt: Bei Fritz steht die Acht zwei Stufen höher
        // (zwei Nullen übereinander), bei Franz die Neun.
        figures: [
            (
                name: "Fritz",
                edition: [((rank: Some(Eight)), "rank", 2)],
                quips: (
                    greet: ["Ich bin Fritz. Das ist Franz.", "Wir denken immer dasselbe."],
                    win: ["Hat Franz auch so gesehen.", "Doppelt hält besser."],
                    lose: ["Franz, hast du das gesehen?", "Das war Franz' Schuld."],
                    won: ["Zwei Köpfe, ein Spiel.", "Gleich und gleich, Franz!"],
                    lost: ["Franz hat gepennt.", "Doppelt verloren. Hm."],
                    beaten: ["Gegen dich hilft kein Spiegel.", "Wir gehen. Beide."],
                    victory: ["Zwei gegen einen. Sorry.", "Das haben wir kommen sehen."],
                ),
            ),
            (
                name: "Franz",
                edition: [((rank: Some(Nine)), "rank", 2)],
                quips: (
                    greet: ["Ich bin Franz. Das ist Fritz.", "Fritz weiß, was ich hab."],
                    win: ["Fritz hat's gewusst.", "Sehen wir doppelt? Ja."],
                    lose: ["Fritz! Warum?", "Hab ich Fritz doch gesagt."],
                    won: ["Wie aus einem Kopf.", "Fritz, wir sind gut."],
                    lost: ["Das war Fritz.", "Nächstes Mal schaut Fritz genauer."],
                    beaten: ["Fritz, wir haben verloren. Beide.", "Hast du auch einen Zwilling?"],
                    victory: ["Doppelt gewinnt.", "Fritz und ich danken."],
                ),
            ),
        ],
        // Vorläufig (03.11.2026), bis ADR 0017 1,0. Runde 3 (05.11.2026):
        // 1,2 → 1,35, in Stadtteil 1 mit 70 bis 85 % der leichteste Boss.
        target_factor: 1.35,
    ),
    (
        id: "ramscher",
        name: "Der Ramscher",
        back: Some("ramscher"),
        text: "Jedes Spiel in der Kneipe ist ein Ramsch: Unter sind Trumpf, jeder spielt für sich, wer die meisten Augen hat, verliert. Hast du nicht die meisten, zählen die Augen des Verlierers für dich, sonst einfach gegen dich.",
        // ADR 0017: jedes Spiel, nicht nur das erste. Von 03.11.2026 bis
        // 04.11.2026 zählte hier ein verlorener Ramsch einfach (SingleLoss,
        // DESIGN 17 a). Seit 04.11.2026 zählt jedes verlorene Spiel einfach
        // (Entscheidung des Nutzers, DESIGN 4.3), die Wirkung ruht.
        passive: [Ramsch],
        // Sie lassen laufen: seine Daus zählen 6 Augen weniger, ihre
        // Zehnen 5 (Ramponiert).
        figures: [
            (
                name: "Der Ramscher",
                edition: [((rank: Some(Ace)), "battered", 6)],
                quips: (
                    greet: ["Hier wird geramscht. Immer.", "Wer am wenigsten hat, gewinnt."],
                    win: ["Den schluck ich runter.", "Lieber ich als keiner."],
                    lose: ["Nimm nur, nimm alles.", "Schmeckt's? Gut."],
                    won: ["Wer frisst, der zahlt.", "Ramsch ist Kunst."],
                    lost: ["Leer geblieben. Respekt.", "Du kannst ramschen."],
                    beaten: ["Du ramschst besser als ich.", "Ich hab genug gefressen."],
                    victory: ["Ramsch kennt keine Gnade.", "Komm wieder, wenn du leer bist."],
                ),
            ),
            (
                name: "Die Ramscherin",
                edition: [((rank: Some(Ten)), "battered", 5)],
                quips: (
                    greet: ["Zehnen? Kann ich nicht leiden.", "Mein Mann und ich ramschen gern."],
                    win: ["Ach, schon wieder ich.", "Den nehm ich in Kauf."],
                    lose: ["Bitte, bedien dich.", "Guten Appetit!"],
                    won: ["Satt? Gut.", "Ramsch ist Familiensache."],
                    lost: ["Na, du bist ja sparsam.", "Gut gedrückt, gut geramscht."],
                    beaten: ["Du darfst bei uns einziehen.", "Wir räumen ab. Gut gemacht."],
                    victory: ["Ramsch hat dich satt gemacht.", "Bis zum nächsten Ramsch!"],
                ),
            ),
        ],
        // Vorläufig (03.11.2026): Ein gewonnener Ramsch bringt die Augen
        // des Verlierers (oft 40 bis 60), ein verlorener seit 03.11.2026
        // dasselbe dagegen (vorher das Doppelte). Der Faktor wirkt wenig.
        // Bis ADR 0017 1,25.
        // Nullspieler 2,0 (03.11.2026, so hoch wie die Obergrenze von
        // target_factor): Mit seinen abgestuften Untern hat er im Ramsch
        // keinen Trumpf und gewann die Kneipe bei 1,0 zu 87 bis 88 %, bei
        // 2,0 noch zu gut 70 %.
        // Runde 3 (05.11.2026): 1,0 → 0,7, Nullspieler 2,0 → 1,6. Der
        // schwerste Boss für alle: in Stadtteil 1 45 bis 55 % gegen 64 bis
        // 85 % bei den anderen (Nullspieler 62 %).
        target_factor: 0.7,
        character_factors: {NullPlayer: 1.6},
    ),
    (
        id: "black_peter",
        name: "Der Schwarze Peter",
        back: Some("black_peter"),
        text: "Ein gewonnenes Spiel ohne Schneider zählt nur halb. Mit Schneider zählt es voll, verlorene wie immer.",
        // Antwort im Cockpit (02.11.2026): halb statt null. Der Spielwert
        // wird wie bei jedem Faktor am Ende kaufmännisch gerundet (13,5 → 14).
        hooks: [
            OnScore(when: All([Won, Not(WonSchneider)]), then: [ScaleGameValue(0.5)]),
        ],
        // Ruß an den Fingern: Hält er die schwarzen Unter, sie die schwarzen
        // Oberinnen, siehst du es. Eine Hilfe beim schwersten Boss.
        figures: [
            (
                name: "Der Schwarze Peter",
                edition: [
                    ((suit: Some(Clubs), rank: Some(Jack)), "transparent", 1),
                    ((suit: Some(Spades), rank: Some(Jack)), "transparent", 1),
                ],
                quips: (
                    greet: ["Hab Ruß an den Fingern. Sorry.", "Wer den Peter zieht, verliert."],
                    win: ["Schwarz auf weiß.", "Ruß bleibt hängen."],
                    lose: ["Hast meinen Unter gesehen, was?", "Schmutzige Finger, sauberer Stich."],
                    won: ["Den Peter hast jetzt du.", "Halb ist halb, mein Freund."],
                    lost: ["Mach Schneider, dann zählt's.", "Nur halb so schlimm."],
                    beaten: ["Der Peter bleibt bei mir. Gut.", "Ich wasch mir die Hände."],
                    victory: ["Schwarzer Peter für dich.", "Wer schwarz zieht, zahlt."],
                ),
            ),
            (
                name: "Die Schwarze Grete",
                edition: [
                    ((suit: Some(Clubs), rank: Some(Queen)), "transparent", 1),
                    ((suit: Some(Spades), rank: Some(Queen)), "transparent", 1),
                ],
                quips: (
                    greet: ["Grete. Die Finger halt ich ruhig.", "Meine Oberinnen sind schmutzig."],
                    win: ["Rußig, aber meins.", "Schwarz wie der Ofen."],
                    lose: ["Das hast du gesehen, was?", "Nimm, aber wasch dir die Hände."],
                    won: ["Halbe Sachen machen wir nicht.", "Grete gewinnt. Wie immer."],
                    lost: ["Nur halb, mein Lieber.", "Gut. Schneider wär besser."],
                    beaten: ["Weiß gewaschen. Verdient.", "Ich putz mir die Finger."],
                    victory: ["Rußfinger gewinnen.", "Schwarz steht dir gut."],
                ),
            ),
        ],
        // Vorläufig: unverändert seit der Messung mit der alten Regel (ohne
        // Schneider null) und einem Boss-Platz; mit „halb“, zwei Figuren
        // und drei vollen Spielen neu messen.
        target_factor: 0.7,
        // ADR 0012: Ein gewonnenes Null ist nie Schneider, der Nullspieler
        // muss hier Farbe spielen (ohne Unter). Runde 3 (05.11.2026): 0,2 →
        // 0,4, er gewann ihn in Stadtteil 1 zu 84 %.
        character_factors: {NullPlayer: 0.4},
    ),
    (
        id: "the_old_man",
        name: "Der Alte",
        back: Some("the_old_man"),
        text: "Der Endboss legt die Regeln der anderen Bosse auf, eine pro Blatt, der Reihe nach. Wer einmischt, bekommt die nächste.",
        rotation: [
            "the_pusher",
            "twins",
            "ramscher",
            "grandma",
            "black_peter",
        ],
        // Das alte Paar: Ihre Karten tragen die Ausgaben der Figuren des
        // Bosses, dessen Regel gerade gilt, die Rückseite bleibt ihre.
        figures: [
            (
                name: "Der Alte",
                quips: (
                    greet: ["Jede Runde eine neue Regel.", "Ich kenn alle Tricks. Alle."],
                    win: ["Alt, aber nicht blind.", "Fünfzig Jahre Stammtisch."],
                    lose: ["Respekt, Junge.", "Den hab ich übersehen."],
                    won: ["So spielt man am Stammtisch.", "Noch nicht reif, Junge."],
                    lost: ["Gut. Nächste Regel.", "Du lernst schnell."],
                    beaten: ["Der Tisch gehört dir.", "Setz dich auf meinen Platz."],
                    victory: ["Der Stammtisch bleibt meiner.", "Komm wieder, wenn du alt bist."],
                ),
            ),
            (
                name: "Die Alte",
                quips: (
                    greet: ["Er hat die Regeln, ich die Karten.", "Wir sitzen hier seit 1961."],
                    win: ["Der Alte und ich, wie immer.", "Schon wieder, Liebling."],
                    lose: ["Ach, der Junge kann was.", "Na, sieh mal an."],
                    won: ["Das haben wir oft gesehen.", "Kopf hoch, Kleiner."],
                    lost: ["Gut gespielt, wirklich.", "Er wird grummeln. Egal."],
                    beaten: ["Endlich ein würdiger Gegner.", "Wir gehen in Rente, Alter."],
                    victory: ["Gute Nacht. Komm gut heim.", "Nächsten Freitag wieder?"],
                ),
            ),
        ],
        // Vorläufig (03.11.2026): drei volle Spiele mit drei Regeln. Bis
        // ADR 0017 1,4 (gemessen mit acht Regeln und frühem Ende). Runde 2
        // (04.11.2026, docs/balance/2026-11-04-runde2.md): 1,0 → 1,3; mit
        // 1,0 gewannen Alleinspieler 78 %, die anderen Charaktere 87 bis
        // 89 % beim Endboss. Nachher 71 % (Alleinspieler), 74 bis 81 %.
        // Runde 3 (05.11.2026): 1,3 → 1,5; mit Kartenbelohnung gewannen
        // Alleinspieler 75 %, die anderen 70 bis 82 %, und Stadtteil 3
        // hielt 39 bis 60 % statt rund 27 %.
        // Runde 5 (05.11.2026, acht Relikt-Plätze): 1,5 → 1,2; mit 1,5
        // gewannen Alleinspieler 43 %, Bruderherz 22 %, Schneiderin 33 %,
        // die anderen 50 bis 55 %. Nachher 47 bis 58 %.
        target_factor: 1.2,
    ),
    // Der erste Boss nur der langen Nacht (10.11.2026, DESIGN 5.5 und
    // 11.1; run.ron night_bosses): Der Totengräber ruhte seit ADR 0017 als
    // „Boss mit Sonderkarten“; jetzt mit einer Regel am Hebel Augen. Er
    // begräbt den Skat: Die gedrückten Karten zählen keine Augen (die
    // Wirkung des Skatpflegers mit 0, sie schlägt ihn auch). Ein
    // Handspiel drückt nichts und behält seinen Skat. Im Null zählen
    // Augen nicht, der Nullspieler trifft ihn kaum.
    (
        id: "gravedigger",
        name: "Der Totengräber",
        back: Some("gravedigger"),
        text: "Was gedrückt wird, ist begraben: Deine gedrückten Karten zählen in seiner Kneipe keine Augen. Ein Handspiel behält seinen Skat. Nur in der langen Nacht.",
        hooks: [
            OnDeclare(when: All([Not(HandGame), Not(NullGame)]), then: [MultiplySkatPoints(0)]),
        ],
        // Vom Friedhof: Bei ihm stehen die Neunen zwei Stufen höher auf
        // (die Neun wird König), die Witwe trägt die Daus als Erbstücke
        // (Augen +4, 15 statt 11).
        figures: [
            (
                name: "Der Totengräber",
                edition: [((rank: Some(Nine)), "rank", 2)],
                quips: (
                    greet: ["Was du drückst, begrab ich.", "Spät ist es. Gut für mich."],
                    win: ["Ab unter die Erde.", "Ruhe in Frieden, Stich."],
                    lose: ["Den grab ich wieder aus.", "Noch lebst du."],
                    won: ["Schaufel, Erde, fertig.", "Wieder einer begraben."],
                    lost: ["Der Skat ruht. Du nicht.", "Zäh, der Kleine."],
                    beaten: ["Der Morgen kommt. Ich geh.", "Leg die Schaufel weg. Gewonnen."],
                    victory: ["Ruhe sanft.", "Die Nacht gehört mir."],
                ),
            ),
            (
                name: "Die Witwe",
                edition: [((rank: Some(Ace)), "points", 4)],
                quips: (
                    greet: ["Mein Seliger spielte auch so.", "Die Daus hat er mir vererbt."],
                    win: ["Für meinen Seligen.", "Ein Erbstück, mein Lieber."],
                    lose: ["Das hätte ihm nicht gefallen.", "Ach, nimm ihn."],
                    won: ["Er schaut von oben zu.", "Schwarz steht mir."],
                    lost: ["Du hast sein Glück.", "Ein schönes Spiel. Danke."],
                    beaten: ["Er hätte dich gemocht.", "Nimm die Daus. Er will es so."],
                    victory: ["Ich leg dir Blumen hin.", "Trauer steht dir nicht, Kind."],
                ),
            ),
        ],
        // Gemessen in der Nacht (10.11.2026,
        // docs/balance/2026-11-10-neue-charaktere.md, je 3 × 700 Runs mit
        // --night --night-boss gravedigger): Mit 1,0 gewann der
        // Alleinspieler 92 % seiner Kneipen, der Nullspieler 94 %, mehr als
        // jeder Boss des Tages in der Nacht (81 bis 87 %, der Alte 58 %,
        // der Ramscher 33 %). Der Build der Nacht ist so stark, dass der
        // Faktor wenig bewegt (1,4: 91 / 88 %); mit 2,5 83 / 79 %, wie die
        // mittleren Bosse.
        target_factor: 2.5,
    ),
]
