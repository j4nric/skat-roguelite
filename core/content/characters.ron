// Charaktere (DESIGN 9): Startblatt, Startrelikte, Zielwerte, Null-Wertung
// und wie oft der Tresen Relikte für eine Spielart anbietet. Jeder Charakter
// darf Farbspiel, Grand und Null ansagen (ADR 0012).
//
// deck: Abweichung vom normalen 32er-Blatt. remove nimmt Karten heraus
// (je eine Blanko), add füllt die Blankos mit neuen Karten.
// targets: None nimmt die Zielwerte aus run.ron.
// null_scoring: Fixed (Skatordnung 23/35/46/59 als Grundwert, eine Stufe)
// oder Formula (Grundwert × (Risikostufe + Stilbonus), DESIGN 9.2). Ohne
// Angabe Fixed.
// focus_weights: Gewicht in Prozent, mit dem Tresen, Stempelkissen und
// Ereignisse Relikte und Modifikationen für Farbspiel und Grand (trump) und
// für Null (null) anbieten, gemessen an der Seltenheit. Relikte für jedes
// Spiel zählen immer 100. Ohne Angabe 100 und 100.
// start_consumables: Verbrauchsgegenstände ab Start (z. B. ein Schnaps).
// deck.mods: Kartenmodifikationen im Startblatt, je auf der ersten Karte
// mit diesem Aufdruck; „beim Erhalt“ feuert dabei nicht.
// rule: die eine eigene Regel (DESIGN 9). passive und hooks wirken wie ein
// Relikt, das der Charakter immer hat, ohne Platz (Quelle „Charakter“ in
// der Wertung). redeals (Einmischen pro Spiel) und relic_slots ändern
// run.ron (nie unter 0),
// payout_factor vervielfacht die Groschen einer gewonnenen Serie. Ohne
// Angabe keine Änderung.
[
    (
        character: Declarer,
        name: "Der Alleinspieler",
        text: "Spielt Farbe, Grand und Null mit dem normalen Blatt. Der Maßstab für alles. Startet mit dem Zähler.",
        start_relics: ["card_counter"],
        // Null zählt für alle Charaktere nach der Formel mit Stilbonus
        // (DESIGN 9.2, entschieden am 01.11.2026: eine Null-Wertung für alle).
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        // ADR 0012: Null-Relikte liegen auch bei ihm am Tresen, aber
        // seltener als beim Nullspieler.
        focus_weights: (trump: 100, null: 50),
    ),
    (
        character: NullPlayer,
        name: "Der Nullspieler",
        text: "Der Null-Spezialist: Sein Blatt hat keine Unter, dafür vier Siebener mehr, und am Tresen liegen öfter Null-Relikte. Farbe und Grand darf er auch. Startet mit dem Kiebitz.",
        start_relics: ["kibitzer"],
        // Zielwerte des Alleinspielers (run.ron), seit ADR 0012 gemessen:
        // Mit Farbe und Grand spielt der Bot nur noch rund 30 % seiner Spiele
        // als Null. Mit den eigenen M5-Zielwerten (72/80/88 bis 198/240/264)
        // erreichte er Abschnitt 2 nur in 23 % der Runs (Alleinspieler 36 %),
        // mit denen des Alleinspielers wie dieser (DESIGN 9.2, 3 × 3000 Runs,
        // --bot pimc:12:3). Seit den Serien mit 3 Spielen (01.11.2026)
        // dieselbe vorläufige Kurve wie run.ron, eine Zeile später (DESIGN
        // 5.2); 300 Runs: Abschnitt 2 in 35 % (Alleinspieler 44 %).
        targets: Some([
            (24, 30, 36),
            (24, 30, 36),
            (30, 36, 42),
            (36, 42, 48),
            (42, 48, 54),
        ]),
        deck: (
            remove: ["CJ", "SJ", "HJ", "DJ"],
            add: ["C7", "S7", "H7", "D7"],
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        // ADR 0012: Null-Relikte doppelt so oft, Relikte für Farbe und Grand
        // halb so oft (sein Blatt hat keine Unter).
        focus_weights: (trump: 50, null: 200),
    ),
    // Neue Charaktere vom 01.11.2026 (DESIGN 9.4 bis 9.6). Zielwerte des
    // Alleinspielers (targets: None), noch nicht im Simulator kalibriert
    // (DESIGN 17).
    (
        character: GrandPlayer,
        name: "Der Grandspieler",
        text: "Lebt für den Grand: Ein Grand zählt eine Gewinnstufe mehr, ein Farbspiel eine weniger. Sein Eichel-Daus hat einen Goldrand (+8 Augen).",
        start_relics: [],
        deck: (
            mods: [("CA", "gold_rim")],
        ),
        // Wirkt auf gewonnene und verlorene Spiele. Die Stufen fallen nie
        // unter 1 (Stufen = max(1, Regel + Zuschläge), DESIGN 4.2).
        rule: (
            hooks: [
                OnDeclare(when: GameIs(Grand), then: [AddLevels(1)]),
                OnDeclare(when: SuitGame, then: [AddLevels(-1)]),
            ],
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        focus_weights: (trump: 120, null: 50),
    ),
    (
        character: Onlooker,
        name: "Der Zaungast",
        text: "Schaut dem linken Gegner immer ins Blatt, darf dafür nur einmal pro Spiel einmischen. Der Kiebitz-Mörder nimmt ihm die Sicht.",
        start_relics: [],
        // Eine Informations-Wirkung wie der Kiebitz: Der Kiebitz-Mörder
        // schaltet sie ab.
        rule: (
            passive: [RevealDefenderHand(1)],
            // Einmal statt zweimal einmischen pro Spiel (bis 01.11.2026:
            // zwei Pässe weniger pro Serie).
            redeals: -1,
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
    ),
    (
        character: Landlady,
        name: "Die Wirtin",
        text: "Rechnet gut: Jede gewonnene Serie bringt doppelt so viele Groschen, aber sie hat nur vier Plätze für Relikte. Startet mit einem Kräuter.",
        start_relics: [],
        start_consumables: ["herbal"],
        rule: (
            relic_slots: -1,
            payout_factor: 2,
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
    ),
]
