// Charaktere (DESIGN 9): Startblatt, Startrelikte, Zielwerte, Null-Wertung
// und wie oft der Tresen Relikte für eine Spielart anbietet. Jeder Charakter
// darf Farbspiel, Grand und Null ansagen (ADR 0012).
//
// deck: die Ausgabe des Charakters (ADR 0015): nur Modifikationen
// (deck.mods), nie andere Karten; remove und add sind ein Ladefehler.
// targets: None nimmt die Zielwerte aus run.ron. Je Stadtteil vier Kneipen
// und die Boss-Kneipe (ADR 0016, vorläufig nach Augenmaß aus den
// kalibrierten Kurven der Abschnitte abgeleitet, 02.11.2026).
// null_scoring: Fixed (Skatordnung 23/35/46/59 als Grundwert, eine Stufe)
// oder Formula (Grundwert × (Risikostufe + Stilbonus), DESIGN 9.2). Ohne
// Angabe Fixed.
// focus_weights: Gewicht in Prozent, mit dem Tresen, Stempelkissen und
// Ereignisse Relikte und Modifikationen für Farbspiel und Grand (trump) und
// für Null (null) anbieten, gemessen an der Seltenheit. Relikte für jedes
// Spiel zählen immer 100. Ohne Angabe 100 und 100.
// start_consumables: Verbrauchsgegenstände ab Start (z. B. ein Schnaps).
// deck.mods: Kartenmodifikationen seiner Ausgabe mit Wert (Effekte v2,
// DESIGN 7.2), je auf der Karte mit diesem Aufdruck; „beim Erhalt“ feuert
// dabei nicht.
// rule: die eine eigene Regel (DESIGN 9). passive und hooks wirken wie ein
// Relikt, das der Charakter immer hat, ohne Platz (Quelle „Charakter“ in
// der Wertung). redeals (Einmischen pro Spiel) und relic_slots ändern
// run.ron (nie unter 0),
// payout_factor vervielfacht die Groschen einer gewonnenen Serie. Ohne
// Angabe keine Änderung.
[
    (
        character: Declarer,
        name: "Der Alleinspieler",
        text: "Spielt Farbe, Grand und Null mit dem normalen Blatt. Der Maßstab für alles. Startet mit dem Zähler.",
        start_relics: ["card_counter"],
        // Null zählt für alle Charaktere nach der Formel mit Stilbonus
        // (DESIGN 9.2, entschieden am 01.11.2026: eine Null-Wertung für alle).
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        // ADR 0012: Null-Relikte liegen auch bei ihm am Tresen, aber
        // seltener als beim Nullspieler.
        focus_weights: (trump: 100, null: 50),
    ),
    (
        character: NullPlayer,
        name: "Der Nullspieler",
        text: "Der Null-Spezialist: Seine Unter sind abgestuft (die niedrigste Karte ihrer Farbe), und am Tresen liegen öfter Null-Relikte. Farbe und Grand darf er auch. Mischt dreimal statt zweimal ein. Startet mit dem Kiebitz.",
        // Eigene Zielwerte (DESIGN 5.2), seit 02.11.2026 rund die Hälfte des
        // Alleinspielers: Sein Blatt ohne Unter gewinnt eine Serie mit drei
        // Spielen auch bei Zielwert 1 nur zu 76 % (Alleinspieler 86 %). Mit
        // der vorläufigen Kurve (eine Zeile später als run.ron, 24/30/36 bis
        // 42/48/54) erreichte er Abschnitt 2 in 32 % und gewann 0,4 % der
        // Runs; 23 ist ein einfaches gewonnenes Null. Ab Abschnitt 3 flach,
        // weil er gegen die stärkeren Gegner kaum zulegt.
        targets: Some([
            [18, 20, 20, 23, 23],
            [20, 23, 23, 27, 27],
            [23, 27, 27, 30, 30],
        ]),
        start_relics: ["kibitzer"],
        // Dreimal statt zweimal einmischen pro Spiel (02.11.2026): Mit den
        // Zielwerten oben gewann er nur 0,6 % der ganzen Abende; ein
        // Einmischen mehr hob ihn auf 1,1 % (2 × 800 Runs, DESIGN 5.2).
        rule: (
            redeals: 1,
        ),
        // ADR 0015 (02.11.2026): statt „ohne Unter, vier Siebener mehr“
        // tragen seine vier Unter „Abgestuft“: In seiner Ausgabe sind sie
        // keine Unter, sondern die niedrigste Karte ihrer Farbe ohne Augen.
        // Hält ein Gegner einen Unter, ist er ein echter Unter.
        deck: (
            mods: [
                ("CJ", "demoted", 1),
                ("SJ", "demoted", 1),
                ("HJ", "demoted", 1),
                ("DJ", "demoted", 1),
            ],
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        // ADR 0012: Null-Relikte doppelt so oft, Relikte für Farbe und Grand
        // halb so oft (sein Blatt hat keine Unter).
        focus_weights: (trump: 50, null: 200),
    ),
    // Neue Charaktere vom 01.11.2026 (DESIGN 9.4 bis 9.6). Eigene Zielwerte
    // seit 02.11.2026 (DESIGN 5.2, docs/balance/
    // 2026-11-02-kalibrierung-dreierserie.md), alle auf dasselbe Zielbild
    // wie der Alleinspieler: Abschnitt 2 in gut einem Drittel der Runs, Run
    // gewonnen 1 bis 2 %.
    (
        character: GrandPlayer,
        name: "Der Grandspieler",
        text: "Lebt für den Grand: Ein Grand zählt +1 Multiplikator, ein Farbspiel −1. Sein Eichel-Daus hat einen Goldrand (+8 Augen).",
        // Vorne rund 1,4-mal der Alleinspieler, hinten flach: Ein gewonnener
        // Grand bringt viel, seine Erfolgskurve ist flacher (mit der
        // vorläufigen Kurve vom 01.11. Abschnitt 2 in 50 %, Run gewonnen
        // 2,9 %).
        targets: Some([
            [48, 50, 52, 54, 60],
            [52, 54, 55, 57, 60],
            [55, 57, 59, 60, 66],
        ]),
        start_relics: [],
        deck: (
            mods: [("CA", "points", 8)],
        ),
        // Wirkt auf gewonnene und verlorene Spiele. Die Stufen fallen nie
        // unter 1 (Stufen = max(1, Regel + Zuschläge), DESIGN 4.2).
        rule: (
            hooks: [
                OnDeclare(when: GameIs(Grand), then: [AddLevels(1)]),
                OnDeclare(when: SuitGame, then: [AddLevels(-1)]),
            ],
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        focus_weights: (trump: 120, null: 50),
    ),
    (
        character: Onlooker,
        name: "Der Zaungast",
        text: "Schaut dem linken Gegner immer ins Blatt, darf dafür nur einmal pro Spiel einmischen. Der Kiebitz-Mörder nimmt ihm die Sicht.",
        // Abschnitt 1 wie der Alleinspieler, danach flacher: Mit nur einem
        // Einmischen ist er gegen die stärkeren Gegner schwächer (vorläufige
        // Kurve vom 01.11.: gehalten je Abschnitt 44 / 39 / 35 / 45 / 48 %,
        // Alleinspieler 43 / 41 / 42 / 47 / 55 %).
        targets: Some([
            [33, 35, 37, 40, 45],
            [36, 38, 40, 42, 46],
            [40, 42, 44, 44, 48],
        ]),
        start_relics: [],
        // Eine Informations-Wirkung wie der Kiebitz: Der Kiebitz-Mörder
        // schaltet sie ab.
        rule: (
            passive: [RevealDefenderHand(1)],
            // Einmal statt zweimal einmischen pro Spiel (bis 01.11.2026:
            // zwei Pässe weniger pro Serie).
            redeals: -1,
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
    ),
    (
        character: Landlady,
        name: "Die Wirtin",
        text: "Rechnet gut: Jede gewonnene Kneipe bringt doppelt so viele Groschen, aber sie hat nur vier Plätze für Relikte. Startet mit einem Kräuter.",
        // Vorne deutlich höher (doppelte Groschen kaufen früh Relikte, mit der
        // vorläufigen Kurve Abschnitt 2 in 49 %), hinten flach: Mit
        // vier Plätzen wird sie spät schwächer.
        targets: Some([
            [40, 42, 44, 46, 54],
            [44, 46, 47, 48, 55],
            [48, 50, 52, 54, 60],
        ]),
        start_relics: [],
        start_consumables: ["herbal"],
        rule: (
            relic_slots: -1,
            payout_factor: 2,
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
    ),
]
