// Charaktere (DESIGN 9): Startblatt, Startrelikte, Zielwerte, Null-Wertung
// und wie oft der Tresen Relikte für eine Spielart anbietet. Jeder Charakter
// darf Farbspiel, Grand und Null ansagen (ADR 0012).
//
// deck: die Ausgabe des Charakters (ADR 0015): nur Modifikationen
// (deck.mods), nie andere Karten; remove und add sind ein Ladefehler.
// targets: None nimmt die Zielwerte aus run.ron. Je Stadtteil vier Kneipen
// und die Boss-Kneipe (ADR 0016, vorläufig nach Augenmaß aus den
// kalibrierten Kurven der Abschnitte abgeleitet, 02.11.2026).
// Runde 3 vor der Messung (05.11.2026, VORLÄUFIG): alle eigenen Kurven wie
// die des Alleinspielers verschoben: 1-1 − 20 (höchstens bis 10), 1-2 − 15,
// 1-3 und 1-4 − 5, die normalen Kneipen in Stadtteil 2 − 5, alle Bosse + 10.
// Nach SR3 (05.11.2026, docs/balance/2026-11-05-runde3.md, UNGEMESSEN bis
// SR4): Nullspieler (47,9 / 18,9 / 8,6 %) und Schneiderin (48,4 / 20,2 /
// 7,9 %) in Stadtteil 1 + 15 bis + 25 (eine Prüfung mit + 10 bis + 15 und
// 200 Runs änderte bei ihnen kaum etwas: 48,0 und 46,0 %), Stadtteil 3
// + 20 bis + 35; Nullspieler auch Stadtteil 2 + 15 (2 × 200 Runs mit
// 35 / 50 / 65 / 70 / 105: 43,8 / 21,0 / 6,0 %, Stadtteil 2 hielt 48 %);
// Schneiderin 1-1 und 1-2 nur + 10 (mit + 20: 27 % der Runs in den
// ersten beiden Kneipen);
// Nach SR4 (05.11.2026, docs/balance/2026-11-05-runde4.md): Nullspieler
// 35,9 / 15,9 / 8,2 %, Stadtteil 3 hielt 52 %: Stadtteil 3 + 50, Boss
// 155 → 185, Boss in Stadtteil 2 125 → 140.
// Drückeberger (42,0 / 18,9 / 11,3 %) Stadtteil 1 ab 1-3 + 5, Boss + 10,
// Stadtteil 2 + 5, Stadtteil 3 + 40; Bruderherz (35,2 / 10,8 / 3,1 %)
// 1-3, 1-4 − 5, Stadtteil 2 − 10, Stadtteil 3 − 10.
// null_scoring: Fixed (Skatordnung 23/35/46/59 als Grundwert, eine Stufe)
// oder Formula (Grundwert × (Risikostufe + Stilbonus), DESIGN 9.2). Ohne
// Angabe Fixed.
// focus_weights: Gewicht in Prozent, mit dem Tresen (samt Zinken) und
// Ereignisse Relikte und Modifikationen für Farbspiel und Grand (trump) und
// für Null (null) anbieten, gemessen an der Seltenheit. Relikte für jedes
// Spiel zählen immer 100. Ohne Angabe 100 und 100.
// start_consumables: Verbrauchsgegenstände ab Start (z. B. ein Schnaps).
// deck.mods: Kartenmodifikationen seiner Ausgabe mit Wert (Effekte v2,
// DESIGN 7.2), je auf der Karte mit diesem Aufdruck; „beim Erhalt“ feuert
// dabei nicht.
// rule: die eine eigene Regel (DESIGN 9). passive und hooks wirken wie ein
// Relikt, das der Charakter immer hat, ohne Platz (Quelle „Charakter“ in
// der Wertung). redeals (Einmischen pro Spiel) ändert run.ron (nie unter
// 0), relic_slots: Some(n) begrenzt die Relikte auf n (sonst beliebig viele),
// payout_factor vervielfacht die Groschen einer gewonnenen Serie,
// vouchers_return gibt eingelöste Gutscheine nach jeder Kneipe zurück,
// keep_curses sperrt das Reinigen verfluchter Karten, zinken_discount
// verbilligt Zinken auf passenden Karten. Ohne Angabe keine Änderung.
// back: Kartenrückseite seiner Ausgabe, ohne Angabe die Distel.
[
    (
        character: Declarer,
        name: "Der Alleinspieler",
        text: "Spielt Farbe, Grand und Null mit dem normalen Blatt. Der Maßstab für alles. Startet mit dem Zähler.",
        start_relics: ["card_counter"],
        // Null zählt für alle Charaktere nach der Formel mit Stilbonus
        // (DESIGN 9.2, entschieden am 01.11.2026: eine Null-Wertung für alle).
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        // ADR 0012: Null-Relikte liegen auch bei ihm am Tresen, aber
        // seltener als beim Nullspieler.
        focus_weights: (trump: 100, null: 50),
    ),
    (
        character: NullPlayer,
        name: "Der Nullspieler",
        text: "Der Null-Spezialist: Seine Unter sind abgestuft (die niedrigste Karte ihrer Farbe), und am Tresen liegen öfter Null-Relikte. Farbe und Grand darf er auch. Mischt in jedem Spiel einmal öfter ein. Startet mit dem Kiebitz.",
        // Eigene Zielwerte (DESIGN 5.0.4 und 9), gemessen am 03.11.2026
        // (docs/balance/2026-11-03-charaktere.md): die Kurve des
        // Alleinspielers, Stadtteil 1 × 1,15, Stadtteil 2 × 1,2, Stadtteil 3
        // × 1,25. Mit den alten 18 bis 30 (02.11.2026, halb so hoch wie die
        // damalige Kurve des Alleinspielers) erreichte er Stadtteil 2 in 60 %
        // und gewann 30 % der Runs; mit der Kurve des Alleinspielers 47 % und
        // 9,5 %. Ein gewonnenes Null bringt im Run im Mittel 113 Punkte.
        // Runde 1 nach ADR 0019 (04.11.2026): mit der Kurve oben ohne Leben
        // Stadtteil 2 in 26,9 %, gewonnen 2,0 % (Alleinspieler 29,0 / 1,9 %).
        // Jetzt rund die neue Kurve des Alleinspielers × 1,1.
        // Runde 2 (04.11.2026, docs/balance/2026-11-04-runde2.md): damit
        // 33,4 / 14,6 / 7,3 % (Stadtteil 2 / 3 / gewonnen). Stadtteil 1 wie
        // beim Alleinspieler verschoben (1-3, 1-4 − 5, Boss + 10), Boss in
        // Stadtteil 2 + 10, Stadtteil 3 + 15: gemessen 37,5 / 14,7 / 6,5 %.
        // Danach Stadtteil 3 noch einmal + 10 (Vorschlag, ungemessen).
        // Runde 5 (05.11.2026, acht Relikt-Plätze,
        // docs/balance/2026-11-05-runde5.md): mit 35 / 50 · 85 / 100 / 110 /
        // 120 / Boss 140 · 260 / 280 / 305 / 320 / Boss 185 36,6 / 17,0 /
        // 2,4 %, Stadtteil 2 hielt 47 %, Stadtteil 3 14 %. Jetzt 1-1, 1-2
        // − 5, Stadtteil 2 + 5 (Boss 150), Stadtteil 3 rund − 22 %:
        // 37,4 / 17,3 / 4,8 %.
        // Runde 6 (07.11.2026, docs/balance/2026-11-07-runde6.md): nach den
        // neuen Verteidigern (#108) und Relikten v4 38,4 / 17,2 / 5,8 %
        // (Stadtteil 3 hielt 34 %). Stadtteil 2 + 5 je normaler Kneipe,
        // Stadtteil 3 rund + 12 % (Boss 175 → 195): 38,2 / 15,6 / 3,9 %
        // (5 × 300 Runs).
        targets: Some([
            [30, 45, 80, 85, 120],
            [95, 110, 120, 130, 150],
            [225, 240, 265, 280, 195],
        ]),
        // Die lange Nacht (Balancing-Runde 05.11.2026,
        // docs/balance/2026-11-05-nacht.md): eigenes Wachstum je Stadtteil
        // der Nacht, flacher als in run.ron. Mit dem des Alleinspielers
        // endeten 38 % seiner Nächte in Stadtteil 4 und keine erreichte
        // Stadtteil 8: Seine Null-Spiele wachsen in der Nacht langsamer.
        // Runde 5 (05.11.2026): Ohne die Relikt-Flut (acht Plätze) wächst
        // kein Build mehr stark; wie der Alleinspieler (run.ron).
        night_growth: Some([0.6, 1.0, 1.05, 1.1, 1.25, 1.6]),
        start_relics: ["kibitzer"],
        // Dreimal statt zweimal einmischen pro Spiel (02.11.2026): Mit den
        // Zielwerten oben gewann er nur 0,6 % der ganzen Abende; ein
        // Einmischen mehr hob ihn auf 1,1 % (2 × 800 Runs, DESIGN 5.2).
        rule: (
            redeals: 1,
        ),
        // ADR 0015 (02.11.2026): statt „ohne Unter, vier Siebener mehr“
        // tragen seine vier Unter „Abgestuft“: In seiner Ausgabe sind sie
        // keine Unter, sondern die niedrigste Karte ihrer Farbe ohne Augen.
        // Hält ein Gegner einen Unter, ist er ein echter Unter.
        deck: (
            mods: [
                ("CJ", "demoted", 1),
                ("SJ", "demoted", 1),
                ("HJ", "demoted", 1),
                ("DJ", "demoted", 1),
            ],
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        // ADR 0012: Null-Relikte doppelt so oft, Relikte für Farbe und Grand
        // halb so oft (sein Blatt hat keine Unter).
        focus_weights: (trump: 50, null: 200),
    ),
    // Neue Charaktere vom 03.11.2026 (DESIGN 9.4 bis 9.6), entschieden vom
    // Nutzer; sie ersetzen Grandspieler, Zaungast und Wirtin. Gemessen am
    // 03.11.2026 (docs/balance/2026-11-03-charaktere.md): Drückeberger und
    // Bruderherz lagen mit der Kurve des Alleinspielers (targets fehlt,
    // also run.ron) im Zielbild, die Schneiderin hat eigene Zielwerte. Seit
    // Runde 1 nach ADR 0019 (04.11.2026) hat auch Bruderherz eigene. Die
    // Tresen-Gewichte wie beim Alleinspieler (nach Augenmaß).
    (
        character: Shirker,
        name: "Der Drückeberger",
        text: "Drückt sich, wo er kann: Auf seinen vier Siebenern liegt je eine Pfandmarke (2 Groschen), auf der Schellen-Acht eine Totenmarke, auf der Rot-Acht eine Narrenmarke. Eingelöste Marken kommen nach jeder Kneipe zurück. Handspiele bekommen keine Stufe für Hand. Startet mit dem Skatpfleger.",
        // Eigene Zielwerte seit Runde 2 (04.11.2026,
        // docs/balance/2026-11-04-runde2.md): Mit der Kurve des
        // Alleinspielers erreichte er Stadtteil 2 in 39,3 % und gewann
        // 8,9 % (Stadtteil 3 hielt 52 %); Stadtteil 1 rund + 5, Stadtteil 2
        // die Kurve vor Runde 2 mit Boss 90, Stadtteil 3 + 20. Vorschlag.
        // Nachtrag Runde 4 (05.11.2026): Stadtteil 3 + 10, Boss 140 → 155;
        // mit der Spelunke ab fünf Relikten gewann er 6,4 % (3 × 300).
        // Runde 5 (05.11.2026, acht Relikt-Plätze): mit Stadtteil 3 = 205 /
        // 225 / 245 / 260 / Boss 155 38,7 / 15,6 / 1,2 % (Stadtteil 3 hielt
        // 8 %); seine Groschen aus Pfandmarken kaufen keine Relikte mehr
        // über acht. Stadtteil 3 − 75: 38,7 / 15,8 / 3,6 %.
        targets: Some([
            [20, 35, 55, 60, 100],
            [70, 80, 90, 100, 105],
            [130, 145, 160, 175, 125],
        ]),
        start_relics: ["skat_keeper"],
        deck: (
            mods: [
                ("C7", "voucher_coins", 2),
                ("S7", "voucher_coins", 2),
                ("H7", "voucher_coins", 2),
                ("D7", "voucher_coins", 2),
                ("D8", "voucher_undead", 1),
                ("H8", "voucher_wild", 1),
            ],
        ),
        // Marken, die in einer Kneipe gedrückt wurden, liegen nach ihrem
        // Ende (gewonnen oder verloren) wieder auf ihrer Karte, solange die
        // Karte keine andere normale Modifikation und keinen Fluch trägt.
        // Hand +1 fällt weg: −1 bei jedem Handspiel (auch Null Hand), wie
        // ein Relikt auf gewonnene und verlorene Spiele.
        rule: (
            vouchers_return: true,
            hooks: [
                OnDeclare(when: All([HandGame, Not(RamschGame)]), then: [AddLevels(-1)]),
            ],
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        focus_weights: (trump: 100, null: 50),
        back: Some("shirker"),
    ),
    (
        character: Tailoress,
        name: "Die Schneiderin",
        text: "Nimmt Maß: Ihre vier Zehner tragen einen Aufdruck (+3 Augen). Gewinnt sie Schneider oder Schwarz, zählt beides je +2 statt +1 Stufe; ein gewonnenes Spiel ohne Schneider zählt 1 Stufe weniger (nie unter 1, Null ausgenommen). Startet mit Stichfest.",
        // Eigene Zielwerte, gemessen am 03.11.2026: rund die Kurve des
        // Alleinspielers × 1,15 (Boss in Stadtteil 1 × 1,25). Mit dessen
        // Kurve erreichte sie Stadtteil 2 in 47 % und gewann 7,9 % der Runs:
        // Sie gewinnt die Hälfte ihrer Farbspiele und Grands mit Schneider
        // (Alleinspieler 39 %) und zählt sie doppelt.
        // Runde 1 nach ADR 0019 (04.11.2026): mit der Kurve oben ohne Leben
        // Stadtteil 2 in 22,4 %, gewonnen 1,3 % (Alleinspieler 29,0 / 1,9 %);
        // die Boss-Kneipe in Stadtteil 1 gewann sie nur zu 57 %. Jetzt in
        // Stadtteil 1 die neue Kurve des Alleinspielers, danach rund × 1,1.
        // Runde 2 (04.11.2026, docs/balance/2026-11-04-runde2.md): damit
        // 36,7 / 12,3 / 5,4 %; Stadtteil 1 wie der Alleinspieler, Stadtteil
        // 2 − 10 (Boss + 5), Stadtteil 3 + 10: gemessen 38,3 / 14,7 / 4,8 %.
        // Runde 5 (05.11.2026, acht Relikt-Plätze): mit 25 / 40 / … · 180 /
        // 200 / 225 / 240 / Boss 155 36,8 / 15,4 / 1,1 % (Stadtteil 3 hielt
        // 7 %, der Alte 33 %), 21,6 % in den ersten beiden Kneipen. 1-1 und
        // 1-2 − 5, Stadtteil 3 − 45 bis − 60: 36,9 / 16,0 / 3,4 %, 19,6 %.
        // Runde 6 (07.11.2026, docs/balance/2026-11-07-runde6.md): nach den
        // neuen Verteidigern (#108) und Relikten v4 34,7 / 15,2 / 4,4 %. 1-3
        // und 1-4 − 5, Boss 110 → 100: 37,3 / 14,7 / 3,7 % (5 × 300 Runs;
        // mit Stadtteil 2 zusätzlich + 5 nur 37,1 / 14,3 / 3,7 %, verworfen).
        targets: Some([
            [20, 35, 60, 65, 100],
            [60, 75, 85, 95, 105],
            [135, 150, 165, 180, 120],
        ]),
        start_relics: ["watertight"],
        deck: (
            mods: [
                ("CT", "points", 3),
                ("ST", "points", 3),
                ("HT", "points", 3),
                ("DT", "points", 3),
            ],
        ),
        // Nur gewonnene Farbspiele und Grands: Ein Null kennt keinen
        // Schneider, ein verlorenes Spiel bleibt, wie es ist.
        rule: (
            hooks: [
                OnScore(when: All([WonSchneider, Not(NullGame), Not(RamschGame)]), then: [AddLevels(1)]),
                OnScore(when: All([Won, AllTricksWon, Not(NullGame), Not(RamschGame)]), then: [AddLevels(1)]),
                OnScore(when: All([Won, Not(WonSchneider), Not(NullGame), Not(RamschGame)]), then: [AddLevels(-1)]),
            ],
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        focus_weights: (trump: 100, null: 50),
        back: Some("tailoress"),
    ),
    (
        character: HeartBrother,
        name: "Bruderherz",
        text: "Sein Herz schlägt für Rot: Daus, Zehn, König und Oberin in Rot tragen ein Siegel (+2), Neun, Acht und Sieben einen Winkel (+1). Daus und Zehn der anderen Farben sind fleckig (als Trumpf Grundwert −2), ihre Könige ramponiert (−2 Augen); seine Flüche lassen sich nicht reinigen. Zinken auf Rot kosten ihn die Hälfte. Startet mit der Stammfarbe.",
        start_relics: ["home_suit"],
        // Eigene Zielwerte seit Runde 1 nach ADR 0019 (04.11.2026): Mit der
        // Kurve des Alleinspielers ohne Leben Stadtteil 2 in 20,9 %, gewonnen
        // 1,8 % (Alleinspieler 29,0 / 1,9 %), die erste Kneipe nur 75,8 %
        // (Alleinspieler 81,7 %). Jetzt rund die neue Kurve × 0,9.
        // Runde 2 (04.11.2026, docs/balance/2026-11-04-runde2.md): damit
        // 30,1 / 9,9 / 4,7 %, die ersten beiden Kneipen beendeten 35 % der
        // Runs. Stadtteil 1 − 5 (Boss + 10), Stadtteil 2 − 10 (Boss + 5),
        // Stadtteil 3 + 10: gemessen 34,2 / 13,5 / 6,5 %. Danach Stadtteil
        // 3 noch einmal + 15 (Vorschlag, ungemessen).
        // Runde 5 (05.11.2026, acht Relikt-Plätze): mit 40 / 50 / 55 / 65 /
        // Boss 80 · 140 / 155 / 175 / 185 / Boss 130 38,8 / 18,3 / 0,9 %
        // (Stadtteil 2 hielt 47 %, Stadtteil 3 5 %, der Alte 22 %). Stadtteil
        // 2 + 5 (Boss 90), Stadtteil 3 − 30 bis − 40: 38,8 / 17,2 / 3,1 %.
        // Runde 6 (07.11.2026, docs/balance/2026-11-07-runde6.md): nach den
        // neuen Verteidigern (#108) und Relikten v4 39,2 / 14,0 / 2,3 %
        // (Stadtteil 3 hielt 17 %). Stadtteil 2 − 5 je normaler Kneipe,
        // Stadtteil 3 − 15 (Boss 105 → 100): 40,5 / 15,7 / 3,9 % (5 × 300
        // Runs; Stadtteil 1 unverändert, auf den Seeds 42 bis 44 39,2 %).
        targets: Some([
            [10, 20, 35, 40, 75],
            [40, 50, 55, 65, 90],
            [95, 105, 120, 130, 100],
        ]),
        // Rot ist seine Farbe: stark, wenn Rot Trumpf ist. In jeder anderen
        // Farbe kosten Daus und Zehn Grundwert, wenn sie Trumpf ist; die
        // Könige kosten immer Augen. Unter unverändert. "Beim Erhalt"
        // feuert nicht (keine Groschen für die Flüche).
        deck: (
            mods: [
                ("HA", "trump_bonus", 2),
                ("HT", "trump_bonus", 2),
                ("HK", "trump_bonus", 2),
                ("HQ", "trump_bonus", 2),
                ("H9", "rank", 1),
                ("H8", "rank", 1),
                ("H7", "rank", 1),
                ("CA", "stained", 2),
                ("CT", "stained", 2),
                ("SA", "stained", 2),
                ("ST", "stained", 2),
                ("DA", "stained", 2),
                ("DT", "stained", 2),
                ("CK", "battered", 2),
                ("SK", "battered", 2),
                ("DK", "battered", 2),
            ],
        ),
        // Flüche seiner Ausgabe (auch spätere) lassen sich weder mit dem
        // Frischen Deck noch in der Werkstatt reinigen. Zinken auf Rot (eine
        // Modifikation für Groschen auf einer Karte seiner Wahl) kosten die
        // Hälfte, gerundet, mindestens 1.
        rule: (
            keep_curses: true,
            zinken_discount: Some((cards: (suit: Some(Hearts)), percent: 50)),
        ),
        null_scoring: Some(Formula((
            base_value: 23,
            per_seven_ducked: 1,
            never_followed: 2,
            short_circuit: 3,
            short_circuit_tricks: 5,
            short_circuit_points: 61,
        ))),
        focus_weights: (trump: 100, null: 50),
        back: Some("heart_brother"),
    ),
]
