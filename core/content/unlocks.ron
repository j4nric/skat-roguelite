// Freischaltungen (DESIGN 9.3): eine Tat am Tisch und was sie freischaltet.
// Jedes Relikt und jeder Charakter, der hier als Belohnung steht, ist bis
// dahin gesperrt; der Tresen bietet nur Freigeschaltetes an. Der Simulator
// prüft die Erreichbarkeit mit `--unlocks`.
//
// Gegenstands-Review (02.11.2026): Neun Belohnungen zeigten auf entfernte
// Relikte und zeigen jetzt auf behaltene oder neue (DESIGN 9.3): Aus der
// Hand → Spickzettel, Dickes Ding → Stammtischkasse, Grand Schneider →
// Stichfest, Ohne Einmischen → Schutzengel, Omas Liebling → Deckel
// anschreiben, Neues Viertel → Monatskarte, Lehrjahre → Spelunkenkenner,
// Den Peter los → Luschenkönig, Trocken gekontert → Stammfarbe. Wer eine
// davon schon verdient hat, hat das neue Relikt frei.
//
// Relikte v4 (07.11.2026): sieben der neuen Relikte kommen als zweite
// Belohnung zu passenden Taten (Grand Schneider → Großkopferten, Grand Hand
// → Offenes Visier, Voll gedrückt → Doppelt gemoppelt, Maßarbeit → Elle,
// Farbe bekennen → Fanblock, Stammkunde → Unterschlupf, Glückspilz →
// Sieben auf einen Streich), damit ein Drittel der Relikte gesperrt bleibt.
[
    (
        id: "second_evening",
        // Kneipentour (ADR 0016): bis 02.11.2026 „Erreiche Abschnitt 2“.
        // Die Ids bleiben, damit verdiente Freischaltungen gelten.
        name: "Kneipenbummel",
        text: "Erreiche die dritte Kneipe des Abends.",
        condition: ReachPub(3),
        rewards: [Relic("landlord")],
    ),
    (
        id: "third_evening",
        // Bis 02.11.2026 „Erreiche Abschnitt 3“.
        name: "Vor dem Boss",
        text: "Erreiche die Boss-Kneipe im ersten Stadtteil.",
        condition: ReachPub(5),
        rewards: [Relic("tour")],
    ),
    (
        id: "hand_won",
        name: "Aus der Hand",
        text: "Gewinne ein Handspiel.",
        condition: WinGame(min_risk: Some(Hand)),
        rewards: [Relic("crib_sheet")],
    ),
    (
        id: "big_game",
        name: "Dickes Ding",
        text: "Gewinne ein Spiel, das mindestens 96 Punkte zählt.",
        condition: WinGame(min_value: 96),
        rewards: [Relic("kitty")],
    ),
    (
        id: "grand_schneider",
        name: "Grand Schneider",
        text: "Gewinne einen Grand Schneider.",
        condition: WinGame(game: Some(Grand), schneider: true),
        rewards: [Relic("watertight"), Relic("big_shots")],
    ),
    (
        id: "early_finish",
        name: "Früher Feierabend",
        // Seit den Serien mit drei Spielen (01.11.2026): gleich im ersten
        // Spiel, vorher drei von acht Spielen übrig. Seit ADR 0016 eine
        // Kneipe statt einer Serie.
        text: "Gewinne eine Kneipe gleich im ersten Spiel.",
        condition: WinSeriesWithGamesLeft(2),
        rewards: [Relic("virgin")],
    ),
    (
        id: "boss_without_pass",
        name: "Ohne Einmischen",
        text: "Schlage einen Boss, ohne in seiner Kneipe einzumischen.",
        condition: BeatBoss(without_redeal: true),
        rewards: [Relic("guardian_angel")],
    ),
    (
        id: "beat_grandma",
        name: "Omas Liebling",
        text: "Schlage den Boss Die Oma.",
        condition: BeatBoss(boss: Some("grandma")),
        rewards: [Relic("slate")],
    ),
    (
        id: "tour_won",
        name: "Die Tournee gewonnen",
        text: "Gewinne einen ganzen Abend mit dem Alleinspieler.",
        // Only the ganzer Abend counts: a short one is much easier to win.
        condition: WinRun(character: Some(Declarer), length: Full),
        rewards: [Character(NullPlayer)],
    ),
    // M4: seven of the fourteen new house rules and figures.
    (
        id: "fourth_evening",
        // Bis 02.11.2026 „Erreiche Abschnitt 4“.
        name: "Neues Viertel",
        text: "Erreiche Stadtteil 2.",
        condition: ReachSection(2),
        rewards: [Relic("season_ticket")],
    ),
    (
        id: "apprenticeship",
        name: "Lehrjahre",
        text: "Spiele fünf Runs zu Ende, gewonnen oder verloren.",
        condition: RunsFinished(5),
        rewards: [Relic("dive_expert")],
    ),
    (
        id: "big_win",
        name: "Glückspilz",
        text: "Gewinne ein Spiel, das mindestens 144 Punkte zählt.",
        condition: WinGame(min_value: 144),
        rewards: [Relic("lucky_streak"), Relic("seven_at_one_blow")],
    ),
    (
        id: "beat_black_peter",
        name: "Den Peter los",
        text: "Schlage den Boss Der Schwarze Peter.",
        condition: BeatBoss(boss: Some("black_peter")),
        rewards: [Relic("blank_king")],
    ),
    (
        // Bis ADR 0017 „Trocken gekontert“ gegen den Kontra-Hans; die Id
        // bleibt, damit verdiente Stände die Stammfarbe behalten.
        id: "beat_kontra_hans",
        name: "Doppelt gesehen",
        text: "Schlage den Boss Die Zwillinge.",
        condition: BeatBoss(boss: Some("twins")),
        rewards: [Relic("home_suit")],
    ),
    (
        id: "grand_hand",
        name: "Grand Hand",
        text: "Gewinne einen Grand Hand.",
        condition: WinGame(game: Some(Grand), min_risk: Some(Hand)),
        rewards: [Relic("beer_mat"), Relic("open_visor")],
    ),
    (
        id: "hearts_schneider",
        name: "Maß genommen",
        text: "Gewinne ein Spiel in Rot mit Schneider.",
        condition: WinGame(game: Some(Suit(Hearts)), schneider: true),
        rewards: [Relic("tailor")],
    ),
    // Neue Charaktere vom 03.11.2026 (DESIGN 9.3), Bedingungen vom Nutzer.
    // Sie ersetzen grand_master (Grandspieler), beat_kibitz_killer
    // (Zaungast) und full_till (Wirtin); wer diese Ids schon verdient hat,
    // behält sie, sie schalten nichts mehr frei.
    (
        id: "full_skat",
        name: "Voll gedrückt",
        // Die Augen der zwei gedrückten Karten, wie sie im Spiel zählen
        // (mit Aufdruck, Ramponiert und Skatpfleger): etwa Daus und Zehn.
        text: "Gewinne ein Spiel mit mindestens 21 gedrückten Augen.",
        condition: WinGame(min_discarded: 21),
        rewards: [Character(Shirker), Relic("rebate_book"), Relic("double_stamp")],
    ),
    (
        id: "three_schneider",
        name: "Maßarbeit",
        text: "Gewinne drei Spiele mit Schneider in einer Kneipe.",
        condition: SchneiderWinsInPub(3),
        rewards: [Character(Tailoress), Relic("golden_shears"), Relic("yardstick")],
    ),
    (
        id: "true_colours",
        name: "Farbe bekennen",
        // Über Kneipen hinweg im selben Run; ein verlorenes Spiel, ein
        // Grand, ein Null oder eine andere Trumpffarbe dazwischen fängt
        // neu an. Ein Ramsch zählt nicht und unterbricht nicht.
        text: "Gewinne drei Farbspiele hintereinander mit derselben Trumpffarbe.",
        condition: SameTrumpStreak(3),
        rewards: [Character(HeartBrother), Relic("club_colours"), Relic("fan_block")],
    ),
    // Bau-Richtungen (04.11.2026): Voll gedrückt, Maßarbeit und Farbe
    // bekennen schalten dazu je ein Verbinder-Relikt ihrer Richtung frei
    // (Rabattheft, Goldene Schere, Vereinsfarben), damit ein Drittel der
    // Relikte gesperrt bleibt (DESIGN 9.3).
    // Welle 2b (02.11.2026): "Drei drücken" biegt eine Regel und ist
    // selten und teuer; wer es am Tresen sehen will, hat ein paar Abende
    // hinter sich.
    (
        id: "ten_runs",
        name: "Stammkunde",
        text: "Spiele zehn Runs zu Ende, gewonnen oder verloren.",
        condition: RunsFinished(10),
        rewards: [Relic("three_discard"), Relic("safe_haven")],
    ),
    // Die lange Nacht (ADR 0020, Entscheidung des Nutzers vom 05.11.2026,
    // Cockpit q33 A): Meilensteine der Nacht. Rückseiten sind Kosmetik
    // (night.ron); Kehraus und Morgengrauen gibt es danach auch im normalen
    // Run. Stadtteil 4 und höher gibt es nur in der Nacht.
    (
        id: "night_district_5",
        name: "Tief in der Nacht",
        text: "Erreiche in der langen Nacht Stadtteil 5.",
        condition: ReachSection(5),
        rewards: [CardBack("moon")],
    ),
    (
        id: "night_district_7",
        name: "Nach der Sperrstunde",
        text: "Erreiche in der langen Nacht Stadtteil 7.",
        condition: ReachSection(7),
        rewards: [CardBack("stars"), Relic("sweep_out")],
    ),
    (
        id: "night_district_10",
        name: "Bis zum Morgengrauen",
        text: "Erreiche in der langen Nacht Stadtteil 10.",
        condition: ReachSection(10),
        rewards: [CardBack("lantern"), Relic("dawn")],
    ),
]
