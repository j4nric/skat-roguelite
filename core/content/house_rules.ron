// Hausregeln und Stammtisch-Figuren (passive Relikte). Effekte über die
// Hook-API, siehe core/src/content/effects.rs. Preise 4 bis 9 nach der
// M5-Messung (docs/balance/2026-11-01-m5-v1.md, PIMC-Spieler, Relikt ab
// Spielbeginn ohne Tresen): Wirkung auf „Abschnitt 3 erreicht“ ab +6,5
// Prozentpunkten 9, ab +4,5 8, ab +3 7, ab +1,5 6, darunter 5; Relikte,
// die vor allem Menschen nutzen (Hand, Ouvert, Information) oder nur gegen
// einzelne Bosse wirken, 4 bis 6. Hausregeln und Figuren folgen derselben
// Staffel.
//
// Seltenheit folgt der Stärke (M5): Die drei stärksten Relikte des
// Alleinspielers (Bockrunde, Alte Dame, Kleinvieh) und das stärkste des
// Nullspielers (Siebenschläfer) sind Uncommon, die schwächsten bisherigen
// Uncommon (Spitze, Mit Vieren, Schiedsrichter, Saubere Weste) dafür
// Common. Vorher lagen die stärksten Relikte alle in der häufigsten Stufe.
//
// focus: für welche Spielart das Relikt gemacht ist (All, Trump für
// Farbspiel und Grand, Null). Seit ADR 0012 liegt jedes Relikt bei jedem
// Charakter am Tresen; wie oft, sagen die focus_weights in characters.ron.
// Was ein Relikt tut, steht in seinen Effekten und Bedingungen; Relikte für
// Farbspiel und Grand, die im Null etwas Unsinniges täten, schließen Null
// aus (Not(NullGame)).
// characters: für welche Charaktere das Relikt am Tresen liegt (leer: alle).
// tags: Bau-Richtungen (seit 04.11.2026, Cockpit q26): OneSuit
// (Farbtreue), Vouchers (Markenhändler), Tricks (Stichjäger), Schneider,
// Null (Nullspieler). Die Verbinder-Relikte am Ende zählen Teile ihrer
// Richtung; Angebote dürfen nach Tags gewichten.
// group: Anzeige-Gruppe für die Form des Bierdeckels (Value: Wert,
// Multiplier: Stufen, Control: Kontrolle, Tour: Groschen, Tresen
// und Wege, Factor: Faktor; ohne Angabe Value). Nur Anzeige.
// Gesperrte Relikte stehen als Belohnung in unlocks.ron.
[
    (
        id: "last_trick_seven",
        tags: [Tricks],
        group: Multiplier,
        focus: Trump,
        name: "Spitze",
        text: "Machst du den letzten Stich mit einer Sieben: +1 Stufe.",
        rarity: Common,
        price: 4,
        hooks: [
            // Im Null wäre der Stich des Alleinspielers schon verloren.
            OnScore(when: All([LastTrickWinnerMatches(filter: (rank: Some(Seven)), by_declarer: true), Not(NullGame)]), then: [AddLevels(1)]),
        ],
    ),
    (
        id: "concede",
        tags: [Schneider],
        group: Multiplier,
        focus: Trump,
        name: "Schenken",
        text: "Haben die Gegner nach fünf Stichen unter 15 Augen, geben sie auf. Der Rest gehört dir, das Spiel ist mindestens Schneider. Nicht beim Null.",
        rarity: Uncommon,
        price: 6,
        hooks: [
            // Im Null hieße Aufgeben, dass der Alleinspieler die übrigen
            // Stiche bekommt und verliert.
            OnTrickEnd(when: All([TricksPlayed(5), DefenderPointsBelow(15), Not(NullGame)]), then: [Concede]),
        ],
    ),
    (
        id: "skat_redraw",
        group: Control,
        name: "Schieben",
        text: "In jedem Spiel darfst du einmal mehr einmischen.",
        rarity: Common,
        price: 6,
        // DESIGN 8.1: neu geben statt Skat neu ziehen, Begründung dort.
        // Seit dem Einmischen (01.11.2026) ein Einmischen mehr pro Spiel.
        passive: [ExtraRedeal],
    ),
    (
        id: "virgin",
        tags: [Schneider],
        group: Multiplier,
        focus: Trump,
        name: "Jungfrau",
        text: "Gewinnst du mit 61 bis 70 Augen, zählt das Spiel trotzdem als Schneider.",
        rarity: Uncommon,
        price: 7,
        passive: [SchneiderFromDeclarerPoints(min: 61, max: 70)],
    ),
    (
        id: "old_lady",
        group: Value,
        focus: Trump,
        name: "Alte Oberin",
        text: "Deine Oberinnen zählen 5 Augen.",
        rarity: Uncommon,
        price: 9,
        passive: [SetCardPoints(filter: (rank: Some(Queen)), points: 5)],
    ),
    (
        id: "tour",
        group: Value,
        name: "Tournee",
        text: "Jede Kneipe, die du mit Spielen übrig gewinnst, gibt +1 Grundwert für den Rest des Runs.",
        rarity: Rare,
        price: 7,
        passive: [AddBaseValueFromCounter("tour")],
        hooks: [
            OnSeriesWon(when: GamesLeftAtLeast(1), then: [IncrementCounter("tour")]),
        ],
    ),
    // Stammtisch-Figuren (DESIGN 8.2).
    (
        id: "kibitzer",
        group: Control,
        kind: Regular,
        name: "Der Kiebitz",
        text: "Schaut den Gegnern über die Schulter: Vor der Ansage zeigt er dir eine zufällige Karte eines Gegners und wer sie hält.",
        rarity: Uncommon,
        price: 5,
        passive: [PeekDefenderCards(1)],
    ),
    (
        id: "landlord",
        group: Tour,
        kind: Regular,
        name: "Der Wirt",
        text: "Alles am Tresen ist 20 % billiger, auch Neuauslage, Zinken, Neu auslosen, Kartenmaler und Karte reinigen.",
        rarity: Uncommon,
        price: 7,
        passive: [ShopDiscount(20)],
    ),
    (
        id: "card_counter",
        group: Control,
        kind: Regular,
        name: "Der Zähler",
        text: "Zählt mit: Er zeigt dir laufend die Augen beider Seiten und wie viele Augen du noch nicht gesehen hast.",
        rarity: Common,
        price: 4,
        passive: [ShowCount],
    ),
    // ---------------------------------------------------------------------
    // M4: 14 more house rules and figures. Each turns one lever of the
    // formula (Designsäule 1), named in the comment. Prices are placeholders
    // for `balance`. Texts speak of the German deck (Unter, Oberin, Daus).
    // ---------------------------------------------------------------------
    // Since 04.11.2026 (decided by the user) the Augen relics change only
    // the player's own cards (his edition, ADR 0015), wherever they end up.
    // Lever Augen: every seven and eight counts 1 Auge, +8 Augen in the
    // deck (as much as the Alte Dame; with the nines too, +12 Augen, it
    // measured twice as strong). Like the Alte Dame it helps the declarer
    // net, because the win threshold stays at 61. For the Nullspieler the
    // Augen of his ducked sevens go to the defenders and make a Kurzschluss
    // likelier.
    (
        id: "every_bit_counts",
        group: Value,
        name: "Kleinvieh",
        text: "Kleinvieh macht auch Mist: Deine Sieben und Achten zählen je 1 Auge.",
        rarity: Uncommon,
        price: 9,
        passive: [
            SetCardPoints(filter: (rank: Some(Seven)), points: 1),
            SetCardPoints(filter: (rank: Some(Eight)), points: 1),
        ],
    ),
    // Lever Gewinnschwelle: 58 instead of 61.
    (
        id: "blind_eye",
        group: Multiplier,
        focus: Trump,
        name: "Ein Auge zudrücken",
        text: "Der Wirt drückt ein Auge zu: Du gewinnst schon mit 3 Augen weniger (58 statt 61).",
        rarity: Common,
        price: 7,
        passive: [WinThreshold(58)],
    ),
    // Lever Zählen (information): je eine Karte jedes Gegners ist für ein
    // Spiel durchsichtig. 04.11.2026 auf Wunsch des Nutzers; Seltenheit und
    // Preis vorläufig nach Augenmaß (wie der Kiebitz, der nur eine Karte vor
    // der Ansage zeigt), `balance` setzt sie, sobald gemessen wird.
    (
        id: "glass_eye",
        group: Control,
        name: "Glasauge",
        text: "Zu Beginn jedes Spiels wird je eine zufällige Karte jedes Gegners durchsichtig: Du siehst sie, bis sie gespielt ist. Nur für dieses Spiel.",
        rarity: Uncommon,
        price: 6,
        passive: [RevealDefenderCards(1)],
    ),
    // Lever Grundwert (counter, grows over the run): +1 per won hand game.
    (
        id: "beer_mat",
        group: Value,
        name: "Bierdeckel",
        text: "Jedes gewonnene Handspiel gibt einen Strich auf den Bierdeckel: +1 Grundwert für den Rest des Runs.",
        rarity: Uncommon,
        price: 5,
        passive: [AddBaseValueFromCounter("beer_mat")],
        hooks: [
            OnScore(when: All([Won, HandGame, Not(RamschGame)]), then: [IncrementCounter("beer_mat")]),
        ],
    ),
    // Lever Spielwert ×2 (multiplicative): from the third won game in a
    // row, every won game counts double until a game is lost. Einmischen
    // does not break the streak. Hook order matters: the doubling looks at the
    // flags of the games before.
    (
        id: "lucky_streak",
        group: Multiplier,
        name: "Glückssträhne",
        text: "Ab dem dritten gewonnenen Spiel in Folge zählt jedes gewonnene Spiel doppelt. Ein verlorenes beendet die Strähne.",
        rarity: Rare,
        price: 7,
        hooks: [
            OnScore(when: All([Won, Flag("streak")]), then: [MultiplyGameValue(2)]),
            OnScore(when: All([Won, Flag("streak_start")]), then: [SetFlag("streak")]),
            OnScore(when: Won, then: [SetFlag("streak_start")]),
            OnScore(when: Lost, then: [ClearFlag("streak_start"), ClearFlag("streak")]),
        ],
    ),
    // Figure. Lever Schneider: a won game with 80 to 89 Augen is Schneider.
    (
        id: "tailor",
        tags: [Schneider],
        group: Multiplier,
        focus: Trump,
        kind: Regular,
        name: "Der Schneider",
        text: "Der Schneider vom Nebentisch nimmt großzügig Maß: Gewinnst du mit 80 bis 89 Augen, sind die Gegner trotzdem Schneider.",
        rarity: Uncommon,
        price: 7,
        passive: [SchneiderFromDeclarerPoints(min: 80, max: 89)],
    ),
    // Made for Null from here (before ADR 0012 only for the Nullspieler).
    // Lever Grundwert: +8 on every Null, won or lost.
    (
        id: "null_eight_fifteen",
        tags: [Null],
        group: Value,
        focus: Null,
        name: "Nullachtfuffzehn",
        text: "Ein ganz gewöhnliches Null: Grundwert +8, gewonnen wie verloren.",
        rarity: Common,
        price: 6,
        hooks: [
            OnDeclare(when: NullGame, then: [AddBaseValue(8)]),
        ],
    ),
    // Lever Augen (for the Null formula: Kurzschluss, defenders with 61
    // Augen after five tricks): every Daus counts 16.
    (
        id: "fat_sow",
        tags: [Null],
        group: Value,
        focus: Null,
        name: "Dicke Sau",
        text: "Deine Daus zählen 16 Augen, in jedem Spiel. Wirfst du sie beim Null ab, kommen die Gegner schneller in den Kurzschluss.",
        rarity: Common,
        price: 6,
        passive: [SetCardPoints(filter: (rank: Some(Ace)), points: 16)],
    ),
    // Lever Gewinnstufen (Spitzen): mit or ohne 4 and more, one level more.
    (
        id: "with_four",
        group: Multiplier,
        focus: Trump,
        name: "Mit Vieren",
        text: "Spielst du mit oder ohne 4 Spitzen oder mehr: +1 Stufe.",
        rarity: Common,
        price: 4,
        hooks: [
            OnScore(
                when: Any([
                    MatadorsAtLeast(with: true, count: 4),
                    MatadorsAtLeast(with: false, count: 4),
                ]),
                then: [AddLevels(1)],
            ),
        ],
    ),
    // ---------------------------------------------------------------------
    // M8 Welle 3, abgestimmt im Cockpit: Stufe Legendär. Am Tresen weit
    // seltener als Rare (Gewicht `legendary` in run.ron, Standard 0,3 statt
    // 1). Preise nach der gemessenen Wirkung (Staffel aus Welle 2a), nicht
    // nach der Stufe; Platzhalter für `balance`
    // (docs/balance/2026-11-02-welle3.md, DESIGN 8.4 und 12).
    // ---------------------------------------------------------------------
    // Lever Gewinnstufen (run counter): every won Schneider game raises the
    // counter; from the next game on every won game (Farbspiel, Grand and
    // Null, not the Ramsch) gets one level per point, on score. The level
    // hook comes first, so a Schneider game does not count its own point.
    // Since 03.11.2026 the counter stops at 3, so at most +3 in total
    // (docs/balance/2026-11-03-kleine-runde.md: it dominated every relic).
    (
        id: "skat_god",
        tags: [Schneider],
        group: Multiplier,
        focus: Trump,
        name: "Skatgott",
        text: "Jedes gewonnene Spiel mit Schneider: bis zum Run-Ende +1 Stufe auf jedes gewonnene Spiel, höchstens +3.",
        rarity: Legendary,
        price: 12,
        hooks: [
            OnScore(when: All([Won, Not(RamschGame)]), then: [AddLevelsPerCounter(counter: "skat_god", per: 1)]),
            OnScore(when: All([WonSchneider, Not(CounterAtLeast(counter: "skat_god", value: 3))]), then: [IncrementCounter("skat_god")]),
        ],
    ),
    // Lever Stichgewinn (Vorhand): the player leads the first trick of
    // every game; the rotation of the Gäste runs on behind him.
    (
        id: "honorary_chair",
        group: Control,
        name: "Ehrenvorsitz",
        text: "Du bist immer Vorhand.",
        rarity: Legendary,
        price: 6,
        passive: [AlwaysForehand],
    ),
    // ---------------------------------------------------------------------
    // M8 Welle 2a, abgestimmt im Cockpit (02.11.2026): Skat-Hebel,
    // Bau-Richtungen, Spiel-Relikte. Texte wie abgestimmt. Seltenheit und
    // Preise nach der Einzelmessung (docs/balance/2026-11-02-relikte-
    // welle2.md), Platzhalter für `balance`. "Spielart" heißt hier wie in
    // der Skatordnung Farbspiel, Grand oder Null; der Ramsch des Ramschers
    // zählt nie mit und unterbricht nichts. "Das Spiel davor" und "drei-
    // mal hintereinander" gehen über Seriengrenzen (DESIGN 8.1).
    // ---------------------------------------------------------------------
    // Lever Augen: after the discard the two skat cards count twice for
    // the declarer, for winning and Schneider (one Augen line). A hand
    // game discards nothing.
    (
        id: "skat_keeper",
        tags: [Vouchers],
        group: Value,
        name: "Skatpfleger",
        text: "Die Augen der gedrückten Karten zählen doppelt.",
        rarity: Uncommon,
        price: 7,
        hooks: [
            OnDeclare(when: Not(HandGame), then: [MultiplySkatPoints(2)]),
        ],
    ),
    // Lever Grundwert (counter of one series): +3 per Spielart (Farbspiel,
    // Grand, Null) declared in the series so far, this game included:
    // +3 for the first game, up to +9 for the third.
    (
        id: "all_rounder",
        group: Value,
        name: "Allrounder",
        text: "Je verschiedener Spielart in einer Kneipe +3 Grundwert.",
        rarity: Uncommon,
        price: 8,
        hooks: [
            OnDeclare(when: All([SuitGame, Not(Flag("all_rounder_suit"))]), then: [SetFlag("all_rounder_suit"), IncrementCounter("all_rounder")]),
            OnDeclare(when: All([GameIs(Grand), Not(Flag("all_rounder_grand"))]), then: [SetFlag("all_rounder_grand"), IncrementCounter("all_rounder")]),
            OnDeclare(when: All([NullGame, Not(Flag("all_rounder_null"))]), then: [SetFlag("all_rounder_null"), IncrementCounter("all_rounder")]),
            OnDeclare(when: Not(RamschGame), then: [AddBaseValuePerCounter(counter: "all_rounder", per: 3)]),
            OnSeriesWon(then: [ClearFlag("all_rounder_suit"), ClearFlag("all_rounder_grand"), ClearFlag("all_rounder_null"), ResetCounter("all_rounder")]),
        ],
    ),
    // Lever Spielwert ×1,5 (multiplicative): from the third suit game in a
    // row with the same trump suit, each further one too, won or lost. The
    // streak goes over series boundaries; a grand, a Null or another trump
    // suit starts over. The flag holds the suit, the counter the streak.
    (
        id: "home_suit",
        tags: [OneSuit],
        group: Multiplier,
        focus: Trump,
        name: "Stammfarbe",
        text: "Dreimal hintereinander dieselbe Trumpffarbe: ×1,5.",
        rarity: Rare,
        price: 6,
        hooks: [
            OnDeclare(when: All([GameIs(Suit(Clubs)), Not(Flag("home_suit_clubs"))]), then: [ClearFlag("home_suit_spades"), ClearFlag("home_suit_hearts"), ClearFlag("home_suit_diamonds"), SetFlag("home_suit_clubs"), ResetCounter("home_suit")]),
            OnDeclare(when: All([GameIs(Suit(Spades)), Not(Flag("home_suit_spades"))]), then: [ClearFlag("home_suit_clubs"), ClearFlag("home_suit_hearts"), ClearFlag("home_suit_diamonds"), SetFlag("home_suit_spades"), ResetCounter("home_suit")]),
            OnDeclare(when: All([GameIs(Suit(Hearts)), Not(Flag("home_suit_hearts"))]), then: [ClearFlag("home_suit_clubs"), ClearFlag("home_suit_spades"), ClearFlag("home_suit_diamonds"), SetFlag("home_suit_hearts"), ResetCounter("home_suit")]),
            OnDeclare(when: All([GameIs(Suit(Diamonds)), Not(Flag("home_suit_diamonds"))]), then: [ClearFlag("home_suit_clubs"), ClearFlag("home_suit_spades"), ClearFlag("home_suit_hearts"), SetFlag("home_suit_diamonds"), ResetCounter("home_suit")]),
            OnDeclare(when: SuitGame, then: [IncrementCounter("home_suit")]),
            OnDeclare(when: Any([GameIs(Grand), NullGame]), then: [ClearFlag("home_suit_clubs"), ClearFlag("home_suit_spades"), ClearFlag("home_suit_hearts"), ClearFlag("home_suit_diamonds"), ResetCounter("home_suit")]),
            OnDeclare(when: All([SuitGame, CounterAtLeast(counter: "home_suit", value: 3)]), then: [ScaleGameValue(1.5)]),
        ],
    ),
    // Lever Gewinnstufen: +1 for every trick a seven of the declarer takes
    // (by the rules: a trump seven, or a seven nobody could beat). Not in
    // Null, where a trick of the declarer loses.
    (
        id: "blank_king",
        tags: [Tricks],
        group: Multiplier,
        focus: Trump,
        name: "Luschenkönig",
        text: "Gewinnt eine Sieben einen Stich: +1 Stufe.",
        rarity: Common,
        price: 5,
        hooks: [
            OnTrickEnd(when: All([TrickWinnerMatches(filter: (rank: Some(Seven)), by_declarer: true), Not(NullGame), Not(RamschGame)]), then: [AddLevels(1)]),
        ],
    ),
    // Lever Schneider: the Augen of the declarer's first trick count once
    // more for the Schneider line (defenders at most 30 plus them), never
    // for winning.
    (
        id: "watertight",
        tags: [Schneider],
        group: Multiplier,
        focus: Trump,
        name: "Stichfest",
        text: "Dein erster Stich zählt für die Schneider-Grenze doppelt.",
        rarity: Uncommon,
        price: 7,
        hooks: [
            OnTrickEnd(when: All([FirstTrickOfDeclarer, Not(NullGame), Not(RamschGame)]), then: [SchneiderBonusFromTrick]),
        ],
    ),
    // Wave 2b (M8): three relics that need new interactions.
    //
    // Lever Augen and Spitzen (bends the deal, DESIGN 8.1): picking up the
    // skat, a random card of the left defender joins it. The player holds
    // thirteen and discards three; the one with the fewest Augen goes back
    // to that defender, the other two into the skat. 32 cards cannot give
    // a three-card skat with ten cards for everyone, so the third card
    // comes from the defender and one goes back. In every game it gave
    // +18 points on "Abschnitt 3 erreicht", three times the strongest
    // other relic; since 02.11.2026 (lead decision) only at the first
    // pickup of each series: +7.9, price 9, the top of the ladder
    // (docs/balance/2026-11-02-relikte-welle2.md). Item review of
    // 02.11.2026 (user): only in the first game of each pub (a hand game
    // there lets it lapse); price unchanged, not measured.
    (
        id: "three_discard",
        tags: [Vouchers],
        group: Control,
        name: "Drei drücken",
        text: "Im ersten Spiel jeder Kneipe: Du nimmst drei Karten aus einem größeren Talon und drückst drei.",
        rarity: Rare,
        price: 9,
        passive: [DiscardThree],
    ),
    // Lever Zählen (information): after a hand declaration the untouched
    // skat is shown, since the item review of 02.11.2026 both cards (before:
    // one). Not in the Ramsch (nobody declares a hand game there). Price
    // provisional (5, before 4).
    (
        id: "crib_sheet",
        group: Control,
        name: "Spickzettel",
        text: "Beim Handspiel siehst du nach der Ansage beide Skatkarten.",
        rarity: Common,
        price: 5,
        hooks: [
            OnDeclare(when: All([HandGame, Not(RamschGame)]), then: [RevealSkatCard(2)]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Item review of 02.11.2026 (user): relics of the Kneipentour. Prices
    // and rarities VORLÄUFIG, set by judgement without measurement
    // (simulations paused), DESIGN 8.5 and 12.
    // ---------------------------------------------------------------------
    // Lever Groschen: a pub cleared in its first game (two games left).
    (
        id: "closing_time",
        group: Tour,
        name: "Feierabend",
        text: "Schaffst du eine Kneipe gleich im ersten Spiel, gibt es 4 Groschen extra.",
        rarity: Common,
        price: 4,
        hooks: [
            OnSeriesWon(when: GamesLeftAtLeast(2), then: [GainCoins(4)]),
        ],
    ),
    // Lever Groschen: the Bahn of the route choice pays.
    (
        id: "season_ticket",
        group: Tour,
        name: "Monatskarte",
        text: "Jede Fahrt mit der Bahn bringt dir 1 Groschen.",
        rarity: Common,
        price: 4,
        hooks: [
            OnRouteChosen(when: TransportIs(Train), then: [GainCoins(1)]),
        ],
    ),
    // Lever Groschen (savings): 2 of every pub reward go into the pot; the
    // next Tresen pays the pot out with half on top, rounded down.
    (
        id: "kitty",
        group: Tour,
        name: "Stammtischkasse",
        text: "Von jeder Belohnung einer Kneipe gehen 2 Groschen in die Kasse. Beim nächsten Tresen zahlt sie alles aus, mit der Hälfte obendrauf (abgerundet).",
        rarity: Uncommon,
        price: 5,
        hooks: [
            OnSeriesWon(then: [StashCoins(counter: "kitty", amount: 2)]),
            OnShopOpened(then: [PayOutCounter(counter: "kitty", percent: 150)]),
        ],
    ),
    // Lever Groschen (credit): once per Stadtteil the Tresen sells down to
    // −5 Groschen; later income pays the debt first.
    (
        id: "slate",
        group: Tour,
        kind: Regular,
        name: "Deckel anschreiben",
        text: "Einmal pro Stadtteil darfst du am Tresen anschreiben lassen, bis 5 Groschen ins Minus. Spätere Einnahmen zahlen zuerst die Schulden.",
        rarity: Uncommon,
        price: 5,
        passive: [Credit(5)],
    ),
    // Zweite Chance (ADR 0019, 04.11.2026): einmal im Run wird eine
    // verlorene Kneipe neu gespielt, auch eine Boss-Kneipe oder Spelunke;
    // danach ist der Schutzengel weg. Bis dahin: einmal pro Stadtteil kostet
    // die erste verlorene Kneipe kein Leben. Preis VORLÄUFIG (wie bisher 8).
    (
        id: "guardian_angel",
        group: Tour,
        name: "Schutzengel",
        text: "Einmal im Run: Verlierst du eine Kneipe, spielst du sie noch einmal, auch die Boss-Kneipe. Danach ist der Schutzengel weg.",
        rarity: Rare,
        price: 12,
        passive: [SecondChance],
    ),
    // Lever Spelunke: two maluses on offer, the player picks one.
    (
        id: "dive_expert",
        group: Tour,
        kind: Regular,
        name: "Spelunkenkenner",
        text: "In einer Spelunke wählst du den Malus selbst: einer von zwei.",
        rarity: Uncommon,
        price: 4,
        passive: [ChooseMalus(2)],
    ),
    // Flüche als Handel (Entscheidung des Nutzers, 03.11.2026): Lever
    // Grundwert, +1 je verfluchter Karte des Decks beim Ansagen. Zählt
    // jeden Fluch, auch Abgestuft (Nullspieler: +4 ab Start) und die
    // Flüche einer Kneipe (Die Oma, Spelunke). Bruderherz startet mit neun
    // Flüchen und hat damit sofort +9: darum Rare und Preis 9. VORLÄUFIG,
    // nach Augenmaß ohne Messung.
    (
        id: "jinx",
        group: Value,
        name: "Pechvogel",
        text: "+1 Grundwert für jede verfluchte Karte in deinem Deck.",
        rarity: Rare,
        price: 9,
        hooks: [
            OnDeclare(when: Not(RamschGame), then: [AddBaseValuePerCursedCard(1)]),
        ],
    ),
    // Faktor (ADR 0018, 04.11.2026): Relikte, die den ganzen Spielwert
    // multiplizieren. Faktoren werden multipliziert, nie addiert (zwei
    // ×1,5 ergeben ×2,25), und gelten nur für gewonnene Spiele (ADR 0018
    // Punkt 4). Je Trumpffarbe eines (Wunsch des Nutzers), eines für Grand
    // und eines für Null, dazu zwei wachsende mit Zähler. Seltenheit,
    // Preise und Faktoren VORLÄUFIG nach Augenmaß, bis die Messung sie
    // festlegt (ADR 0018 Punkt 6).
    (
        id: "jay",
        tags: [OneSuit],
        group: Factor,
        focus: Trump,
        name: "Eichelhäher",
        text: "×1,5, wenn du ein Eichel-Spiel gewinnst.",
        rarity: Rare,
        price: 5,
        hooks: [
            OnScore(when: All([Won, GameIs(Suit(Clubs))]), then: [ScaleGameValue(1.5)]),
        ],
    ),
    (
        id: "tree_frog",
        tags: [OneSuit],
        group: Factor,
        focus: Trump,
        name: "Laubfrosch",
        text: "×1,5, wenn du ein Grün-Spiel gewinnst.",
        rarity: Rare,
        price: 5,
        hooks: [
            OnScore(when: All([Won, GameIs(Suit(Spades))]), then: [ScaleGameValue(1.5)]),
        ],
    ),
    (
        id: "robin",
        tags: [OneSuit],
        group: Factor,
        focus: Trump,
        name: "Rotkehlchen",
        text: "×1,5, wenn du ein Rot-Spiel gewinnst.",
        rarity: Rare,
        price: 5,
        hooks: [
            OnScore(when: All([Won, GameIs(Suit(Hearts))]), then: [ScaleGameValue(1.5)]),
        ],
    ),
    (
        id: "bell_tree",
        tags: [OneSuit],
        group: Factor,
        focus: Trump,
        name: "Schellenbaum",
        text: "×1,5, wenn du ein Schellen-Spiel gewinnst.",
        rarity: Rare,
        price: 5,
        hooks: [
            OnScore(when: All([Won, GameIs(Suit(Diamonds))]), then: [ScaleGameValue(1.5)]),
        ],
    ),
    (
        id: "grand_seigneur",
        group: Factor,
        focus: Trump,
        kind: Regular,
        name: "Der Grandseigneur",
        text: "×2, wenn du einen Grand gewinnst.",
        rarity: Legendary,
        price: 9,
        hooks: [
            OnScore(when: All([Won, GameIs(Grand)]), then: [MultiplyGameValue(2)]),
        ],
    ),
    (
        id: "black_zero",
        tags: [Null],
        group: Factor,
        focus: Null,
        name: "Schwarze Null",
        text: "×1,5, wenn du ein Null-Spiel gewinnst.",
        rarity: Rare,
        // SR4 (05.11.2026): 7 → 9, beim Nullspieler + 19,3 / + 20,7.
        price: 9,
        hooks: [
            OnScore(when: All([Won, NullGame]), then: [ScaleGameValue(1.5)]),
        ],
    ),
    // Wächst mit jeder gewonnenen Kneipe (auch Spelunke und Boss-Kneipe),
    // für den Rest des Runs; die Kneipe, die den Zähler hebt, hat ihn schon
    // hinter sich.
    (
        id: "tap",
        group: Factor,
        name: "Zapfhahn",
        text: "Jede gewonnene Kneipe gibt +×0,1 Faktor auf jedes gewonnene Spiel, für den Rest des Runs.",
        // Runde 3 (05.11.2026): Rare, 8 → Legendary, 10. Ohne Tresen + 12,2
        // auf „Stadtteil 2“, + 15,0 auf „Stadtteil 3“ (das 4,8-Fache des
        // Mittels seltener Relikte, mehr als der Grandseigneur): Pflicht.
        rarity: Legendary,
        price: 10,
        hooks: [
            OnSeriesWon(then: [IncrementCounter("tap")]),
            OnScore(when: Won, then: [ScaleGameValuePerCounter(counter: "tap", per: 0.1)]),
        ],
    ),
    // Das Risiko: Der Faktor zählt die gewonnenen Spiele vor diesem (der
    // Faktor-Hook steht vor dem Zähler), ein verlorenes Spiel setzt ihn
    // zurück. Einmischen bricht die Folge nicht.
    (
        id: "hot_hand",
        group: Factor,
        name: "Heiße Hand",
        text: "Jedes gewonnene Spiel in Folge gibt +×0,2 Faktor auf die nächsten gewonnenen Spiele. Ein verlorenes Spiel setzt ihn auf ×1 zurück.",
        rarity: Rare,
        // SR4 (05.11.2026): 8 → 10; ohne Tresen + 9,5 / + 6,8 auf
        // „Stadtteil 2 / 3“, das Fünffache der übrigen seltenen Relikte.
        price: 10,
        hooks: [
            OnScore(when: Won, then: [ScaleGameValuePerCounter(counter: "hot_hand", per: 0.2), IncrementCounter("hot_hand")]),
            OnScore(when: Lost, then: [ResetCounter("hot_hand")]),
        ],
    ),
    // ---------------------------------------------------------------------
    // Bau-Richtungen (Entscheidung des Nutzers, 04.11.2026, Cockpit q26):
    // Verbinder-Relikte, die andere Teile ihres Builds zählen. Seltenheit,
    // Preise und Bot-Werte VORLÄUFIG nach Augenmaß, ohne Messung (DESIGN
    // 8.11). "Zinke" heißt jede Modifikation, die kein Fluch ist (auch
    // Marken und Spezialkarten), "Deck" die Ausgabe des Spielers (ADR 0015).
    // ---------------------------------------------------------------------
    // Farbtreue. Lever Grundwert: +1 per card of the declared trump suit
    // in the player's edition that carries a Zinke (Siegel, Aufdruck,
    // Winkel …; the Unter of that suit too, like the Siegel), held or not.
    (
        id: "club_colours",
        tags: [OneSuit],
        group: Value,
        focus: Trump,
        name: "Vereinsfarben",
        // Runde 3 (05.11.2026): +1 → +2 je Karte; mit +1 ohne Tresen nur
        // + 1,9 % Punkte je Spiel (+ 1,2 auf „Stadtteil 3“).
        text: "Farbspiel: +2 Grundwert je Karte deiner Trumpffarbe mit Zinke in deinem Deck.",
        rarity: Uncommon,
        price: 6,
        hooks: [
            OnDeclare(when: SuitGame, then: [AddBaseValuePerCard(count: (trump_suit: true), per: 2)]),
        ],
    ),
    // Farbtreue. Lever Gewinnstufen: the streak of suit games in the same
    // trump suit before this one (won or lost) gives levels on a won suit
    // game, at most +3. A grand, a Null or another trump suit starts over;
    // the Ramsch neither counts nor breaks it. Like Stammfarbe across pubs.
    // The flag holds the suit, the counter the games before this one.
    (
        id: "true_soul",
        tags: [OneSuit],
        group: Multiplier,
        focus: Trump,
        name: "Treue Seele",
        text: "Gewinnst du ein Farbspiel: +1 Stufe je Spiel direkt davor in derselben Trumpffarbe, höchstens +3.",
        rarity: Common,
        price: 4,
        hooks: [
            OnDeclare(when: All([GameIs(Suit(Clubs)), Not(Flag("true_soul_clubs"))]), then: [ClearFlag("true_soul_spades"), ClearFlag("true_soul_hearts"), ClearFlag("true_soul_diamonds"), SetFlag("true_soul_clubs"), ResetCounter("true_soul")]),
            OnDeclare(when: All([GameIs(Suit(Spades)), Not(Flag("true_soul_spades"))]), then: [ClearFlag("true_soul_clubs"), ClearFlag("true_soul_hearts"), ClearFlag("true_soul_diamonds"), SetFlag("true_soul_spades"), ResetCounter("true_soul")]),
            OnDeclare(when: All([GameIs(Suit(Hearts)), Not(Flag("true_soul_hearts"))]), then: [ClearFlag("true_soul_clubs"), ClearFlag("true_soul_spades"), ClearFlag("true_soul_diamonds"), SetFlag("true_soul_hearts"), ResetCounter("true_soul")]),
            OnDeclare(when: All([GameIs(Suit(Diamonds)), Not(Flag("true_soul_diamonds"))]), then: [ClearFlag("true_soul_clubs"), ClearFlag("true_soul_spades"), ClearFlag("true_soul_hearts"), SetFlag("true_soul_diamonds"), ResetCounter("true_soul")]),
            OnDeclare(when: Any([GameIs(Grand), NullGame]), then: [ClearFlag("true_soul_clubs"), ClearFlag("true_soul_spades"), ClearFlag("true_soul_hearts"), ClearFlag("true_soul_diamonds"), ResetCounter("true_soul")]),
            OnScore(when: All([Won, SuitGame]), then: [AddLevelsPerCounter(counter: "true_soul", per: 1)]),
            OnScore(when: All([SuitGame, Not(CounterAtLeast(counter: "true_soul", value: 3))]), then: [IncrementCounter("true_soul")]),
        ],
    ),
    // Markenhändler. Lever Gewinnstufen (counter of one pub): every Marke
    // redeemed (discarded or in a hand game) gives +1 level on every won
    // game until the pub is won; the game it was redeemed in counts too.
    (
        id: "rebate_book",
        tags: [Vouchers],
        group: Multiplier,
        name: "Rabattheft",
        text: "Jede eingelöste Marke: +1 Stufe auf jedes gewonnene Spiel, bis die Kneipe vorbei ist.",
        rarity: Uncommon,
        price: 6,
        hooks: [
            OnVoucherRedeemed(then: [IncrementCounter("rebate_book")]),
            OnScore(when: All([Won, Not(RamschGame)]), then: [AddLevelsPerCounter(counter: "rebate_book", per: 1)]),
            OnSeriesWon(then: [ResetCounter("rebate_book")]),
        ],
    ),
    // Markenhändler. Lever Groschen: every redeemed Marke pays 2 more.
    (
        id: "empties",
        tags: [Vouchers],
        group: Tour,
        name: "Leergut",
        text: "Jede eingelöste Marke bringt dir 2 Groschen extra.",
        rarity: Common,
        price: 4,
        hooks: [
            OnVoucherRedeemed(then: [GainCoins(2)]),
        ],
    ),
    // Markenhändler. Lever Grundwert: +1 per Marke still on a card of the
    // edition at the declaration. Pulls against the two above: keep the
    // Marken or cash them in.
    (
        id: "stamp_album",
        tags: [Vouchers],
        group: Value,
        name: "Sammelalbum",
        text: "+1 Grundwert je Marke, die in deinem Deck noch auf einer Karte klebt.",
        rarity: Common,
        price: 6,
        hooks: [
            OnDeclare(when: Not(RamschGame), then: [AddBaseValuePerCard(count: (kind: Some(Voucher)), per: 1)]),
        ],
    ),
    // Stichjäger. Lever Augen: a trick the declarer takes with a card of
    // his edition that carries a Zinke counts 3 Augen more (winning and
    // Schneider). Not in Null (a trick loses) nor Ramsch.
    (
        id: "fingertips",
        tags: [Tricks],
        group: Value,
        focus: Trump,
        name: "Fingerspitzengefühl",
        text: "Machst du einen Stich mit einer Karte mit Zinke, zählt er 3 Augen mehr.",
        rarity: Uncommon,
        price: 6,
        hooks: [
            OnTrickEnd(when: All([TrickWonWithMarkedCard, Not(NullGame), Not(RamschGame)]), then: [AddTrickPoints(3)]),
        ],
    ),
    // Stichjäger. Lever Gewinnstufen: counts the tricks of one game the
    // declarer takes with a card with a Zinke; on a won game 3 of them give
    // +1 level, 5 give +2. The counter starts over with every declaration.
    (
        id: "tally_sheet",
        tags: [Tricks],
        group: Multiplier,
        focus: Trump,
        name: "Strichliste",
        text: "Machst du in einem gewonnenen Spiel 3 Stiche mit Karten mit Zinke: +1 Stufe, bei 5 Stichen +2.",
        rarity: Uncommon,
        price: 5,
        hooks: [
            OnDeclare(then: [ResetCounter("tally_sheet")]),
            OnTrickEnd(when: All([TrickWonWithMarkedCard, Not(NullGame), Not(RamschGame)]), then: [IncrementCounter("tally_sheet")]),
            OnScore(when: All([Won, CounterAtLeast(counter: "tally_sheet", value: 3)]), then: [AddLevels(1)]),
            OnScore(when: All([Won, CounterAtLeast(counter: "tally_sheet", value: 5)]), then: [AddLevels(1)]),
        ],
    ),
    // Stichjäger. Lever Groschen: 1 per trick the declarer takes with a
    // card with a Zinke, at most 3 per game (the counter starts over with
    // every declaration). Like a Goldkante on every card with a Zinke.
    (
        id: "tip",
        tags: [Tricks],
        group: Tour,
        focus: Trump,
        name: "Trinkgeld",
        text: "Machst du einen Stich mit einer Karte mit Zinke: 1 Groschen, höchstens 3 pro Spiel.",
        rarity: Common,
        price: 4,
        hooks: [
            OnDeclare(then: [ResetCounter("tip")]),
            OnTrickEnd(when: All([TrickWonWithMarkedCard, Not(NullGame), Not(RamschGame), Not(CounterAtLeast(counter: "tip", value: 3))]), then: [GainCoins(1), IncrementCounter("tip")]),
        ],
    ),
    // Schneider. Faktor (ADR 0018: only rare relics): ×1,5 on a game won
    // with Schneider (Schwarz included).
    (
        id: "golden_shears",
        tags: [Schneider],
        group: Factor,
        focus: Trump,
        name: "Goldene Schere",
        text: "×1,5, wenn du mit Schneider gewinnst.",
        rarity: Rare,
        price: 8,
        hooks: [
            OnScore(when: All([WonSchneider, Not(RamschGame)]), then: [ScaleGameValue(1.5)]),
        ],
    ),
    // Schneider. Lever Grundwert (run counter): every game won with
    // Schneider gives +1 for the rest of the run, from the next game on.
    (
        id: "tape_measure",
        tags: [Schneider],
        group: Value,
        focus: Trump,
        name: "Maßband",
        text: "Jedes Spiel, das du mit Schneider gewinnst, gibt +1 Grundwert für den Rest des Runs.",
        rarity: Rare,
        price: 7,
        passive: [AddBaseValueFromCounter("tape_measure")],
        hooks: [
            OnScore(when: All([WonSchneider, Not(RamschGame)]), then: [IncrementCounter("tape_measure")]),
        ],
    ),
    // Schneider. Lever Grundwert: on a game won with Schneider, +1 per card
    // of the edition with Aufdruck or Schneiderkreide (the Schneiderin
    // starts with four).
    (
        id: "sewing_pattern",
        tags: [Schneider],
        group: Value,
        focus: Trump,
        name: "Schnittmuster",
        text: "Gewinnst du mit Schneider: +1 Grundwert je Karte mit Aufdruck oder Schneiderkreide in deinem Deck.",
        rarity: Common,
        price: 6,
        hooks: [
            OnScore(when: All([WonSchneider, Not(RamschGame)]), then: [AddBaseValuePerCard(count: (mods: ["points", "tailors_chalk"]), per: 1)]),
        ],
    ),
    // Nullspieler. Lever Gewinnstufen: a won Null gives +1 level per Blei
    // card the player held after the skat (in a won Null he ducks every
    // one of them).
    (
        id: "lead_pouring",
        tags: [Null],
        group: Multiplier,
        focus: Null,
        name: "Bleigießen",
        text: "Gewinnst du ein Null: +1 Stufe je Karte mit Blei auf deiner Hand.",
        rarity: Uncommon,
        // SR4 (05.11.2026): 6 → 8, beim Nullspieler + 11,3 / + 14,0.
        price: 8,
        hooks: [
            OnScore(when: All([Won, NullGame]), then: [AddLevelsPerCard(count: (mods: ["lead"], in_hand: true), per: 1)]),
        ],
    ),
    // Nullspieler. Lever Grundwert: every Null, won or lost (like
    // Nullachtfuffzehn), +2 per Blei card of the edition.
    (
        id: "plumb_line",
        tags: [Null],
        group: Value,
        focus: Null,
        name: "Senkblei",
        // SR4 (05.11.2026): +2 → +1 je Karte, beim Nullspieler ohne Tresen
        // + 10,7 / + 15,3 auf „Stadtteil 2 / 3“ (gewöhnlich!).
        text: "Null: +1 Grundwert je Karte mit Blei in deinem Deck, gewonnen wie verloren.",
        rarity: Common,
        price: 5,
        hooks: [
            OnDeclare(when: NullGame, then: [AddBaseValuePerCard(count: (mods: ["lead"]), per: 1)]),
        ],
    ),
    // Grand (Cockpit q27, 04.11.2026: the Grand counts 18 in the run).
    // Lever Grundwert: +6 on every Grand, won or lost, so it counts 24 as
    // in the Skatordnung again.
    (
        id: "grandfathers_grand",
        group: Value,
        focus: Trump,
        name: "Großvaters Grand",
        text: "Der Grand zählt wieder 24 wie zu Großvaters Zeiten: Grundwert +6.",
        rarity: Uncommon,
        price: 7,
        hooks: [
            OnDeclare(when: GameIs(Grand), then: [AddBaseValue(6)]),
        ],
    ),
]
