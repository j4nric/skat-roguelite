// Hausregeln und Stammtisch-Figuren (passive Relikte). Effekte über die
// Hook-API, siehe core/src/content/effects.rs. Preise 4 bis 9 nach der
// M5-Messung (docs/balance/2026-11-01-m5-v1.md, PIMC-Spieler, Relikt ab
// Spielbeginn ohne Tresen): Wirkung auf „Abschnitt 3 erreicht“ ab +6,5
// Prozentpunkten 9, ab +4,5 8, ab +3 7, ab +1,5 6, darunter 5; Relikte,
// die vor allem Menschen nutzen (Hand, Ouvert, Information) oder nur gegen
// einzelne Bosse wirken, 4 bis 6. Hausregeln und Figuren folgen derselben
// Staffel.
//
// Seltenheit folgt der Stärke (M5): Die drei stärksten Relikte des
// Alleinspielers (Bockrunde, Alte Dame, Kleinvieh) und das stärkste des
// Nullspielers (Siebenschläfer) sind Uncommon, die schwächsten bisherigen
// Uncommon (Spitze, Mit Vieren, Schiedsrichter, Saubere Weste) dafür
// Common. Vorher lagen die stärksten Relikte alle in der häufigsten Stufe.
//
// focus: für welche Spielart das Relikt gemacht ist (All, Trump für
// Farbspiel und Grand, Null). Seit ADR 0012 liegt jedes Relikt bei jedem
// Charakter am Tresen; wie oft, sagen die focus_weights in characters.ron.
// Was ein Relikt tut, steht in seinen Effekten und Bedingungen; Relikte für
// Farbspiel und Grand, die im Null etwas Unsinniges täten, schließen Null
// aus (Not(NullGame)).
// characters: für welche Charaktere das Relikt am Tresen liegt (leer: alle).
// Gesperrte Relikte stehen als Belohnung in unlocks.ron.
[
    (
        id: "bock_round",
        name: "Bockrunde",
        text: "Nach jedem verlorenen Spiel zählt das nächste doppelt.",
        rarity: Uncommon,
        price: 9,
        hooks: [
            OnScore(when: Lost, then: [SetFlag("bock")]),
            // Erst beim Ansagen verbraucht, damit Einmischen den Bock nicht verschenkt.
            OnDeclare(when: Flag("bock"), then: [MultiplyBaseValue(2), ClearFlag("bock")]),
        ],
    ),
    (
        id: "kontra",
        name: "Kontra",
        text: "Die Gegner dürfen Kontra sagen (Spielwert ×2). Du darfst Re sagen (×4).",
        rarity: Common,
        price: 5,
        passive: [EnableKontra],
    ),
    (
        id: "last_trick_seven",
        focus: Trump,
        name: "Spitze",
        text: "Machst du den letzten Stich mit einer Sieben, gibt es eine Gewinnstufe mehr.",
        rarity: Common,
        price: 4,
        hooks: [
            // Im Null wäre der Stich des Alleinspielers schon verloren.
            OnScore(when: All([LastTrickWinnerMatches(filter: (rank: Some(Seven)), by_declarer: true), Not(NullGame)]), then: [AddLevels(1)]),
        ],
    ),
    (
        id: "concede",
        focus: Trump,
        name: "Schenken",
        text: "Haben die Gegner nach fünf Stichen unter 15 Augen, geben sie auf. Der Rest gehört dir, das Spiel ist mindestens Schneider. Nicht beim Null.",
        rarity: Uncommon,
        price: 8,
        hooks: [
            // Im Null hieße Aufgeben, dass der Alleinspieler die übrigen
            // Stiche bekommt und verliert.
            OnTrickEnd(when: All([TricksPlayed(5), DefenderPointsBelow(15), Not(NullGame)]), then: [Concede]),
        ],
    ),
    (
        id: "ouvert_bonus",
        name: "Ouvert-Bonus",
        text: "Ouvert zählt zwei Gewinnstufen statt einer. Auch Null Ouvert.",
        rarity: Uncommon,
        price: 4,
        hooks: [
            OnScore(when: Any([RiskAtLeast(Ouvert), NullRiskAtLeast(Ouvert)]), then: [AddLevels(1)]),
        ],
    ),
    (
        id: "skat_redraw",
        name: "Schieben",
        text: "In jedem Spiel darfst du einmal mehr einmischen.",
        rarity: Common,
        price: 8,
        // DESIGN 8.1: neu geben statt Skat neu ziehen, Begründung dort.
        // Seit dem Einmischen (01.11.2026) ein Einmischen mehr pro Spiel.
        passive: [ExtraRedeal],
    ),
    (
        id: "virgin",
        focus: Trump,
        name: "Jungfrau",
        text: "Gewinnst du mit 61 bis 70 Augen, zählt das Spiel trotzdem als Schneider.",
        rarity: Uncommon,
        price: 7,
        passive: [SchneiderFromDeclarerPoints(min: 61, max: 70)],
    ),
    (
        id: "old_lady",
        focus: Trump,
        name: "Alte Dame",
        text: "Jede Dame zählt 5 Augen. Auch bei den Gegnern.",
        rarity: Uncommon,
        price: 9,
        passive: [SetCardPoints(filter: (rank: Some(Queen)), points: 5)],
    ),
    (
        id: "tour",
        name: "Tournee",
        text: "Jede Serie, die du mit Spielen übrig gewinnst, gibt +1 Grundwert für den Rest des Runs.",
        rarity: Rare,
        price: 7,
        passive: [AddBaseValueFromCounter("tour")],
        hooks: [
            OnSeriesWon(when: GamesLeftAtLeast(1), then: [IncrementCounter("tour")]),
        ],
    ),
    (
        id: "march_through",
        focus: Trump,
        name: "Durchmarsch",
        text: "Gewinnst du Schneider, zählt der Spielwert doppelt.",
        rarity: Rare,
        price: 7,
        hooks: [
            OnScore(when: WonSchneider, then: [MultiplyGameValue(2)]),
        ],
    ),
    (
        id: "blind_flight",
        focus: Null,
        name: "Blindflug",
        text: "Gewinnst du ein Null aus der Hand, gibt es eine Gewinnstufe mehr.",
        rarity: Common,
        price: 5,
        hooks: [
            OnScore(when: All([NullGame, HandGame, Won]), then: [AddLevels(1)]),
        ],
    ),
    // Stammtisch-Figuren (DESIGN 8.2).
    (
        id: "kibitzer",
        kind: Regular,
        name: "Der Kiebitz",
        text: "Schaut den Gegnern über die Schulter: Vor der Ansage zeigt er dir eine zufällige Karte eines Gegners und wer sie hält.",
        rarity: Uncommon,
        price: 5,
        passive: [PeekDefenderCards(1)],
    ),
    (
        id: "landlord",
        kind: Regular,
        name: "Der Wirt",
        text: "Alles am Tresen ist 20 % billiger, auch die Neuauslage.",
        rarity: Uncommon,
        price: 7,
        passive: [ShopDiscount(20)],
    ),
    (
        id: "granny",
        focus: Trump,
        kind: Regular,
        name: "Die Oma",
        text: "Einmal pro Serie darfst du in einem Handspiel vor dem ersten Stich einen Unter aus dem Skat nehmen und dafür eine Karte drücken. Ob einer drin liegt, verrät sie dir.",
        rarity: Rare,
        price: 6,
        passive: [SeriesSkatSwap((rank: Some(Jack)))],
    ),
    // Lever Spitzen and Hand, like "Die Oma" but for the Daus. Both figures
    // together give two swaps per series, one per figure.
    (
        id: "grandpa",
        focus: Trump,
        kind: Regular,
        name: "Der Opa",
        text: "Einmal pro Serie darfst du in einem Handspiel vor dem ersten Stich ein Daus aus dem Skat nehmen und dafür eine Karte drücken. Ob eines drin liegt, verrät er dir.",
        rarity: Rare,
        price: 6,
        passive: [SeriesSkatSwap((rank: Some(Ace)))],
    ),
    (
        id: "referee",
        kind: Regular,
        name: "Der Schiedsrichter",
        text: "Am Tisch wird nicht geschummelt: Die Zwillinge sehen sich nicht in die Karten, der Revolutionär darf nicht tauschen.",
        rarity: Common,
        price: 4,
        passive: [NoCheating],
    ),
    (
        id: "show_off",
        focus: Null,
        kind: Regular,
        name: "Der Angeber",
        text: "Du musst immer offen spielen: Farbe und Grand nur Ouvert, sonst Null Ouvert. Dafür zählt Null Ouvert eine Gewinnstufe mehr.",
        rarity: Rare,
        price: 6,
        passive: [RequireOuvert],
        hooks: [
            OnScore(when: NullRiskAtLeast(Ouvert), then: [AddLevels(1)]),
        ],
    ),
    (
        id: "card_counter",
        kind: Regular,
        name: "Der Zähler",
        text: "Zählt mit: Er zeigt dir laufend die Augen beider Seiten und wie viele Augen du noch nicht gesehen hast.",
        rarity: Common,
        price: 4,
        passive: [ShowCount],
    ),
    // ---------------------------------------------------------------------
    // M4: 14 more house rules and figures. Each turns one lever of the
    // formula (Designsäule 1), named in the comment. Prices are placeholders
    // for `balance`. Texts speak of the German deck (Unter, Oberin, Daus).
    // ---------------------------------------------------------------------
    // Lever Augen: every seven and eight counts 1 Auge, +8 Augen in the
    // deck (as much as the Alte Dame; with the nines too, +12 Augen, it
    // measured twice as strong). Like the Alte Dame it helps the declarer
    // net, because the win threshold stays at 61. For the Nullspieler the
    // Augen of his ducked sevens go to the defenders and make a Kurzschluss
    // likelier.
    (
        id: "every_bit_counts",
        name: "Kleinvieh",
        text: "Kleinvieh macht auch Mist: Jede Sieben und jede Acht zählt 1 Auge. Auch bei den Gegnern.",
        rarity: Uncommon,
        price: 9,
        passive: [
            SetCardPoints(filter: (rank: Some(Seven)), points: 1),
            SetCardPoints(filter: (rank: Some(Eight)), points: 1),
        ],
    ),
    // Lever Gewinnschwelle: 58 instead of 61.
    (
        id: "blind_eye",
        focus: Trump,
        name: "Ein Auge zudrücken",
        text: "Der Wirt drückt ein Auge zu: Du gewinnst schon mit 3 Augen weniger (58 statt 61).",
        rarity: Common,
        price: 8,
        passive: [WinThreshold(58)],
    ),
    // Lever Grundwert (counter, grows over the run): +2 per lost game.
    (
        id: "tuition",
        name: "Lehrgeld",
        text: "Jedes verlorene Spiel ist Lehrgeld: +2 Grundwert für den Rest des Runs.",
        rarity: Common,
        price: 7,
        passive: [AddBaseValueFromCounter("tuition")],
        hooks: [
            OnScore(when: Lost, then: [IncrementCounter("tuition"), IncrementCounter("tuition")]),
        ],
    ),
    // Lever Grundwert (counter, grows over the run): +1 per won hand game.
    (
        id: "beer_mat",
        name: "Bierdeckel",
        text: "Jedes gewonnene Handspiel gibt einen Strich auf den Bierdeckel: +1 Grundwert für den Rest des Runs.",
        rarity: Uncommon,
        price: 5,
        passive: [AddBaseValueFromCounter("beer_mat")],
        hooks: [
            OnScore(when: All([Won, HandGame, Not(RamschGame)]), then: [IncrementCounter("beer_mat")]),
        ],
    ),
    // Lever Gewinnstufen: +1 when the defenders have no Auge after three
    // tricks. Fires during play, so it counts won or lost (a loss from
    // there is rare).
    (
        id: "high_and_dry",
        focus: Trump,
        name: "Auf dem Trockenen",
        text: "Haben die Gegner nach drei Stichen noch kein einziges Auge, gibt es eine Gewinnstufe mehr. Nicht beim Null.",
        rarity: Uncommon,
        price: 5,
        hooks: [
            OnTrickEnd(when: All([TricksPlayed(3), DefenderPointsBelow(1), Not(RamschGame), Not(NullGame)]), then: [AddLevels(1)]),
        ],
    ),
    // Lever Grundwert ×2 (multiplicative): a Bock after every won Schneider.
    // Like the Bockrunde it is used up at the declaration.
    (
        id: "schneider_bock",
        focus: Trump,
        name: "Schneiderbock",
        text: "Nach jedem gewonnenen Schneider zählt das nächste Spiel doppelt.",
        rarity: Uncommon,
        price: 5,
        hooks: [
            OnScore(when: WonSchneider, then: [SetFlag("schneider_bock")]),
            OnDeclare(when: Flag("schneider_bock"), then: [MultiplyBaseValue(2), ClearFlag("schneider_bock")]),
        ],
    ),
    // Lever Spielwert ×2 (multiplicative): from the third won game in a
    // row, every won game counts double until a game is lost. Einmischen
    // does not break the streak. Hook order matters: the doubling looks at the
    // flags of the games before.
    (
        id: "lucky_streak",
        name: "Glückssträhne",
        text: "Ab dem dritten gewonnenen Spiel in Folge zählt jedes gewonnene Spiel doppelt. Ein verlorenes beendet die Strähne.",
        rarity: Rare,
        price: 7,
        hooks: [
            OnScore(when: All([Won, Flag("streak")]), then: [MultiplyGameValue(2)]),
            OnScore(when: All([Won, Flag("streak_start")]), then: [SetFlag("streak")]),
            OnScore(when: Won, then: [SetFlag("streak_start")]),
            OnScore(when: Lost, then: [ClearFlag("streak_start"), ClearFlag("streak")]),
        ],
    ),
    // Figure. Lever Schneider: a won game with 80 to 89 Augen is Schneider.
    (
        id: "tailor",
        focus: Trump,
        kind: Regular,
        name: "Der Schneider",
        text: "Der Schneider vom Nebentisch nimmt großzügig Maß: Gewinnst du mit 80 bis 89 Augen, sind die Gegner trotzdem Schneider.",
        rarity: Uncommon,
        price: 7,
        passive: [SchneiderFromDeclarerPoints(min: 80, max: 89)],
    ),
    // Figure. Lever Spielwert ×2 (multiplicative, late game): counts the
    // series won with him; from the fourth on, every won game counts double.
    (
        id: "regular_guest",
        kind: Regular,
        name: "Der Stammgast",
        text: "Er zählt jede Serie, die du mit ihm gewinnst. Ab der vierten bist du Stammgast: Jedes gewonnene Spiel zählt doppelt.",
        rarity: Rare,
        price: 9,
        hooks: [
            OnSeriesWon(then: [IncrementCounter("regular")]),
            OnScore(when: All([Won, CounterAtLeast(counter: "regular", value: 4)]), then: [MultiplyGameValue(2)]),
        ],
    ),
    // Made for Null from here (before ADR 0012 only for the Nullspieler).
    // Lever Grundwert: +8 on every Null, won or lost.
    (
        id: "null_eight_fifteen",
        focus: Null,
        name: "Nullachtfuffzehn",
        text: "Ein ganz gewöhnliches Null: Grundwert +8, gewonnen wie verloren.",
        rarity: Common,
        price: 6,
        hooks: [
            OnDeclare(when: NullGame, then: [AddBaseValue(8)]),
        ],
    ),
    // Lever Gewinnstufen: +1 for a won Null with the skat (the counterpart
    // of Blindflug).
    (
        id: "safety_net",
        focus: Null,
        name: "Doppelter Boden",
        text: "Gewinnst du ein Null mit Skat, gibt es eine Gewinnstufe mehr.",
        rarity: Common,
        price: 7,
        hooks: [
            OnScore(when: All([NullGame, Won, Not(HandGame)]), then: [AddLevels(1)]),
        ],
    ),
    // Lever Augen (for the Null formula: Kurzschluss, defenders with 61
    // Augen after five tricks): every Daus counts 16.
    (
        id: "fat_sow",
        focus: Null,
        name: "Dicke Sau",
        text: "Jedes Daus zählt 16 Augen, in jedem Spiel und bei allen. Beim Null kommen die Gegner so schneller in den Kurzschluss.",
        rarity: Common,
        price: 6,
        passive: [SetCardPoints(filter: (rank: Some(Ace)), points: 16)],
    ),
    // Lever Spielwert ×2 (multiplicative): a won Null Ouvert counts double.
    (
        id: "glass_house",
        focus: Null,
        name: "Glashaus",
        text: "Wer im Glashaus sitzt, spielt offen: Ein gewonnener Null Ouvert zählt doppelt.",
        rarity: Uncommon,
        price: 5,
        hooks: [
            OnScore(when: All([Won, NullRiskAtLeast(Ouvert)]), then: [MultiplyGameValue(2)]),
        ],
    ),
    // Lever Grundwert (counter, grows over the run): +2 per won Null.
    (
        id: "tally_stick",
        focus: Null,
        name: "Kerbholz",
        text: "Jedes gewonnene Null ist eine Kerbe: +2 Grundwert für den Rest des Runs.",
        rarity: Rare,
        price: 6,
        passive: [AddBaseValueFromCounter("tally")],
        hooks: [
            OnScore(when: All([NullGame, Won]), then: [IncrementCounter("tally"), IncrementCounter("tally")]),
        ],
    ),
    // Lever Gewinnstufen (Spitzen): mit or ohne 4 and more, one level more.
    (
        id: "with_four",
        focus: Trump,
        name: "Mit Vieren",
        text: "Spielst du mit oder ohne 4 Spitzen oder mehr, gibt es eine Gewinnstufe mehr.",
        rarity: Common,
        price: 4,
        hooks: [
            OnScore(
                when: Any([
                    MatadorsAtLeast(with: true, count: 4),
                    MatadorsAtLeast(with: false, count: 4),
                ]),
                then: [AddLevels(1)],
            ),
        ],
    ),
    // Null style, lever Grundwert: a won Null with a seven ducked.
    (
        id: "seven_sleeper",
        focus: Null,
        name: "Siebenschläfer",
        text: "Gewinnst du ein Null, in dem du mit einer Sieben unterlaufen bist: Grundwert +5.",
        rarity: Uncommon,
        price: 8,
        hooks: [
            OnScore(when: All([NullGame, Won, SevenDucked]), then: [AddBaseValue(5)]),
        ],
    ),
    // Null style, lever Gewinnstufen: a won Null without ever following
    // suit.
    (
        id: "clean_slate",
        focus: Null,
        name: "Saubere Weste",
        text: "Gewinnst du ein Null, in dem du nie bedienen musstest, gibt es zwei Gewinnstufen mehr.",
        rarity: Common,
        price: 5,
        hooks: [
            OnScore(when: All([NullGame, Won, NeverFollowedSuit]), then: [AddLevels(2)]),
        ],
    ),
    // ---------------------------------------------------------------------
    // M8 Welle 2a, abgestimmt im Cockpit (02.11.2026): Skat-Hebel,
    // Bau-Richtungen, Spiel-Relikte. Texte wie abgestimmt. Seltenheit und
    // Preise nach der Einzelmessung (docs/balance/2026-11-02-relikte-
    // welle2.md), Platzhalter für `balance`. "Spielart" heißt hier wie in
    // der Skatordnung Farbspiel, Grand oder Null; der Ramsch des Ramschers
    // zählt nie mit und unterbricht nichts. "Das Spiel davor" und "drei-
    // mal hintereinander" gehen über Seriengrenzen (DESIGN 8.1).
    // ---------------------------------------------------------------------
    // Lever Augen: after the discard the two skat cards count twice for
    // the declarer, for winning and Schneider (one Augen line). A hand
    // game discards nothing.
    (
        id: "skat_keeper",
        name: "Skatpfleger",
        text: "Die Augen der gedrückten Karten zählen doppelt.",
        rarity: Uncommon,
        price: 7,
        hooks: [
            OnDeclare(when: Not(HandGame), then: [MultiplySkatPoints(2)]),
        ],
    ),
    // Lever Grundwert (counter of one series): every discarded card gives
    // +1 from this game to the end of the series, so with the skat in
    // every game +2, +4, +6. Back to zero after the won series (a lost
    // series ends the run).
    (
        id: "old_deck",
        name: "Altes Blatt",
        text: "Jede gedrückte Karte gibt bis zum Ende der Serie +1 Grundwert.",
        rarity: Uncommon,
        price: 7,
        hooks: [
            OnDeclare(when: Not(HandGame), then: [IncrementCounter("old_deck"), IncrementCounter("old_deck")]),
            OnDeclare(when: Not(RamschGame), then: [AddBaseValueFromCounter("old_deck")]),
            OnSeriesWon(then: [ResetCounter("old_deck")]),
        ],
    ),
    // Lever Grundwert (counter of one series): +3 per Spielart (Farbspiel,
    // Grand, Null) declared in the series so far, this game included:
    // +3 for the first game, up to +9 for the third.
    (
        id: "all_rounder",
        name: "Allrounder",
        text: "Je verschiedener Spielart in einer Serie +3 Grundwert.",
        rarity: Uncommon,
        price: 8,
        hooks: [
            OnDeclare(when: All([SuitGame, Not(Flag("all_rounder_suit"))]), then: [SetFlag("all_rounder_suit"), IncrementCounter("all_rounder")]),
            OnDeclare(when: All([GameIs(Grand), Not(Flag("all_rounder_grand"))]), then: [SetFlag("all_rounder_grand"), IncrementCounter("all_rounder")]),
            OnDeclare(when: All([NullGame, Not(Flag("all_rounder_null"))]), then: [SetFlag("all_rounder_null"), IncrementCounter("all_rounder")]),
            OnDeclare(when: Not(RamschGame), then: [AddBaseValuePerCounter(counter: "all_rounder", per: 3)]),
            OnSeriesWon(then: [ClearFlag("all_rounder_suit"), ClearFlag("all_rounder_grand"), ClearFlag("all_rounder_null"), ResetCounter("all_rounder")]),
        ],
    ),
    // Lever Spielwert ×1,5 (multiplicative): from the third suit game in a
    // row with the same trump suit, each further one too, won or lost. The
    // streak goes over series boundaries; a grand, a Null or another trump
    // suit starts over. The flag holds the suit, the counter the streak.
    (
        id: "home_suit",
        focus: Trump,
        name: "Stammfarbe",
        text: "Dreimal hintereinander dieselbe Trumpffarbe: ×1,5.",
        rarity: Rare,
        price: 6,
        hooks: [
            OnDeclare(when: All([GameIs(Suit(Clubs)), Not(Flag("home_suit_clubs"))]), then: [ClearFlag("home_suit_spades"), ClearFlag("home_suit_hearts"), ClearFlag("home_suit_diamonds"), SetFlag("home_suit_clubs"), ResetCounter("home_suit")]),
            OnDeclare(when: All([GameIs(Suit(Spades)), Not(Flag("home_suit_spades"))]), then: [ClearFlag("home_suit_clubs"), ClearFlag("home_suit_hearts"), ClearFlag("home_suit_diamonds"), SetFlag("home_suit_spades"), ResetCounter("home_suit")]),
            OnDeclare(when: All([GameIs(Suit(Hearts)), Not(Flag("home_suit_hearts"))]), then: [ClearFlag("home_suit_clubs"), ClearFlag("home_suit_spades"), ClearFlag("home_suit_diamonds"), SetFlag("home_suit_hearts"), ResetCounter("home_suit")]),
            OnDeclare(when: All([GameIs(Suit(Diamonds)), Not(Flag("home_suit_diamonds"))]), then: [ClearFlag("home_suit_clubs"), ClearFlag("home_suit_spades"), ClearFlag("home_suit_hearts"), SetFlag("home_suit_diamonds"), ResetCounter("home_suit")]),
            OnDeclare(when: SuitGame, then: [IncrementCounter("home_suit")]),
            OnDeclare(when: Any([GameIs(Grand), NullGame]), then: [ClearFlag("home_suit_clubs"), ClearFlag("home_suit_spades"), ClearFlag("home_suit_hearts"), ClearFlag("home_suit_diamonds"), ResetCounter("home_suit")]),
            OnDeclare(when: All([SuitGame, CounterAtLeast(counter: "home_suit", value: 3)]), then: [ScaleGameValue(1.5)]),
        ],
    ),
    // Lever Gewinnstufen: +1 when the Spielart differs from the game
    // before (Farbspiel, Grand, Null; a change of trump suit is none),
    // won or lost. The first game with it has no game before. The flags
    // hold the Spielart of the last game.
    (
        id: "changeling",
        name: "Wechselbalg",
        text: "+1 Stufe, wenn du eine andere Spielart ansagst als im Spiel davor.",
        rarity: Common,
        price: 5,
        hooks: [
            OnDeclare(
                when: Any([
                    All([SuitGame, Any([Flag("changeling_grand"), Flag("changeling_null")])]),
                    All([GameIs(Grand), Any([Flag("changeling_suit"), Flag("changeling_null")])]),
                    All([NullGame, Any([Flag("changeling_suit"), Flag("changeling_grand")])]),
                ]),
                then: [AddLevels(1)],
            ),
            OnDeclare(when: Not(RamschGame), then: [ClearFlag("changeling_suit"), ClearFlag("changeling_grand"), ClearFlag("changeling_null")]),
            OnDeclare(when: SuitGame, then: [SetFlag("changeling_suit")]),
            OnDeclare(when: GameIs(Grand), then: [SetFlag("changeling_grand")]),
            OnDeclare(when: NullGame, then: [SetFlag("changeling_null")]),
        ],
    ),
    // Lever Grundwert: +1 for every Unter the declarer plays in the game
    // ("ausspielen" in the everyday sense: put on the table, not only
    // lead), won or lost. Cards conceded by "Schenken" are not played.
    (
        id: "jack_parade",
        focus: Trump,
        name: "Bubenparade",
        text: "Jeder Unter, den du ausspielst: +1 Grundwert.",
        rarity: Common,
        price: 6,
        hooks: [
            OnCardPlayed(when: All([PlayedByDeclarer, PlayedCardMatches((rank: Some(Jack))), Not(RamschGame)]), then: [AddBaseValue(1)]),
        ],
    ),
    // Lever Gewinnstufen: +1 for every trick a seven of the declarer takes
    // (by the rules: a trump seven, or a seven nobody could beat). Not in
    // Null, where a trick of the declarer loses.
    (
        id: "blank_king",
        focus: Trump,
        name: "Luschenkönig",
        text: "Gewinnt eine Sieben einen Stich: +1 Stufe.",
        rarity: Common,
        price: 5,
        hooks: [
            OnTrickEnd(when: All([TrickWinnerMatches(filter: (rank: Some(Seven)), by_declarer: true), Not(NullGame), Not(RamschGame)]), then: [AddLevels(1)]),
        ],
    ),
    // Lever Schneider: the Augen of the declarer's first trick count once
    // more for the Schneider line (defenders at most 30 plus them), never
    // for winning.
    (
        id: "watertight",
        focus: Trump,
        name: "Stichfest",
        text: "Dein erster Stich zählt für die Schneider-Grenze doppelt.",
        rarity: Uncommon,
        price: 7,
        hooks: [
            OnTrickEnd(when: All([FirstTrickOfDeclarer, Not(NullGame), Not(RamschGame)]), then: [SchneiderBonusFromTrick]),
        ],
    ),
]
