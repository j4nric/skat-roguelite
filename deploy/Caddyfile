# Internal static file server. HTTPS is handled by the household app's Caddy
# in front of this container, so this one only speaks plain HTTP on :80.

{
	servers {
		# The household app's Caddy in front of us sits in a private Docker
		# network. Trusting it lets {client_ip} be the player's address from
		# its X-Forwarded-For instead of the front Caddy's.
		trusted_proxies static private_ranges
	}
}

:80 {
	# Account server (ADR 0021), only reachable through this container. If
	# it is down, /api answers 502 and the game is served as before.
	handle /api/* {
		reverse_proxy stammtisch-api:8080 {
			header_up X-Client-IP {client_ip}
		}
	}

	root * /srv
	encode zstd gzip
	file_server

	# The web app is built by Vite (web/dist): index.html plus hashed files
	# under /assets/, including the WebAssembly core. Hashed build assets can
	# be cached for a long time; index.html never.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# Caddy maps .wasm to application/wasm already; set it explicitly so
	# WebAssembly.instantiateStreaming never depends on the MIME table.
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Web app manifest (PWA). Go's MIME table has no .webmanifest, so set the
	# type explicitly. Not hashed, so revalidate like index.html; the icons
	# it lists keep Caddy's default ETag revalidation.
	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json
	header @manifest Cache-Control "no-cache"
}
