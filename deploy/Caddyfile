# Internal static file server. HTTPS is handled by the household app's Caddy
# in front of this container, so this one only speaks plain HTTP on :80.

{
	servers {
		# The household app's Caddy in front of us sits in a private Docker
		# network. Trusting it lets {client_ip} be the player's address from
		# its X-Forwarded-For instead of the front Caddy's.
		trusted_proxies static private_ranges
		# Read X-Forwarded-For from the right, so a client cannot spoof its
		# address (it only feeds the rate limit) with its own header.
		trusted_proxies_strict
	}
}

:80 {
	# Security headers for everything, the API included. The CSP was
	# checked in Chromium against a full game (deploy/README.md): the
	# WebAssembly core needs 'wasm-unsafe-eval', the UI sets inline style
	# attributes, portraits and cards are data: and blob: images.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Account server (ADR 0021), only reachable through this container. If
	# it is down, /api answers 502 and the game is served as before.
	handle /api/* {
		reverse_proxy stammtisch-api:8080 {
			header_up X-Client-IP {client_ip}
		}
	}

	root * /srv
	encode zstd gzip
	file_server

	# The web app is built by Vite (web/dist): index.html plus hashed files
	# under /assets/, including the WebAssembly core. Hashed build assets can
	# be cached for a long time; index.html never.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html *.html
	header @html Cache-Control "no-cache"

	# The site's addresses (DESIGN 16.9; the same table is in
	# web/site/routes.ts for vite dev/preview and the service worker):
	# - / is the landing page for first-time visitors (start.html, English
	#   under /en). Its script /landing.js sends a browser that played before
	#   on to the game, so returning players never see it.
	# - /spielen is the game. The file stays index.html, so the iOS app,
	#   which opens index.html from its bundle, is unchanged; the game's
	#   assets are absolute (/assets/...), so they load from /spielen/ too.
	# Rewrites only, never redirects: the address bar keeps the clean
	# address. Several rewrite directives form one group, the first match
	# wins. Like index.html these pages name hashed assets, so they are
	# revalidated on every visit (/ and *.html are covered by @html above).
	@landing_en path /en /en/
	header @landing_en Cache-Control "no-cache"
	rewrite @landing_en /en/start.html
	@game path /spielen /spielen/
	header @game Cache-Control "no-cache"
	rewrite @game /index.html
	rewrite / /start.html

	# The static pages beside the game (web/impressum.html and the like:
	# imprint, privacy policy, help, press kit, the landing page under its
	# own name; English under /en/). Clean addresses without .html, only for
	# exactly these paths, so nothing else changes (no SPA fallback here: an
	# unknown path stays a 404). Revalidated on every visit like the pages
	# above. /start and /en/start always show the landing page, also to
	# returning players.
	@legal path /impressum /datenschutz /support /presse /start /en/imprint /en/privacy /en/support /en/press /en/start
	header @legal Cache-Control "no-cache"
	rewrite @legal {path}.html

	# The landing page's script is not hashed (it must load synchronously in
	# <head>, public/landing.js): revalidate it like the pages.
	@landing_js path /landing.js
	header @landing_js Cache-Control "no-cache"

	# Service worker (offline play, DESIGN 14.5). Browsers look for a new one
	# on every visit; never let a cache hold the old one back. It lives at
	# the root, so its scope is the whole site without Service-Worker-Allowed.
	@sw path /sw.js
	header @sw Cache-Control "no-cache"
	header @sw Content-Type "text/javascript; charset=utf-8"

	# Caddy maps .wasm to application/wasm already; set it explicitly so
	# WebAssembly.instantiateStreaming never depends on the MIME table.
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Apple app site association (ADR 0025): the iOS app's passkeys on
	# one-more-skat.de. deploy/aasa.sh writes the file into the site when the
	# team id is known; without it file_server answers 404. iOS wants JSON
	# and no redirect. Its fetches go through Apple's CDN, which caches the
	# file for itself.
	@aasa path /.well-known/apple-app-site-association
	header @aasa Content-Type application/json
	header @aasa Cache-Control "public, max-age=3600"

	# Web app manifest (PWA). Go's MIME table has no .webmanifest, so set the
	# type explicitly. Not hashed, so revalidate like index.html; the icons
	# it lists keep Caddy's default ETag revalidation.
	@manifest path *.webmanifest
	header @manifest Content-Type application/manifest+json
	header @manifest Cache-Control "no-cache"
}
