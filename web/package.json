{
  "name": "stammtisch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stammtisch: Skat als Roguelike. Web-App über dem Rust-Kern (WebAssembly).",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "typecheck": "tsc --noEmit && node scripts/check-actions.mjs && node scripts/check-i18n.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && npm run typecheck && vite build",
    "build:web": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "smoke": "node e2e/smoke.mjs",
    "ios:sync": "cap sync ios",
    "ios:assets": "python3 scripts/make-ios-assets.py"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/status-bar": "8.0.4"
  }
}
